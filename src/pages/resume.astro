---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection } from 'astro:content';
import { abilities, siteConfig } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order.general - b.data.order.general)
  .slice(0, 4);
const resumeFiles = siteConfig.resumes.map((item) => ({
  ...item,
  exists: existsSync(join(process.cwd(), 'public', item.path.replace(/^\//, ''))),
}));
const hasEmail = Boolean(siteConfig.email);
---

<BaseLayout
  title="在线简历｜赵天琦 AI 产品经理"
  description="赵天琦的在线简历：AI 产品、Agent、游戏 AI、Prompt、RAG 与产品评测实践。"
>
  <div class="resume-page container">
    <header class="resume-actions reveal" data-no-print>
      <div>
        <span class="eyebrow">在线简历 · 2027 届</span>
        <p>可打印为黑白 A4；PDF 文件存在时自动显示下载按钮。</p>
      </div>
      <div>
        {
          resumeFiles.map((file) =>
            file.exists ? (
              <a class="button" href={file.path} download>
                {file.label}
              </a>
            ) : (
              <span class="button resume-actions__missing" aria-disabled="true">
                {file.label} · 待补充
              </span>
            ),
          )
        }
        <button class="button button--primary" type="button" onclick="window.print()"
          >打印 / 导出 PDF</button
        >
      </div>
    </header>

    <article class="resume-sheet reveal">
      <header class="resume-sheet__hero">
        <div>
          <p class="resume-sheet__english-name">Tianqi Zhao</p>
          <h1>{siteConfig.name}</h1>
          <p class="resume-sheet__role">AI 产品经理 / 游戏 AI / AI Agent</p>
        </div>
        <address>
          {
            hasEmail ? (
              <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
            ) : (
              <span>邮箱待补充</span>
            )
          }
          <a href={siteConfig.github} target="_blank" rel="noreferrer">github.com/cccc-clt ↗</a>
          <span>{siteConfig.location}</span>
        </address>
      </header>

      <section class="resume-section resume-profile">
        <h2>个人简介</h2>
        <p>
          交通工程背景的 AI 产品实践者，聚焦大模型应用、Agent、Prompt 实验、RAG
          与产品评测。习惯从用户任务和系统约束出发，把需求推进为可运行、可评测、可迭代的产品方案。
        </p>
      </section>

      <section class="resume-section">
        <h2>核心能力</h2>
        <div class="resume-capabilities">
          {
            abilities.map((ability) => (
              <div>
                <>
                  <strong>{ability.title}</strong>
                  <span>{ability.description}</span>
                </>
              </div>
            ))
          }
        </div>
      </section>

      <section class="resume-section">
        <div class="resume-section__heading">
          <h2>代表项目</h2><a href="/projects">全部项目 ↗</a>
        </div>
        <div class="resume-projects">
          {
            projects.map((project) => {
              const slug = project.id.replace(/\.mdx?$/, '');
              return (
                <article class="resume-item">
                  <div class="resume-item__title">
                    <div>
                      <h3>{project.data.title}</h3>
                    </div>
                    <span>{project.data.period}</span>
                  </div>
                  <p>
                    <strong>{project.data.role}</strong> · {project.data.description}
                  </p>
                  <ul>
                    {project.data.responsibilities.slice(0, 2).map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                  <a href={`/projects/${slug}`}>查看案例 ↗</a>
                </article>
              );
            })
          }
        </div>
      </section>

      <section class="resume-section resume-two-columns">
        <div>
          <h2>方法与工具</h2>
          <p>
            Product Discovery · Agent Workflow · Prompt Engineering · RAG · LLM Evaluation ·
            Experiment Design · Python · Streamlit · Dify · Astro · TypeScript
          </p>
        </div>
        <div>
          <h2>教育与背景</h2>
          <p>
            河南城建学院 · 交通工程专业本科生。具体时间与课程信息请以用户后续补充的正式 PDF
            简历为准。
          </p>
        </div>
      </section>

      <footer class="resume-sheet__footer">
        <span>{siteConfig.availability}</span><span>内容以正式 PDF 简历为准</span>
      </footer>
    </article>
  </div>
</BaseLayout>

<style>
  .resume-page {
    padding-block: clamp(4rem, 8vw, 8rem);
  }

  .resume-actions {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .resume-actions p {
    margin: 0.8rem 0 0;
    color: var(--ink-500);
    font-size: 0.78rem;
  }

  .resume-actions > div:last-child {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
  }

  .resume-actions__missing {
    opacity: 0.5;
  }

  .resume-sheet {
    max-width: 1080px;
    padding: clamp(2rem, 6vw, 5rem);
    margin: 0 auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface-solid);
    box-shadow: var(--shadow-soft);
  }

  .resume-sheet__hero {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 2.5rem;
    border-bottom: 2px solid var(--ink-950);
  }

  .resume-sheet__english-name {
    margin: 0;
    color: var(--ink-500);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.05em;
  }

  .resume-sheet__hero h1 {
    margin: 0.5rem 0;
    font-size: clamp(3rem, 6vw, 4.25rem);
    letter-spacing: -0.025em;
    line-height: 1.08;
  }

  .resume-sheet__role {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 600;
  }

  address {
    display: grid;
    gap: 0.45rem;
    font-size: 0.8rem;
    font-style: normal;
    text-align: right;
  }

  .resume-section {
    padding: 2.3rem 0;
    border-bottom: 1px solid var(--line);
  }

  .resume-section h2 {
    margin: 0 0 1.5rem;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0;
  }

  .resume-profile p {
    max-width: 820px;
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.85;
  }

  .resume-capabilities {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.3rem 3rem;
  }

  .resume-capabilities div {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 1rem;
  }

  .resume-capabilities span,
  .resume-item p,
  .resume-item li,
  .resume-two-columns p {
    color: var(--ink-650);
    line-height: 1.7;
  }

  .resume-section__heading,
  .resume-item__title {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
  }

  .resume-section__heading > a {
    font-size: 0.8rem;
  }

  .resume-projects {
    display: grid;
    gap: 2rem;
  }

  .resume-item {
    break-inside: avoid;
  }

  .resume-item__title > div {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .resume-item__title span {
    color: var(--ink-500);
    font-size: 0.68rem;
  }

  .resume-item h3 {
    margin: 0;
    font-size: 1.4rem;
  }

  .resume-item p {
    margin: 0.7rem 0;
  }

  .resume-item ul {
    padding-left: 1.2rem;
    margin: 0.6rem 0;
  }

  .resume-item > a {
    font-size: 0.75rem;
    font-weight: 600;
  }

  .resume-two-columns {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3rem;
  }

  .resume-two-columns p {
    margin: 0;
  }

  .resume-sheet__footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    color: var(--ink-500);
    font-size: 0.7rem;
  }

  @media (max-width: 760px) {
    .resume-actions,
    .resume-sheet__hero {
      align-items: stretch;
      flex-direction: column;
    }

    .resume-actions > div:last-child,
    address {
      justify-content: flex-start;
      text-align: left;
    }

    .resume-capabilities,
    .resume-two-columns {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .resume-capabilities div {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }

    .resume-item__title {
      flex-direction: column;
    }
  }
</style>
