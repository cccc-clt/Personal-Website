---
import { getCollection, render } from 'astro:content';
import ImageGallery from '../../components/ImageGallery.astro';
import ProjectCover from '../../components/ProjectCover.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { projectFilterLabels } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order.general - b.data.order.general,
);
const currentIndex = projects.findIndex((entry) => entry.id === project.id);
const nextProject = projects[(currentIndex + 1) % projects.length];
const coverImage = project.data.cover?.src ?? '/images/og/og-general.webp';
const sourceLinks = [
  project.data.demoUrl && { label: '在线 Demo', href: project.data.demoUrl },
  project.data.githubUrl && { label: 'GitHub 仓库', href: project.data.githubUrl },
  project.data.documentUrl && { label: '项目文档', href: project.data.documentUrl },
  project.data.videoUrl && { label: '演示视频', href: project.data.videoUrl },
].filter((link): link is { label: string; href: string } => Boolean(link));
const structuredData = {
  '@type': 'CreativeWork',
  name: project.data.title,
  alternateName: project.data.englishTitle,
  abstract: project.data.description,
  dateModified: project.data.updated.toISOString(),
  creator: { '@id': Astro.site ? new URL('/#person', Astro.site).toString() : '#person' },
  keywords: project.data.categories.join(', '),
  ...(Astro.site ? { url: new URL(Astro.url.pathname, Astro.site).toString() } : {}),
  ...(Astro.site && coverImage ? { image: new URL(coverImage, Astro.site).toString() } : {}),
  ...(project.data.githubUrl ? { sameAs: project.data.githubUrl } : {}),
};
---

<BaseLayout
  title={`${project.data.title}｜赵天琦项目案例`}
  description={project.data.description}
  image={coverImage}
  structuredData={structuredData}
>
  <article class="case-page">
    <header class="case-hero page-shell">
      <div class="case-hero__meta">
        <a href="/projects/">← 返回项目</a>
        <div>
          <span>{project.data.period}</span>
          <StatusBadge status={project.data.status} />
        </div>
      </div>
      <div class="case-hero__title reveal">
        <div>
          <p>
            {
              project.data.filters
                .slice(0, 2)
                .map((filter) => projectFilterLabels[filter])
                .join(' · ')
            }
          </p>
          <h1>{project.data.title}</h1>
          <p>{project.data.description}</p>
        </div>
        {
          sourceLinks.length > 0 && (
            <div class="case-hero__actions" aria-label="项目真实链接">
              {sourceLinks.map((link, index) => (
                <a
                  class:list={['button', { 'button--primary': index === 0 }]}
                  href={link.href}
                  target="_blank"
                  rel="noreferrer"
                >
                  {link.label} ↗
                </a>
              ))}
            </div>
          )
        }
      </div>
      <figure class="case-hero__cover reveal">
        <ProjectCover
          slug={project.id}
          title={project.data.title}
          index={project.data.index}
          cover={project.data.cover}
          coverAlt={project.data.coverAlt}
          coverPosition={project.data.coverPosition}
          loading="eager"
        />
        <figcaption>
          <strong>真实产品截图</strong>
          {project.data.coverAlt ?? `${project.data.title} 的真实产品界面`}
        </figcaption>
      </figure>
    </header>

    <section class="case-summary page-shell reveal" aria-label="项目摘要">
      <dl>
        <div><dt>用户问题</dt><dd>{project.data.problem}</dd></div>
        <div><dt>产品方案</dt><dd>{project.data.solution}</dd></div>
        <div><dt>我的职责</dt><dd>{project.data.role}</dd></div>
        <div><dt>真实产出</dt><dd>{project.data.outcome}</dd></div>
      </dl>
    </section>

    <div class="case-layout page-shell">
      <aside class="case-toc" aria-label="案例目录">
        <p>本案例</p>
        <nav>
          <a href="#background">背景与目标</a>
          <a href="#ai-necessity">AI 必要性</a>
          <a href="#human-checkpoints">人工节点</a>
          <a href="#product-flow">产品流程</a>
          <a href="#prototype-evidence">原型证据</a>
          <a href="#evaluation">评测方法</a>
          <a href="#failure-boundaries">失败边界</a>
          <a href="#iterations">迭代记录</a>
          <a href="#reflection">反思与来源</a>
        </nav>
      </aside>

      <div class="case-content">
        <section class="case-section reveal" id="background">
          <header><span>背景与目标</span><h2>先确定为谁解决什么问题</h2></header>
          <dl class="case-definition">
            <div><dt>目标用户</dt><dd>{project.data.targetUser}</dd></div>
            <div><dt>产品目标</dt><dd>{project.data.goal}</dd></div>
            <div><dt>当前状态</dt><dd>{project.data.period}</dd></div>
          </dl>
          <div>
            <h3>我的工作</h3>
            <ul>{project.data.responsibilities.map((item) => <li>{item}</li>)}</ul>
          </div>
        </section>

        <section class="case-section reveal" id="ai-necessity">
          <header><span>AI 必要性</span><h2>模型进入哪一步，为什么</h2></header>
          <p class="case-lede">{project.data.aiNeeded}</p>
          <ul class="case-list">{project.data.aiDesign.map((item) => <li>{item}</li>)}</ul>
        </section>

        <section class="case-section reveal" id="human-checkpoints">
          <header><span>人工节点</span><h2>哪些判断不能交给模型</h2></header>
          <div class="case-split">
            <div>
              <h3>必须由人确认</h3>
              <ul>{project.data.humanCheckpoints.map((item) => <li>{item}</li>)}</ul>
            </div>
            <div>
              <h3>安全与使用边界</h3>
              <ul>{project.data.safety.map((item) => <li>{item}</li>)}</ul>
            </div>
          </div>
        </section>

        <section class="case-section reveal" id="product-flow">
          <header><span>产品流程</span><h2>从输入到反馈的完整路径</h2></header>
          <ol class="case-flow">
            {
              project.data.flow.map((step, index) => (
                <li>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <strong>{step}</strong>
                </li>
              ))
            }
          </ol>
        </section>

        <section class="case-section reveal" id="prototype-evidence">
          <header><span>原型证据</span><h2>现有材料与缺失状态</h2></header>
          <ImageGallery
            images={project.data.gallery}
            title={project.data.title}
            slug={project.id}
            index={project.data.index}
            cover={project.data.cover}
            coverAlt={project.data.coverAlt}
            coverPosition={project.data.coverPosition}
          />
        </section>

        <section class="case-section reveal" id="evaluation">
          <header><span>评测方法</span><h2>用什么观察产品是否更可靠</h2></header>
          <ul class="case-metrics">
            {project.data.evaluationMetrics.map((metric) => <li>{metric}</li>)}
          </ul>
          <h3>当前重点</h3>
          <p>{project.data.outcome}</p>
        </section>

        <section class="case-section reveal" id="failure-boundaries">
          <header><span>失败边界</span><h2>明确哪些情况不算成功</h2></header>
          <div class="case-split">
            <div>
              <h3>已识别失败</h3>
              <ul>{project.data.failures.map((item) => <li>{item}</li>)}</ul>
            </div>
            <div>
              <h3>异常场景</h3>
              <ul>{project.data.edgeCases.map((item) => <li>{item}</li>)}</ul>
            </div>
          </div>
        </section>

        <section class="case-section reveal" id="iterations">
          <header><span>迭代记录</span><h2>从问题回到下一轮行动</h2></header>
          <div class="case-iterations">
            {
              project.data.iterations.map((iteration) => (
                <article>
                  <div>
                    <span>{iteration.stage}</span>
                    <h3>{iteration.problem}</h3>
                  </div>
                  <dl>
                    <div>
                      <>
                        <dt>判断</dt>
                        <dd>{iteration.analysis}</dd>
                      </>
                    </div>
                    <div>
                      <>
                        <dt>调整</dt>
                        <dd>{iteration.change}</dd>
                      </>
                    </div>
                    <div>
                      <>
                        <dt>结果</dt>
                        <dd>{iteration.result}</dd>
                      </>
                    </div>
                    <div>
                      <>
                        <dt>下一步</dt>
                        <dd>{iteration.next}</dd>
                      </>
                    </div>
                  </dl>
                </article>
              ))
            }
          </div>
        </section>

        <section class="case-section reveal" id="reflection">
          <header><span>反思与来源</span><h2>我从这个项目留下什么判断</h2></header>
          <blockquote>{project.data.reflection}</blockquote>
          <h3>后续计划</h3>
          <ul>{project.data.nextSteps.map((item) => <li>{item}</li>)}</ul>
          <div class="case-source">
            <strong>来源说明</strong>
            <p>{project.data.sourceNote}</p>
          </div>
          <div class="prose case-mdx"><Content /></div>
        </section>
      </div>
    </div>

    <nav class="next-case page-shell reveal" aria-label="下一个项目">
      <span>下一个项目</span>
      <a href={`/projects/${nextProject.id}/`}>
        <strong>{nextProject.data.title}</strong>
        <span aria-hidden="true">→</span>
      </a>
    </nav>
  </article>
</BaseLayout>

<style>
  .case-hero {
    padding-top: clamp(8rem, 14vw, 11rem);
  }

  .case-hero__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.78rem;
  }

  .case-hero__meta > div {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .case-hero__title {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: end;
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }

  .case-hero__title > div:first-child {
    max-width: 980px;
  }

  .case-hero__title > div:first-child > p:first-child {
    margin: 0 0 0.8rem;
    color: var(--accent-hover);
    font-size: 0.82rem;
    font-weight: 600;
  }

  h1 {
    max-width: 17ch;
    margin: 0;
    overflow-wrap: anywhere;
    font-size: clamp(3rem, 5.6vw, 4.25rem);
    letter-spacing: -0.025em;
    line-height: 1.12;
  }

  .case-hero__title > div:first-child > p:last-child {
    max-width: 68ch;
    margin: 1.2rem 0 0;
    color: var(--text-secondary);
    font-size: clamp(1rem, 1.4vw, 1.18rem);
    line-height: 1.8;
  }

  .case-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: flex-end;
  }

  .case-hero__cover {
    margin: 0;
  }

  .case-hero__cover :global(.project-cover) {
    border-radius: var(--radius-card);
  }

  .case-hero__cover figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-top: 0.7rem;
    color: var(--text-muted);
    font-size: 0.72rem;
  }

  .case-hero__cover strong {
    color: var(--text-main);
  }

  .case-summary {
    padding-block: clamp(3rem, 7vw, 6rem);
  }

  .case-summary dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    border-top: 1px solid var(--border-strong);
  }

  .case-summary dl > div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    padding: 1.4rem 1.5rem 1.5rem 0;
    border-bottom: 1px solid var(--border);
  }

  .case-summary dl > div:nth-child(even) {
    padding-left: 1.5rem;
    border-left: 1px solid var(--border);
  }

  .case-summary dt {
    color: var(--text-muted);
    font-size: 0.74rem;
  }

  .case-summary dd {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.88rem;
    line-height: 1.72;
  }

  .case-layout {
    display: grid;
    grid-template-columns: 190px minmax(0, 1fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: start;
    padding-bottom: clamp(5rem, 10vw, 10rem);
  }

  .case-toc {
    position: sticky;
    top: 7rem;
  }

  .case-toc > p {
    margin: 0 0 0.8rem;
    color: var(--text-main);
    font-size: 0.78rem;
    font-weight: 600;
  }

  .case-toc nav {
    display: grid;
  }

  .case-toc a {
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.74rem;
  }

  .case-toc a:hover {
    color: var(--accent-hover);
  }

  .case-content {
    width: min(100%, 820px);
  }

  .case-section {
    scroll-margin-top: 7rem;
    padding: clamp(3.5rem, 8vw, 7rem) 0;
    border-top: 1px solid var(--border-strong);
  }

  .case-section:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .case-section > header {
    margin-bottom: 2rem;
  }

  .case-section > header span {
    color: var(--accent-hover);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .case-section h2 {
    max-width: 18ch;
    margin: 0.5rem 0 0;
    font-size: clamp(2.15rem, 3.8vw, 3rem);
    letter-spacing: -0.018em;
    line-height: 1.18;
  }

  .case-section h3 {
    margin: 2rem 0 0.8rem;
    font-size: 1.1rem;
  }

  .case-section p,
  .case-section li,
  .case-section dd {
    color: var(--text-secondary);
    line-height: 1.8;
  }

  .case-section ul {
    padding-left: 1.2rem;
  }

  .case-lede {
    max-width: 65ch;
    font-size: clamp(1.05rem, 1.5vw, 1.24rem);
  }

  .case-list {
    display: grid;
    gap: 0.65rem;
    margin-top: 1.5rem;
  }

  .case-definition {
    display: grid;
    gap: 0;
    margin: 0;
    border-top: 1px solid var(--border);
  }

  .case-definition div {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }

  .case-definition dt {
    color: var(--text-muted);
    font-size: 0.76rem;
  }

  .case-definition dd {
    margin: 0;
  }

  .case-split {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem;
  }

  .case-split > div {
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .case-split h3 {
    margin-top: 0;
  }

  .case-flow {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
    list-style: none;
  }

  .case-flow li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 0.8rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--border);
  }

  .case-flow li:nth-child(even) {
    padding-left: 1.2rem;
    border-left: 1px solid var(--border);
  }

  .case-flow span {
    color: var(--text-muted);
    font-size: 0.76rem;
  }

  .case-flow strong {
    color: var(--text-main);
  }

  .case-metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    padding: 0 !important;
    list-style: none;
  }

  .case-metrics li {
    padding: 0.55rem 0.72rem;
    border-radius: 8px;
    background: var(--surface-soft);
    font-size: 0.78rem;
  }

  .case-iterations {
    display: grid;
    gap: 3rem;
  }

  .case-iterations article {
    display: grid;
    grid-template-columns: minmax(180px, 0.45fr) minmax(0, 1fr);
    gap: 2rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--border);
  }

  .case-iterations article > div span {
    color: var(--text-muted);
    font-size: 0.74rem;
  }

  .case-iterations article h3 {
    margin-top: 0.6rem;
  }

  .case-iterations dl {
    display: grid;
    gap: 0;
    margin: 0;
  }

  .case-iterations dl div {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 1rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--border);
  }

  .case-iterations dt {
    color: var(--text-muted);
    font-size: 0.74rem;
  }

  .case-iterations dd {
    margin: 0;
  }

  blockquote {
    margin: 0;
    padding: 1.5rem;
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
    color: var(--text-main);
    font-size: clamp(1.05rem, 1.8vw, 1.35rem);
    font-weight: 600;
    line-height: 1.75;
  }

  .case-source {
    margin-top: 2.5rem;
    padding: 1.2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }

  .case-source strong {
    font-size: 0.78rem;
  }

  .case-source p {
    margin: 0.45rem 0 0;
    font-size: 0.82rem;
  }

  .case-mdx {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .next-case {
    display: grid;
    grid-template-columns: 190px minmax(0, 1fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: baseline;
    padding-block: clamp(3rem, 7vw, 6rem);
    border-top: 1px solid var(--border-strong);
  }

  .next-case > span {
    color: var(--text-muted);
    font-size: 0.76rem;
  }

  .next-case a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: clamp(1.5rem, 3vw, 3rem);
  }

  .next-case a > span {
    color: var(--accent-hover);
  }

  @media (max-width: 900px) {
    .case-hero__title,
    .case-layout,
    .next-case {
      grid-template-columns: 1fr;
    }

    .case-hero__actions {
      justify-content: flex-start;
    }

    .case-toc {
      position: static;
      overflow-x: auto;
    }

    .case-toc nav {
      display: flex;
      min-width: max-content;
      gap: 1rem;
    }

    .case-toc a {
      border-bottom-color: var(--border-strong);
    }
  }

  @media (max-width: 680px) {
    .case-summary dl,
    .case-split,
    .case-flow {
      grid-template-columns: 1fr;
    }

    .case-summary dl > div:nth-child(n),
    .case-flow li:nth-child(n) {
      padding-inline: 0;
      border-left: 0;
    }

    .case-summary dl > div,
    .case-definition div {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }

    .case-iterations article {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
