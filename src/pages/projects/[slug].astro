---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import GitHubCard from '../../components/GitHubCard.astro';
import ImageGallery from '../../components/ImageGallery.astro';
import ProjectCover from '../../components/ProjectCover.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { siteConfig } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id.replace(/\.mdx?$/, '') }, props: { project } }));
}

interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const slug = project.id.replace(/\.mdx?$/, '');
const { Content } = await render(project);
const updated = project.data.updated.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
const structuredData = {
  '@context': 'https://schema.org', '@type': 'CreativeWork', name: project.data.title, alternateName: project.data.codename,
  description: project.data.description,
  author: { '@type': 'Person', name: siteConfig.name, ...(Astro.site ? { url: Astro.site.toString() } : {}) },
  ...(Astro.site ? { url: new URL(`/projects/${slug}/`, Astro.site).toString() } : {}),
  keywords: project.data.categories,
};
---

<BaseLayout title={`${project.data.title}｜赵天琦`} description={project.data.description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <article class="case-page">
    <header class="case-hero">
      <div class="page-shell case-hero__grid">
        <div>
          <div class="case-hero__meta"><StatusBadge status={project.data.status} /><span>{project.data.index}</span><span>内容校对 · <time>{updated}</time></span></div>
          <h1>{project.data.title}</h1>
          <p class="case-hero__codename">视觉代号 · {project.data.codename}</p>
          <p class="case-hero__summary">{project.data.summary}</p>
          <div class="chip-row">{project.data.categories.slice(0, 3).map((item) => <span class="chip">{item}</span>)}</div>
        </div>
        <ProjectCover slug={slug} title={project.data.title} index={project.data.index} compact />
      </div>
    </header>

    <div class="case-layout page-shell section">
      <aside class="case-sidebar panel">
        <div class="case-source"><span>内容来源</span><p>{project.data.sourceNote}</p></div>
        <dl><div><dt>我的角色</dt><dd>{project.data.role}</dd></div><div><dt>当前状态</dt><dd>{project.data.period}</dd></div><div><dt>目标用户</dt><dd>{project.data.targetUser}</dd></div><div><dt>技术方案与工具</dt><dd>{project.data.techStack.join(' · ')}</dd></div></dl>
        <nav><a href="/projects/">← 返回全部项目</a>{project.data.githubUrl && <a href={project.data.githubUrl} target="_blank" rel="noreferrer">GitHub ↗</a>}</nav>
      </aside>

      <div class="case-content panel">
        <section><span class="case-index">01 / PROJECT OVERVIEW</span><h2>项目定位、用户问题与产品目标</h2><div class="callout callout--note"><strong>项目定位</strong><p>{project.data.description}</p></div><div class="case-columns"><div><h3>目标用户与使用场景</h3><p>{project.data.targetUser}</p></div><div><h3>用户问题</h3><p>{project.data.problem}</p></div><div><h3>为什么需要 AI</h3><p>{project.data.aiNeeded}</p></div><div><h3>产品目标</h3><p>{project.data.goal}</p></div></div></section>
        <section><span class="case-index">02 / MY ROLE</span><h2>我的职责</h2><ol class="number-list">{project.data.responsibilities.map((item, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><p>{item}</p></li>)}</ol></section>
        <section><span class="case-index">03 / PRODUCT SOLUTION</span><h2>产品方案与技术工作流</h2><div class="callout callout--tip"><strong>核心产品决策</strong><p>{project.data.solution}</p></div><ol class="flow-list">{project.data.flow.map((item, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{item}</strong></li>)}</ol></section>
        <section><span class="case-index">04 / AI DESIGN</span><h2>Prompt、RAG 与 Agent 技术方案</h2><ul class="plain-list">{project.data.aiDesign.map((item) => <li>{item}</li>)}</ul><h3>人工确认节点</h3><div class="chip-row">{project.data.humanCheckpoints.map((item) => <span class="chip">{item}</span>)}</div></section>
        <section><span class="case-index">05 / EVALUATION</span><h2>测试方法与 Evaluation focus</h2><p class="section-note">以下内容是项目中记录或计划观察的评测维度，用于指导验证与迭代，不代表已经取得对应结果。</p><div class="metric-grid">{project.data.evaluationMetrics.map((item, index) => <div><span>E{String(index + 1).padStart(2, '0')}</span><p>{item}</p></div>)}</div></section>
        <section><span class="case-index">06 / FAILURE</span><h2>失败案例、边界与风险</h2><div class="callout callout--warning"><strong>模型边界与风险</strong><p>{project.data.safety.join('；')}</p></div><div class="case-columns"><div><h3>失败类型</h3><ul>{project.data.failures.map((item) => <li>{item}</li>)}</ul></div><div><h3>异常与边缘场景</h3><ul>{project.data.edgeCases.map((item) => <li>{item}</li>)}</ul></div></div></section>
        <section><span class="case-index">07 / ITERATION</span><h2>迭代记录</h2><div class="iteration-list">{project.data.iterations.map((item) => <article><small>{item.stage}</small><h3>{item.problem}</h3><dl><div><dt>分析</dt><dd>{item.analysis}</dd></div><div><dt>改动</dt><dd>{item.change}</dd></div><div><dt>结果</dt><dd>{item.result}</dd></div><div><dt>下一步</dt><dd>{item.next}</dd></div></dl></article>)}</div></section>
        <section><span class="case-index">08 / PRODUCT NOTES</span><h2>产品思考与下一步</h2><blockquote>{project.data.reflection}</blockquote><ul class="plain-list">{project.data.nextSteps.map((item) => <li>{item}</li>)}</ul><div class="mdx-content prose"><Content /></div></section>
        {project.data.githubUrl && <GitHubCard url={project.data.githubUrl} title={project.data.title} description={project.data.description} />}
      </div>
    </div>
    <div class="page-shell"><ImageGallery images={project.data.gallery} title={project.data.title} slug={slug} index={project.data.index} /></div>
  </article>
</BaseLayout>

<style>
  .case-hero { padding: 9.5rem 0 4rem; background: linear-gradient(145deg, var(--primary-soft), color-mix(in srgb, var(--pink) 22%, var(--page-bg))); }
  .case-hero__grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(330px, .75fr); gap: clamp(2rem, 6vw, 6rem); align-items: center; }
  .case-hero__meta { display: flex; flex-wrap: wrap; align-items: center; gap: .8rem; color: var(--text-muted); font-family: var(--font-mono); font-size: .62rem; }
  .case-hero__codename { margin: .55rem 0 0; color: var(--violet); }
  .case-hero h1 { max-width: 950px; margin: 0; font-size: clamp(2.6rem, 6vw, 6rem); letter-spacing: -.065em; line-height: 1.04; }
  .case-hero__summary { max-width: 760px; margin: 1.2rem 0; color: var(--text-secondary); font-size: 1rem; line-height: 1.85; }
  .case-hero :global(.project-cover) { min-height: 300px; }
  .case-layout { display: grid; grid-template-columns: minmax(220px, .65fr) minmax(0, 2fr); gap: 1rem; align-items: start; }
  .case-sidebar { position: sticky; top: 96px; padding: 1.25rem; }
  .case-source { padding: .9rem; margin-bottom: .4rem; border-radius: 12px; background: var(--primary-soft); }
  .case-source span { color: var(--primary-strong); font-family: var(--font-mono); font-size: .58rem; letter-spacing: .08em; }
  .case-source p { margin: .4rem 0 0; color: var(--text-secondary); font-size: .7rem; line-height: 1.65; }
  .case-sidebar dl { margin: 0; }
  .case-sidebar dl div { padding: .9rem 0; border-top: 1px solid var(--border); }
  .case-sidebar dt { color: var(--text-muted); font-size: .63rem; }
  .case-sidebar dd { margin: .35rem 0 0; color: var(--text-secondary); font-size: .76rem; line-height: 1.65; }
  .case-sidebar nav { display: grid; gap: .5rem; margin-top: 1rem; }
  .case-sidebar nav a { padding: .7rem; border: 1px solid var(--border); border-radius: 11px; color: var(--primary-strong); font-size: .72rem; text-align: center; }
  .case-content { padding: clamp(1.5rem, 5vw, 4rem); }
  .case-content > section { padding: 1rem 0 4rem; border-bottom: 1px solid var(--border); }
  .case-content > section:last-of-type { border-bottom: 0; }
  .case-index { color: var(--text-muted); font-family: var(--font-mono); font-size: .64rem; letter-spacing: .08em; }
  .case-content h2 { margin: .65rem 0 1.8rem; font-size: clamp(1.8rem, 4vw, 3.6rem); letter-spacing: -.05em; }
  .case-content h3 { margin: 1.4rem 0 .7rem; }
  .case-content p, .case-content li, .case-content dd { color: var(--text-secondary); line-height: 1.85; }
  .section-note { max-width: 720px; margin: -1rem 0 1.4rem; font-size: .78rem; }
  .case-columns { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  .case-columns > div { padding: 1.1rem; border: 1px solid var(--border); border-radius: 14px; background: var(--surface-soft); }
  .case-columns p { margin: 0; font-size: .8rem; }
  .callout { margin: 0 0 1.5rem; padding: 1rem 1.2rem; border-left: 4px solid var(--primary); border-radius: 0 13px 13px 0; background: var(--primary-soft); }
  .callout--tip { border-color: var(--mint); background: color-mix(in srgb, var(--mint) 13%, transparent); }
  .callout--warning { border-color: var(--pink); background: color-mix(in srgb, var(--pink) 15%, transparent); }
  .callout p { margin: .35rem 0 0; font-size: .8rem; }
  .number-list, .flow-list, .plain-list { padding: 0; margin: 0; list-style: none; }
  .number-list li { display: grid; grid-template-columns: 40px 1fr; gap: .8rem; padding: 1rem 0; border-top: 1px solid var(--border); }
  .number-list span, .flow-list span, .metric-grid span { color: var(--primary); font-family: var(--font-mono); font-size: .65rem; }
  .number-list p { margin: 0; }
  .flow-list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--border); }
  .flow-list li { min-height: 110px; padding: 1rem; background: var(--surface-solid); }
  .flow-list span { display: block; margin-bottom: 1.2rem; }
  .plain-list li { position: relative; padding: .8rem 0 .8rem 1.2rem; border-top: 1px solid var(--border); }
  .plain-list li::before { position: absolute; top: 1.45rem; left: 0; width: 6px; height: 6px; border-radius: 50%; background: var(--violet); content: ''; }
  .metric-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--border); }
  .metric-grid div { padding: 1rem; background: var(--surface-solid); }
  .metric-grid p { margin: .8rem 0 0; font-size: .76rem; }
  .iteration-list { display: grid; gap: 1rem; }
  .iteration-list article { padding: 1.2rem; border: 1px solid var(--border); border-radius: 14px; background: var(--surface-soft); }
  .iteration-list small { color: var(--violet); font-family: var(--font-mono); }
  .iteration-list dl { display: grid; grid-template-columns: repeat(2, 1fr); gap: .8rem; }
  .iteration-list dl div { padding-top: .8rem; border-top: 1px solid var(--border); }
  .iteration-list dt { color: var(--text-muted); font-size: .62rem; }
  .iteration-list dd { margin: .3rem 0 0; font-size: .76rem; }
  blockquote { margin: 0 0 1.5rem; padding: 1.2rem; border-radius: 15px; background: linear-gradient(120deg, var(--primary-soft), color-mix(in srgb, var(--pink) 18%, var(--surface-solid))); font-size: clamp(1rem, 2vw, 1.35rem); font-weight: 650; line-height: 1.7; }
  .mdx-content { margin-top: 2rem; padding-top: 2rem; border-top: 1px dashed var(--border-strong); }
  .mdx-content :global(h2) { font-size: 1.6rem; }
  .case-content > :global(.github-card) { margin-top: 2rem; }
  @media (max-width: 900px) { .case-hero__grid, .case-layout { grid-template-columns: 1fr; } .case-sidebar { position: static; } }
  @media (max-width: 650px) { .case-columns, .flow-list, .metric-grid, .iteration-list dl { grid-template-columns: 1fr; } }
</style>
