---
import { getCollection } from 'astro:content';
import InnerPageHero from '../../components/InnerPageHero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order.general - b.data.order.general);
const filters = [{ key: 'all', label: '全部项目' }, { key: 'game', label: '游戏 AI' }, { key: 'agent', label: 'AI Agent' }, { key: 'auto', label: '智能汽车' }] as const;
---

<BaseLayout title="项目｜赵天琦游戏 AI 产品作品集" description="七个真实 AI 产品案例，覆盖游戏 AI、Agent、产品评测、RAG、UI Agent 与智能座舱。">
  <InnerPageHero eyebrow="PROJECTS / 07 CASE STUDIES" title="真实项目，清楚地说问题、方案与失败。" description="真实项目名称是主体，视觉代号只是一点游戏文化气息。这里不展示虚构用户规模、效率提升或商业成绩。">
    <div class="project-filters" role="group" aria-label="按方向筛选项目" data-project-filters>{filters.map((filter) => <button type="button" data-filter={filter.key} aria-pressed={filter.key === 'all' ? 'true' : 'false'}>{filter.label}</button>)}</div>
  </InnerPageHero>
  <section class="project-index section page-shell" aria-live="polite">
    <div class="project-index__grid" data-project-grid>{projects.map((project, index) => <ProjectCard project={project} layout={index === 0 || index === 4 ? 'wide' : 'standard'} />)}</div>
    <p class="sr-only" data-filter-status>当前展示全部 7 个项目</p>
  </section>
</BaseLayout>

<script>
  const initFilters = () => {
    const group = document.querySelector<HTMLElement>('[data-project-filters]');
    if (!group || group.dataset.ready) return;
    group.dataset.ready = 'true';
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-project-card]'));
    const status = document.querySelector<HTMLElement>('[data-filter-status]');
    group.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-filter]');
      if (!button) return;
      const filter = button.dataset.filter ?? 'all';
      group.querySelectorAll('button').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      let visible = 0;
      cards.forEach((card) => { const matches = filter === 'all' || (card.dataset.tracks ?? '').split(' ').includes(filter); card.hidden = !matches; if (matches) visible += 1; });
      if (status) status.textContent = `当前展示 ${visible} 个项目`;
    });
  };
  initFilters();
  document.addEventListener('swup:contentReplaced', initFilters);
</script>

<style>
  .project-filters { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: 2rem; }
  .project-filters button { padding: .64rem .9rem; border: 1px solid rgba(255,255,255,.55); border-radius: var(--radius-pill); background: rgba(255,255,255,.45); color: var(--text-secondary); cursor: pointer; }
  .project-filters button[aria-pressed='true'] { border-color: var(--text-main); background: var(--text-main); color: var(--surface-solid); }
  .project-index__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .project-index__grid > :global(.project-card--wide) { grid-column: 1 / -1; }
  .project-index__grid > :global([hidden]) { display: none; }
  @media (max-width: 700px) { .project-index__grid { grid-template-columns: 1fr; } .project-index__grid > :global(.project-card--wide) { grid-column: 1; } }
</style>
