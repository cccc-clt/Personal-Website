---
import { getCollection } from 'astro:content';
import InnerPageHero from '../../components/InnerPageHero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projectFilterLabels } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { ProjectFilter } from '../../types/project';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order.general - b.data.order.general,
);
const filters = Object.entries(projectFilterLabels) as [ProjectFilter, string][];
const counts = Object.fromEntries(
  filters.map(([filter]) => [
    filter,
    projects.filter((project) => project.data.filters.includes(filter)).length,
  ]),
);
---

<BaseLayout
  title="项目｜赵天琦 AI 产品作品集"
  description="赵天琦的游戏 AI、Agent、产品评测与工作流项目，展示真实问题、职责、产出、失败边界与证据来源。"
>
  <InnerPageHero
    eyebrow="项目案例"
    title="看问题、方案和证据，不只看一张封面。"
    description="这里的每个案例都说明用户问题、AI 必要性、人工节点、当前产出与仍未验证的边界。概念图会明确标注，不代替真实运行证据。"
  />

  <section class="projects-page page-shell" aria-labelledby="projects-list-title">
    <div class="projects-toolbar">
      <div>
        <h2 id="projects-list-title">全部项目</h2>
        <p><span data-visible-count>{projects.length}</span> / {projects.length} 个案例</p>
      </div>
      <div class="projects-filters" aria-label="按项目类型筛选">
        <button type="button" data-project-filter="all" aria-pressed="true">
          全部 <span>{projects.length}</span>
        </button>
        {
          filters.map(([filter, label]) => (
            <button type="button" data-project-filter={filter} aria-pressed="false">
              {label} <span>{counts[filter]}</span>
            </button>
          ))
        }
      </div>
    </div>

    <div class="projects-grid" data-project-grid>
      {
        projects.map((project) => (
          <div data-project-item data-project-filters={project.data.filters.join(' ')}>
            <ProjectCard project={project} />
          </div>
        ))
      }
    </div>

    <div class="projects-empty" data-project-empty hidden>
      <h3>这个筛选下暂时没有项目</h3>
      <p>你可以返回“全部”，或从研究页面了解我的方法和判断方式。</p>
      <div>
        <button class="button" type="button" data-project-filter="all">查看全部项目</button>
        <a class="text-link" href="/research/">前往研究</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const filterKeys = ['game-ai', 'agent', 'evaluation', 'workflow'];

  const applyProjectFilter = (requested: string, updateHistory = false) => {
    const filter = filterKeys.includes(requested) ? requested : 'all';
    const items = document.querySelectorAll<HTMLElement>('[data-project-item]');
    if (!items.length) return;

    let visible = 0;
    items.forEach((item) => {
      const matches =
        filter === 'all' || (item.dataset.projectFilters ?? '').split(' ').includes(filter);
      item.hidden = !matches;
      if (matches) visible += 1;
    });

    document.querySelectorAll<HTMLButtonElement>('[data-project-filter]').forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.projectFilter === filter));
    });
    const count = document.querySelector<HTMLElement>('[data-visible-count]');
    if (count) count.textContent = String(visible);
    const empty = document.querySelector<HTMLElement>('[data-project-empty]');
    if (empty) empty.hidden = visible > 0;

    if (updateHistory) {
      const url = new URL(location.href);
      if (filter === 'all') url.searchParams.delete('filter');
      else url.searchParams.set('filter', filter);
      history.pushState({ filter }, '', url);
    }
  };

  const applyProjectFilterFromUrl = () => {
    applyProjectFilter(new URL(location.href).searchParams.get('filter') ?? 'all');
  };

  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
      '[data-project-filter]',
    );
    if (!button || !document.querySelector('[data-project-grid]')) return;
    applyProjectFilter(button.dataset.projectFilter ?? 'all', true);
  });
  addEventListener('popstate', applyProjectFilterFromUrl);
  applyProjectFilterFromUrl();
</script>

<style>
  .projects-page {
    padding-block: clamp(4rem, 8vw, 8rem);
  }

  .projects-toolbar {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 3rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-strong);
  }

  .projects-toolbar h2 {
    margin: 0;
    font-size: clamp(1.7rem, 3vw, 2.8rem);
  }

  .projects-toolbar p {
    margin: 0.45rem 0 0;
    color: var(--text-muted);
    font-size: 0.78rem;
  }

  .projects-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    justify-content: flex-end;
  }

  .projects-filters button {
    min-height: 42px;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 580;
  }

  .projects-filters button span {
    margin-left: 0.3rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .projects-filters button:hover,
  .projects-filters button[aria-pressed='true'] {
    border-color: var(--primary);
    background: var(--primary-soft);
    color: var(--primary-strong);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    align-items: start;
  }

  [data-project-item][hidden] {
    display: none;
  }

  .projects-empty {
    padding: clamp(3rem, 8vw, 7rem) 0;
    text-align: center;
  }

  .projects-empty[hidden] {
    display: none;
  }

  .projects-empty h3 {
    margin: 0;
    font-size: clamp(1.7rem, 4vw, 3rem);
  }

  .projects-empty p {
    margin: 0.8rem 0 1.5rem;
    color: var(--text-secondary);
  }

  .projects-empty > div {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 800px) {
    .projects-toolbar {
      align-items: start;
      flex-direction: column;
    }

    .projects-filters {
      justify-content: flex-start;
    }
  }

  @media (max-width: 680px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
