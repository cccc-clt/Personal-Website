---
import { getCollection } from 'astro:content';
import ArchiveHero from '../../components/ArchiveHero.astro';
import ArchiveSearchPanel from '../../components/ArchiveSearchPanel.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projectFilterLabels } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { ProjectFilter, ProjectStatus } from '../../types/project';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order.general - b.data.order.general,
);
const featuredProjects = projects
  .filter((project) => project.data.homepageFeatured)
  .sort((a, b) => (a.data.homepageOrder ?? 99) - (b.data.homepageOrder ?? 99))
  .slice(0, 3);
const filters = Object.entries(projectFilterLabels) as [ProjectFilter, string][];
const filterCounts = Object.fromEntries(
  filters.map(([filter]) => [
    filter,
    projects.filter((project) => project.data.filters.includes(filter)).length,
  ]),
);
const publicCount = projects.filter((project) => project.data.githubUrl).length;
const localCount = projects.length - publicCount;
const statusLabels: Record<ProjectStatus, string> = {
  LIVE: '已上线',
  TESTED: '已验证',
  ITERATING: '持续迭代',
  ARCHIVED: '已归档',
};
const statuses = [...new Set(projects.map((project) => project.data.status))] as ProjectStatus[];
const statusCounts = Object.fromEntries(
  statuses.map((status) => [
    status,
    projects.filter((project) => project.data.status === status).length,
  ]),
);
---

<BaseLayout
  title="项目案例｜赵天琦 AI 产品作品集"
  description="赵天琦的游戏 AI、Agent、产品评测与工作流项目入口，展示真实项目来源、当前阶段与可核验案例。"
>
  <ArchiveHero
    eyebrow="GAME AI · PRODUCT PRACTICE"
    title="项目案例"
    description={`共收录 ${projects.length} 个项目，持续迭代中`}
  />

  <section class="portal page-shell" aria-labelledby="projects-list-title">
    <aside class="portal-featured reveal" aria-labelledby="featured-project-nav">
      <div class="portal-sticky">
        <p class="portal-label">项目导航</p>
        <h2 id="featured-project-nav">精选项目</h2>
        <nav aria-label="三个重点项目">
          {
            featuredProjects.map((project, index) => (
              <a href={`/projects/${project.id}/`}>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <strong>{project.data.title}</strong>
              </a>
            ))
          }
        </nav>
        <p class="portal-note">按首页精选顺序展示，不代表热度或排名。</p>
      </div>
    </aside>

    <div class="portal-main">
      <header class="portal-main__header reveal">
        <div>
          <p class="portal-label">全部案例</p>
          <h2 id="projects-list-title">项目列表</h2>
        </div>
        <span><strong data-visible-count>{projects.length}</strong> / {projects.length}</span>
      </header>

      <div class="projects-grid" data-project-grid data-reveal-group>
        {
          projects.map((project) => (
            <div
              data-project-item
              data-project-filters={project.data.filters.join(' ')}
              data-project-source={project.data.githubUrl ? 'public' : 'local'}
              data-project-status={project.data.status.toLowerCase()}
            >
              <ProjectCard project={project} />
            </div>
          ))
        }
      </div>

      <div class="portal-empty" data-project-empty hidden>
        <h3>没有符合这些条件的项目</h3>
        <p>清除筛选后可以继续浏览全部真实案例。</p>
        <button class="button" type="button" data-project-reset>清除筛选</button>
      </div>
    </div>

    <details class="portal-filters reveal" data-portal-filters open>
      <summary>搜索与筛选 <span aria-hidden="true">＋</span></summary>
      <div class="portal-filters__content portal-sticky">
        <ArchiveSearchPanel label="搜索项目" placeholder="搜索项目、Agent、评测……" />

        <section class="filter-group" aria-labelledby="project-category-filter">
          <h2 id="project-category-filter">项目分类</h2>
          <div>
            <button type="button" data-project-filter="all" aria-pressed="true">
              <span>全部项目</span><small>{projects.length}</small>
            </button>
            {
              filters.map(([filter, label]) => (
                <button type="button" data-project-filter={filter} aria-pressed="false">
                  <>
                    <span>{label}</span>
                    <small>{filterCounts[filter]}</small>
                  </>
                </button>
              ))
            }
          </div>
        </section>

        <section class="filter-group" aria-labelledby="project-source-filter">
          <h2 id="project-source-filter">证据来源</h2>
          <div>
            <button type="button" data-project-source-filter="all" aria-pressed="true">
              <span>全部来源</span><small>{projects.length}</small>
            </button>
            <button type="button" data-project-source-filter="public" aria-pressed="false">
              <span>公开仓库</span><small>{publicCount}</small>
            </button>
            <button type="button" data-project-source-filter="local" aria-pressed="false">
              <span>本地案例</span><small>{localCount}</small>
            </button>
          </div>
        </section>

        <section class="filter-group" aria-labelledby="project-status-filter">
          <h2 id="project-status-filter">当前阶段</h2>
          <div>
            <button type="button" data-project-status-filter="all" aria-pressed="true">
              <span>全部阶段</span><small>{projects.length}</small>
            </button>
            {
              statuses.map((status) => (
                <button
                  type="button"
                  data-project-status-filter={status.toLowerCase()}
                  aria-pressed="false"
                >
                  <>
                    <span>{statusLabels[status]}</span>
                    <small>{statusCounts[status]}</small>
                  </>
                </button>
              ))
            }
          </div>
        </section>
      </div>
    </details>
  </section>
</BaseLayout>

<script>
  const projectFilterKeys = ['game-ai', 'agent', 'evaluation', 'workflow'];
  const projectSourceKeys = ['public', 'local'];
  const projectStatusKeys = ['live', 'tested', 'iterating', 'archived'];

  const normalizedProjectState = () => {
    const params = new URL(location.href).searchParams;
    const requestedFilter = params.get('filter') ?? 'all';
    const requestedSource = params.get('source') ?? 'all';
    const requestedStatus = params.get('status') ?? 'all';
    return {
      filter: projectFilterKeys.includes(requestedFilter) ? requestedFilter : 'all',
      source: projectSourceKeys.includes(requestedSource) ? requestedSource : 'all',
      status: projectStatusKeys.includes(requestedStatus) ? requestedStatus : 'all',
    };
  };

  const applyProjectFilters = () => {
    const state = normalizedProjectState();
    const items = document.querySelectorAll<HTMLElement>('[data-project-item]');
    if (!items.length) return;

    let visible = 0;
    items.forEach((item) => {
      const filters = (item.dataset.projectFilters ?? '').split(' ');
      const matchesFilter = state.filter === 'all' || filters.includes(state.filter);
      const matchesSource = state.source === 'all' || item.dataset.projectSource === state.source;
      const matchesStatus = state.status === 'all' || item.dataset.projectStatus === state.status;
      const matches = matchesFilter && matchesSource && matchesStatus;
      item.hidden = !matches;
      if (matches) visible += 1;
    });

    document.querySelectorAll<HTMLButtonElement>('[data-project-filter]').forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.projectFilter === state.filter));
    });
    document
      .querySelectorAll<HTMLButtonElement>('[data-project-source-filter]')
      .forEach((button) => {
        button.setAttribute(
          'aria-pressed',
          String(button.dataset.projectSourceFilter === state.source),
        );
      });
    document
      .querySelectorAll<HTMLButtonElement>('[data-project-status-filter]')
      .forEach((button) => {
        button.setAttribute(
          'aria-pressed',
          String(button.dataset.projectStatusFilter === state.status),
        );
      });

    const count = document.querySelector<HTMLElement>('[data-visible-count]');
    if (count) count.textContent = String(visible);
    const empty = document.querySelector<HTMLElement>('[data-project-empty]');
    if (empty) empty.hidden = visible > 0;
  };

  const updateProjectParam = (key: 'filter' | 'source' | 'status', value: string) => {
    const url = new URL(location.href);
    if (value === 'all') url.searchParams.delete(key);
    else url.searchParams.set(key, value);
    history.pushState({}, '', url);
    applyProjectFilters();
  };

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const filterButton = target.closest<HTMLButtonElement>('[data-project-filter]');
    const sourceButton = target.closest<HTMLButtonElement>('[data-project-source-filter]');
    const statusButton = target.closest<HTMLButtonElement>('[data-project-status-filter]');
    const resetButton = target.closest<HTMLButtonElement>('[data-project-reset]');
    if (!document.querySelector('[data-project-grid]')) return;

    if (filterButton) {
      updateProjectParam('filter', filterButton.dataset.projectFilter ?? 'all');
    } else if (sourceButton) {
      updateProjectParam('source', sourceButton.dataset.projectSourceFilter ?? 'all');
    } else if (statusButton) {
      updateProjectParam('status', statusButton.dataset.projectStatusFilter ?? 'all');
    } else if (resetButton) {
      const url = new URL(location.href);
      url.searchParams.delete('filter');
      url.searchParams.delete('source');
      url.searchParams.delete('status');
      history.pushState({}, '', url);
      applyProjectFilters();
    }
  });

  addEventListener('popstate', applyProjectFilters);
  applyProjectFilters();
</script>

<style>
  .portal {
    display: grid;
    grid-template-columns: minmax(170px, 0.22fr) minmax(0, 1fr) minmax(210px, 0.25fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
    padding-block: clamp(4.5rem, 8vw, 7.5rem);
  }

  .portal-featured {
    grid-column: 1;
  }

  .portal-main {
    min-width: 0;
    grid-column: 2;
  }

  .portal-filters {
    min-width: 0;
    grid-column: 3;
  }

  .portal-sticky {
    position: sticky;
    top: 7.5rem;
  }

  .portal-label {
    margin: 0;
    color: var(--accent-hover);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .portal-featured h2,
  .portal-main__header h2 {
    margin: 0.5rem 0 0;
    font-size: clamp(1.55rem, 2.5vw, 2rem);
  }

  .portal-featured nav {
    display: grid;
    margin-top: 1.35rem;
    border-top: 1px solid var(--border);
  }

  .portal-featured nav a {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.7rem;
    min-height: 64px;
    align-items: start;
    padding-block: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .portal-featured nav a:hover strong {
    color: var(--accent-hover);
  }

  .portal-featured nav span {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .portal-featured nav strong {
    font-size: 0.82rem;
    line-height: 1.5;
    transition: color 220ms ease;
  }

  .portal-note {
    margin: 1rem 0 0;
    color: var(--text-muted);
    font-size: 0.68rem;
    line-height: 1.65;
  }

  .portal-main__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid var(--border-strong);
  }

  .portal-main__header > span {
    flex: 0 0 auto;
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .portal-main__header > span strong {
    color: var(--accent-hover);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    align-items: stretch;
  }

  .projects-grid > div {
    min-width: 0;
  }

  [data-project-item][hidden] {
    display: none;
  }

  .portal-filters summary {
    display: none;
  }

  .portal-filters__content {
    display: grid;
    gap: 2rem;
  }

  .filter-group {
    display: grid;
    gap: 0.75rem;
  }

  .filter-group h2 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.8rem;
  }

  .filter-group > div {
    display: grid;
    gap: 0.15rem;
  }

  .filter-group button {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0.7rem;
    border: 0;
    border-radius: 9px;
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    font-size: 0.75rem;
    text-align: left;
  }

  .filter-group button:hover,
  .filter-group button[aria-pressed='true'] {
    background: var(--accent-soft);
    color: var(--accent-hover);
  }

  .filter-group small {
    color: var(--text-muted);
    font-size: 0.66rem;
  }

  .portal-empty {
    padding: clamp(3rem, 7vw, 6rem) 1rem;
    text-align: center;
  }

  .portal-empty[hidden] {
    display: none;
  }

  .portal-empty h3 {
    margin: 0;
    font-size: clamp(1.7rem, 4vw, 2.5rem);
  }

  .portal-empty p {
    margin: 0.8rem 0 1.5rem;
    color: var(--text-secondary);
  }

  @media (max-width: 1100px) {
    .portal {
      grid-template-columns: 1fr;
      grid-template-areas:
        'featured'
        'filters'
        'main';
    }

    .portal-featured {
      grid-area: featured;
    }

    .portal-main {
      grid-area: main;
    }

    .portal-filters {
      grid-area: filters;
    }

    .portal-sticky {
      position: static;
    }

    .portal-featured nav {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .portal-featured nav a {
      padding: 1rem;
      border: 1px solid var(--border);
      border-radius: 12px;
    }

    .portal-featured nav a + a {
      margin-left: 0.75rem;
    }

    .portal-filters {
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: var(--surface-warm);
    }

    .portal-filters summary {
      display: flex;
      min-height: 52px;
      align-items: center;
      justify-content: space-between;
      padding: 0.75rem 1rem;
      color: var(--text-primary);
      cursor: pointer;
      font-size: 0.84rem;
      font-weight: 600;
      list-style: none;
    }

    .portal-filters summary::-webkit-details-marker {
      display: none;
    }

    .portal-filters:not([open]) .portal-filters__content {
      display: none;
    }

    .portal-filters__content {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding: 1rem;
      border-top: 1px solid var(--border);
    }
  }

  @media (max-width: 700px) {
    .portal {
      gap: 2rem;
      padding-block: 3.5rem 4.5rem;
    }

    .portal-featured nav,
    .projects-grid,
    .portal-filters__content {
      grid-template-columns: 1fr;
    }

    .portal-featured nav {
      gap: 0.6rem;
      border: 0;
    }

    .portal-featured nav a {
      min-height: 58px;
    }

    .portal-featured nav a + a {
      margin-left: 0;
    }
  }
</style>
