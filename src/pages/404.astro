---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
const hasImage = existsSync(join(process.cwd(), 'public/assets/images/404.webp'));
---

<BaseLayout
  title="404｜在幻想站台迷路了"
  description="页面没有找到，返回赵天琦的个人网站首页。"
  noindex
>
  <section class="not-found page-shell">
    <div class="not-found__copy">
      <span class="eyebrow">页面未找到 · 404</span><p class="not-found__number">404</p><h1>
        这条路径没有内容。
      </h1><p>页面可能已经移动。你可以回到首页，或继续查看项目和研究。</p><div>
        <a class="button button--primary" href="/">返回首页</a><a class="button" href="/projects/"
          >查看项目</a
        ><a class="text-link" href="/research/">查看研究</a>
      </div>
    </div>
    <div class="not-found__art">
      {
        hasImage ? (
          <img
            src="/assets/images/404.webp"
            width="1400"
            height="1000"
            alt="原创成年女性角色在黄昏站台确认路线的插画"
            loading="eager"
            decoding="async"
          />
        ) : (
          <span aria-hidden="true">◇</span>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    min-height: 78vh;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.85fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
    padding-top: 7rem;
  }
  .not-found__number {
    margin: 0.5rem 0 0;
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: clamp(4rem, 10vw, 9rem);
    font-weight: 700;
    line-height: 1;
    opacity: 0.24;
  }
  h1 {
    max-width: 720px;
    margin: -0.5rem 0 1rem;
    font-size: clamp(2.3rem, 5vw, 5rem);
    letter-spacing: -0.025em;
    line-height: 1.12;
  }
  .not-found__copy > p:not(.not-found__number) {
    color: var(--text-secondary);
    line-height: 1.8;
  }
  .not-found__copy > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }
  .not-found__art {
    display: grid;
    aspect-ratio: 7 / 5;
    place-items: center;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--surface-tint);
    color: var(--violet);
    font-size: 4rem;
  }
  .not-found__art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (max-width: 800px) {
    .not-found {
      grid-template-columns: 1fr;
      padding-bottom: 4rem;
    }
    .not-found__art {
      order: -1;
      max-width: 480px;
    }
  }
</style>
