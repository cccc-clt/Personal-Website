---
import { getCollection } from 'astro:content';
import InnerPageHero from '../components/InnerPageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const observations = (await getCollection('game')).filter((item) => !item.data.draft);
const fields = ['游戏名称', '当前体验状态', '主要体验模块', '最喜欢的产品设计', '当前体验痛点', '可引入 AI 的场景', 'AI 风险和边界', '观察更新时间'];
---

<BaseLayout title="二次元游戏体验与 AI 产品观察｜赵天琦" description="从真实游戏体验出发，记录产品设计、体验痛点、AI 场景与风险边界。">
  <InnerPageHero eyebrow="GAME CULTURE / PRODUCT NOTES" title="二次元游戏体验与 AI 产品观察" description="从具体体验出发，再讨论 AI 是否值得进入场景。这里不记录虚构时长、氪金、段位或角色练度。" />
  <section class="game-page section page-shell">
    {
      observations.length ? (
        <div class="game-list">
          {observations.map((item) => <article class="panel"><span class="eyebrow">{item.data.status}</span><h2>{item.data.game}</h2><p>{item.data.favoriteDesign}</p></article>)}
        </div>
      ) : (
        <div class="game-empty panel">
          <div class="game-empty__art" aria-hidden="true"><span>◇</span><i></i><i></i></div>
          <div><span class="eyebrow">REAL EXPERIENCE FIRST</span><h2>待补充真实体验记录</h2><p>当前仓库没有可验证的个人游戏体验数据，因此暂不展示具体游戏、时长或进度。内容模板已经建立，后续只需填写真实观察并解除草稿状态。</p></div>
        </div>
      )
    }
    <section class="game-template panel">
      <header><span class="eyebrow">OBSERVATION TEMPLATE</span><h2>一条观察应该包含什么？</h2></header>
      <ol>{fields.map((field, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{field}</strong><p>待补充真实体验记录</p></li>)}</ol>
      <aside><strong>图片原则</strong><p>仅使用用户自己的合法截图、原创抽象封面或授权清晰的素材；不使用官方角色资产包装个人品牌。</p></aside>
    </section>
  </section>
</BaseLayout>

<style>
  .game-page { display: grid; gap: 1rem; }
  .game-empty { display: grid; grid-template-columns: 220px 1fr; gap: clamp(1.5rem, 4vw, 4rem); align-items: center; padding: clamp(1.5rem, 4vw, 3rem); }
  .game-empty__art { position: relative; display: grid; aspect-ratio: 1; place-items: center; overflow: hidden; border-radius: 38% 62% 45% 55%; background: linear-gradient(145deg, var(--primary-soft), #eadff6 55%, #f8e0e6); color: var(--violet); font-size: 2rem; }
  .game-empty__art i { position: absolute; width: 50%; height: 50%; border: 1px solid rgba(125, 113, 181, .25); rotate: 45deg; }
  .game-empty__art i:last-child { width: 30%; height: 30%; }
  .game-empty h2, .game-template h2 { margin: 0.65rem 0 1rem; font-size: clamp(2rem, 4vw, 4rem); letter-spacing: -0.05em; }
  .game-empty p, .game-template p { color: var(--text-secondary); line-height: 1.85; }
  .game-template { padding: clamp(1.5rem, 4vw, 3rem); }
  .game-template ol { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; padding: 0; margin: 2rem 0 0; background: var(--border); list-style: none; }
  .game-template li { display: grid; grid-template-columns: 38px 1fr; gap: 0.8rem; padding: 1.2rem; background: var(--surface-solid); }
  .game-template li > span { color: var(--text-muted); font-family: var(--font-mono); font-size: 0.62rem; }
  .game-template li p { grid-column: 2; margin: 0; font-size: 0.75rem; }
  .game-template aside { margin-top: 1.5rem; padding: 1rem; border-left: 3px solid var(--mint); background: color-mix(in srgb, var(--mint) 10%, transparent); }
  .game-template aside p { margin: 0.45rem 0 0; font-size: 0.78rem; }
  @media (max-width: 680px) { .game-empty { grid-template-columns: 1fr; } .game-empty__art { max-width: 180px; } .game-template ol { grid-template-columns: 1fr; } }
</style>
