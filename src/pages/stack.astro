---
import InnerPageHero from '../components/InnerPageHero.astro';
import { toolStack } from '../data/siteContent';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="我的 AI 工具链｜赵天琦" description="赵天琦在 AI 产品原型、工作流、RAG、评测和网站开发中的真实工具链。">
  <InnerPageHero eyebrow="AI 炼丹炉 / BUILDING STACK" title="我的 AI 工具链" description="工具不是技能百分比，而是具体用来解决什么问题、在哪个项目里实践，以及下一步还要补什么。" />
  <section class="stack-page section page-shell">
    <div class="stack-intro panel"><span class="eyebrow">WORKFLOW</span><p>需求与场景 → Prompt / 工作流 → 轻量原型 → 测试记录 → 失败分类 → 下一轮迭代</p></div>
    <div class="stack-grid">{toolStack.map((tool, index) => <article class="tool-card panel"><header><span>{String(index + 1).padStart(2, '0')}</span><small>{tool.state}</small></header><h2>{tool.name}</h2><dl><div><dt>用途</dt><dd>{tool.use}</dd></div><div><dt>使用场景</dt><dd>{tool.scene}</dd></div><div><dt>关联项目</dt><dd>{tool.project}</dd></div><div><dt>后续学习</dt><dd>{tool.next}</dd></div></dl></article>)}</div>
  </section>
</BaseLayout>

<style>
  .stack-page { display: grid; gap: 1rem; }
  .stack-intro { padding: 1.4rem 1.6rem; }
  .stack-intro p { margin: 0.7rem 0 0; font-size: clamp(1rem, 2vw, 1.45rem); font-weight: 650; }
  .stack-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .tool-card { padding: 1.4rem; }
  .tool-card header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; color: var(--text-muted); font-family: var(--font-mono); font-size: 0.62rem; }
  .tool-card header small { padding: 0.35rem 0.55rem; border-radius: var(--radius-pill); background: var(--primary-soft); color: var(--primary-strong); }
  .tool-card h2 { min-height: 2.6em; margin: 1rem 0 1.2rem; font-size: 1.3rem; line-height: 1.3; }
  .tool-card dl { margin: 0; }
  .tool-card dl div { padding: 0.8rem 0; border-top: 1px solid var(--border); }
  .tool-card dt { color: var(--text-muted); font-size: 0.62rem; }
  .tool-card dd { margin: 0.35rem 0 0; color: var(--text-secondary); font-size: 0.75rem; line-height: 1.7; }
  @media (max-width: 980px) { .stack-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 620px) { .stack-grid { grid-template-columns: 1fr; } .tool-card h2 { min-height: auto; } }
</style>
