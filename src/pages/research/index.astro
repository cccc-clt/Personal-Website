---
import { getCollection } from 'astro:content';
import ArchiveHero from '../../components/ArchiveHero.astro';
import ArchiveSearchPanel from '../../components/ArchiveSearchPanel.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { researchCategoryLabels } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { estimateReadingMinutes, formatDate } from '../../utils/content';

const articles = (await getCollection('research'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const featuredArticles = articles.filter(
  (article) => article.data.featured || article.data.homepageFeatured,
);
const recommendedArticles = (featuredArticles.length ? featuredArticles : articles).slice(0, 5);
const categories = Object.entries(researchCategoryLabels);
const categoryCounts = Object.fromEntries(
  categories.map(([category]) => [
    category,
    articles.filter((article) => article.data.category === category).length,
  ]),
);
const archiveGroups = [
  ...new Map(
    articles.map((article) => {
      const date = article.data.publishedAt;
      const key = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;
      return [
        key,
        {
          key,
          label: `${date.getFullYear()} 年 ${date.getMonth() + 1} 月`,
          count: articles.filter((entry) => {
            const entryDate = entry.data.publishedAt;
            return (
              entryDate.getFullYear() === date.getFullYear() &&
              entryDate.getMonth() === date.getMonth()
            );
          }).length,
        },
      ];
    }),
  ).values(),
];
---

<BaseLayout
  title="研究与随想｜赵天琦的游戏观察与 AI 产品方法"
  description="赵天琦关于游戏观察、玩家洞察、AI 产品机会、Agent 评测与产品方法的已发布内容入口。"
>
  <ArchiveHero
    eyebrow="游戏观察 · AI 产品 · 思考记录"
    title="研究与随想"
    description={`共发布 ${articles.length} 篇内容，持续更新中`}
  />

  <section class="portal page-shell" aria-labelledby="research-list-title">
    <aside class="portal-featured reveal" aria-labelledby="recommended-reading-title">
      <div class="portal-sticky">
        <p class="portal-label">内容导航</p>
        <h2 id="recommended-reading-title">推荐阅读</h2>
        <nav aria-label="推荐阅读文章">
          {
            recommendedArticles.map((article, index) => (
              <a href={`/research/${article.id}/`}>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <strong>{article.data.title}</strong>
                <small>
                  {estimateReadingMinutes(article.body)} 分钟 · {formatDate(article.data.updatedAt)}
                </small>
              </a>
            ))
          }
        </nav>
        <p class="portal-note">当前仅展示真实已发布内容；不会用“整理中”选题补足推荐数量。</p>
      </div>
    </aside>

    <div class="portal-main">
      <header class="portal-main__header reveal">
        <div>
          <p class="portal-label">已发布内容</p>
          <h2 id="research-list-title">文章列表</h2>
        </div>
        <span><strong data-research-count>{articles.length}</strong> / {articles.length}</span>
      </header>

      <div class="research-grid" data-research-list data-reveal-group>
        {
          articles.map((article) => {
            const date = article.data.publishedAt;
            const archiveKey = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;
            return (
              <div
                data-research-item
                data-research-category={article.data.category}
                data-research-archive={archiveKey}
              >
                <ArticleCard article={article} />
              </div>
            );
          })
        }
      </div>

      <div class="portal-empty" data-research-empty hidden>
        <h3>这个组合下还没有已发布内容</h3>
        <p>选题只有完成真实性检查后才会进入文章列表。</p>
        <button class="button" type="button" data-research-reset>清除筛选</button>
      </div>
    </div>

    <details class="portal-filters reveal" data-portal-filters open>
      <summary>搜索与筛选 <span aria-hidden="true">＋</span></summary>
      <div class="portal-filters__content portal-sticky">
        <ArchiveSearchPanel label="搜索内容" placeholder="搜索游戏、玩家洞察、评测……" />

        <section class="filter-group" aria-labelledby="research-category-filter">
          <h2 id="research-category-filter">内容分类</h2>
          <div>
            <button type="button" data-research-filter="all" aria-pressed="true">
              <span>全部</span><small>{articles.length}</small>
            </button>
            {
              categories.map(([category, label]) => (
                <button type="button" data-research-filter={category} aria-pressed="false">
                  <>
                    <span>{label}</span>
                    <small>{categoryCounts[category]}</small>
                  </>
                </button>
              ))
            }
          </div>
        </section>

        <section class="filter-group" aria-labelledby="research-archive-filter">
          <h2 id="research-archive-filter">年月归档</h2>
          <div>
            <button type="button" data-research-archive-filter="all" aria-pressed="true">
              <span>全部时间</span><small>{articles.length}</small>
            </button>
            {
              archiveGroups.map((archive) => (
                <button
                  type="button"
                  data-research-archive-filter={archive.key}
                  aria-pressed="false"
                >
                  <>
                    <span>{archive.label}</span>
                    <small>{archive.count}</small>
                  </>
                </button>
              ))
            }
          </div>
        </section>
      </div>
    </details>
  </section>
</BaseLayout>

<script>
  const researchCategoryKeys = [
    'game-research',
    'player-insight',
    'ai-opportunity',
    'agent-evaluation',
    'product-method',
    'learning-notes',
  ];

  const normalizedResearchState = () => {
    const params = new URL(location.href).searchParams;
    const requestedCategory = params.get('category') ?? 'all';
    const requestedArchive = params.get('archive') ?? 'all';
    const archiveKeys = [...document.querySelectorAll<HTMLElement>('[data-research-archive]')].map(
      (item) => item.dataset.researchArchive,
    );
    return {
      category: researchCategoryKeys.includes(requestedCategory) ? requestedCategory : 'all',
      archive: archiveKeys.includes(requestedArchive) ? requestedArchive : 'all',
    };
  };

  const applyResearchFilters = () => {
    const state = normalizedResearchState();
    const items = document.querySelectorAll<HTMLElement>('[data-research-item]');
    if (!items.length) return;

    let visible = 0;
    items.forEach((item) => {
      const matchesCategory =
        state.category === 'all' || item.dataset.researchCategory === state.category;
      const matchesArchive =
        state.archive === 'all' || item.dataset.researchArchive === state.archive;
      const matches = matchesCategory && matchesArchive;
      item.hidden = !matches;
      if (matches) visible += 1;
    });

    document.querySelectorAll<HTMLButtonElement>('[data-research-filter]').forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.researchFilter === state.category));
    });
    document
      .querySelectorAll<HTMLButtonElement>('[data-research-archive-filter]')
      .forEach((button) => {
        button.setAttribute(
          'aria-pressed',
          String(button.dataset.researchArchiveFilter === state.archive),
        );
      });

    const count = document.querySelector<HTMLElement>('[data-research-count]');
    if (count) count.textContent = String(visible);
    const empty = document.querySelector<HTMLElement>('[data-research-empty]');
    if (empty) empty.hidden = visible > 0;
  };

  const updateResearchParam = (key: 'category' | 'archive', value: string) => {
    const url = new URL(location.href);
    if (value === 'all') url.searchParams.delete(key);
    else url.searchParams.set(key, value);
    history.pushState({}, '', url);
    applyResearchFilters();
  };

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const categoryButton = target.closest<HTMLButtonElement>('[data-research-filter]');
    const archiveButton = target.closest<HTMLButtonElement>('[data-research-archive-filter]');
    const resetButton = target.closest<HTMLButtonElement>('[data-research-reset]');
    if (!document.querySelector('[data-research-list]')) return;

    if (categoryButton) {
      updateResearchParam('category', categoryButton.dataset.researchFilter ?? 'all');
    } else if (archiveButton) {
      updateResearchParam('archive', archiveButton.dataset.researchArchiveFilter ?? 'all');
    } else if (resetButton) {
      const url = new URL(location.href);
      url.searchParams.delete('category');
      url.searchParams.delete('archive');
      history.pushState({}, '', url);
      applyResearchFilters();
    }
  });

  addEventListener('popstate', applyResearchFilters);
  applyResearchFilters();
</script>

<style>
  .portal {
    display: grid;
    grid-template-columns: minmax(180px, 0.23fr) minmax(0, 1fr) minmax(210px, 0.25fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
    padding-block: clamp(4.5rem, 8vw, 7.5rem);
  }

  .portal-featured {
    grid-column: 1;
  }

  .portal-main {
    min-width: 0;
    grid-column: 2;
  }

  .portal-filters {
    min-width: 0;
    grid-column: 3;
  }

  .portal-sticky {
    position: sticky;
    top: 7.5rem;
  }

  .portal-label {
    margin: 0;
    color: var(--accent-hover);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .portal-featured h2,
  .portal-main__header h2 {
    margin: 0.5rem 0 0;
    font-size: clamp(1.55rem, 2.5vw, 2rem);
  }

  .portal-featured nav {
    display: grid;
    margin-top: 1.35rem;
    border-top: 1px solid var(--border);
  }

  .portal-featured nav a {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.35rem 0.7rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .portal-featured nav a:hover strong {
    color: var(--accent-hover);
  }

  .portal-featured nav span {
    grid-row: 1 / 3;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .portal-featured nav strong {
    font-size: 0.82rem;
    line-height: 1.5;
    transition: color 220ms ease;
  }

  .portal-featured nav small {
    color: var(--text-muted);
    font-size: 0.65rem;
  }

  .portal-note {
    margin: 1rem 0 0;
    color: var(--text-muted);
    font-size: 0.68rem;
    line-height: 1.65;
  }

  .portal-main__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid var(--border-strong);
  }

  .portal-main__header > span {
    flex: 0 0 auto;
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .portal-main__header > span strong {
    color: var(--accent-hover);
  }

  .research-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    align-items: stretch;
  }

  .research-grid > div {
    min-width: 0;
  }

  [data-research-item][hidden] {
    display: none;
  }

  .portal-filters summary {
    display: none;
  }

  .portal-filters__content {
    display: grid;
    gap: 2rem;
  }

  .filter-group {
    display: grid;
    gap: 0.75rem;
  }

  .filter-group h2 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.8rem;
  }

  .filter-group > div {
    display: grid;
    gap: 0.15rem;
  }

  .filter-group button {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0.7rem;
    border: 0;
    border-radius: 9px;
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    font-size: 0.75rem;
    text-align: left;
  }

  .filter-group button:hover,
  .filter-group button[aria-pressed='true'] {
    background: var(--accent-soft);
    color: var(--accent-hover);
  }

  .filter-group small {
    color: var(--text-muted);
    font-size: 0.66rem;
  }

  .portal-empty {
    padding: clamp(3rem, 7vw, 6rem) 1rem;
    text-align: center;
  }

  .portal-empty[hidden] {
    display: none;
  }

  .portal-empty h3 {
    margin: 0;
    font-size: clamp(1.7rem, 4vw, 2.5rem);
  }

  .portal-empty p {
    margin: 0.8rem 0 1.5rem;
    color: var(--text-secondary);
  }

  @media (max-width: 1100px) {
    .portal {
      grid-template-columns: 1fr;
      grid-template-areas:
        'featured'
        'filters'
        'main';
    }

    .portal-featured {
      grid-area: featured;
    }

    .portal-main {
      grid-area: main;
    }

    .portal-filters {
      grid-area: filters;
    }

    .portal-sticky {
      position: static;
    }

    .portal-featured nav {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.75rem;
      border: 0;
    }

    .portal-featured nav a {
      padding: 1rem;
      border: 1px solid var(--border);
      border-radius: 12px;
    }

    .portal-filters {
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: var(--surface-warm);
    }

    .portal-filters summary {
      display: flex;
      min-height: 52px;
      align-items: center;
      justify-content: space-between;
      padding: 0.75rem 1rem;
      color: var(--text-primary);
      cursor: pointer;
      font-size: 0.84rem;
      font-weight: 600;
      list-style: none;
    }

    .portal-filters summary::-webkit-details-marker {
      display: none;
    }

    .portal-filters:not([open]) .portal-filters__content {
      display: none;
    }

    .portal-filters__content {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding: 1rem;
      border-top: 1px solid var(--border);
    }
  }

  @media (max-width: 700px) {
    .portal {
      gap: 2rem;
      padding-block: 3.5rem 4.5rem;
    }

    .portal-featured nav,
    .research-grid,
    .portal-filters__content {
      grid-template-columns: 1fr;
    }
  }
</style>
