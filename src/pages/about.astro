---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { getEntry, render } from 'astro:content';
import InfoCard from '../components/InfoCard.astro';
import InnerPageHero from '../components/InnerPageHero.astro';
import { abilities, productWorkflow, siteConfig } from '../config/site';
import { profileVisual } from '../config/visualAssets';
import BaseLayout from '../layouts/BaseLayout.astro';

const about = await getEntry('spec', 'about');
if (!about) throw new Error('Missing src/content/spec/about.md');
const { Content } = await render(about);
const hasImage = existsSync(join(process.cwd(), 'public', profileVisual.image.replace(/^\//, '')));
const abilityLabels = ['问题定义', '工作流设计', '原型验证', '评测回路'];
---

<BaseLayout title="关于赵天琦｜游戏 AI 与 AI 产品实践" description={about.data.description}>
  <InnerPageHero
    eyebrow="关于赵天琦"
    title="从复杂系统出发，走向游戏 AI 产品。"
    description="交通工程让我理解参与者、约束、路径和反馈；AI 实践让我把这些方法转化为需求判断、快速原型与可验证的产品迭代。"
  />

  <section class="about-page page-shell">
    <aside class="about-profile reveal">
      <figure>
        {
          hasImage ? (
            <img
              src={profileVisual.image}
              width={profileVisual.width}
              height={profileVisual.height}
              alt={profileVisual.alt}
              loading="lazy"
              decoding="async"
            />
          ) : (
            <span aria-hidden="true">TZ</span>
          )
        }
        <figcaption>个人品牌插图</figcaption>
      </figure>
      <div>
        <h2>{siteConfig.name}</h2>
        <p>游戏 AI 产品经理方向</p>
        <dl>
          <div><dt>方向</dt><dd>游戏 AI 产品 / AI 应用产品 / AI Agent</dd></div>
          <div><dt>状态</dt><dd>{siteConfig.availability}</dd></div>
          <div><dt>背景</dt><dd>{siteConfig.school} · {siteConfig.major}</dd></div>
        </dl>
        <nav aria-label="关于页快捷入口">
          <a href="/projects/">项目</a>
          <a href="/insights/">随笔与研究</a>
          <a href="/resume/">简历</a>
          <a href={siteConfig.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        </nav>
      </div>
    </aside>

    <article class="about-content prose reveal"><Content /></article>
  </section>

  <section class="about-method page-shell" aria-labelledby="about-method-title">
    <header class="reveal">
      <p>工作方式</p>
      <h2 id="about-method-title">四项能力，落在同一条七步验证路径上</h2>
    </header>
    <div class="about-method__layout">
      <div class="about-method__abilities" data-reveal-group>
        {
          abilities.map((ability, index) => (
            <InfoCard
              label={abilityLabels[index]}
              title={ability.title}
              description={ability.description}
            />
          ))
        }
      </div>
      <ol class="reveal">
        {
          productWorkflow.map((step, index) => (
            <li>
              <>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <strong>{step}</strong>
              </>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .about-page {
    display: grid;
    grid-template-columns: minmax(250px, 0.55fr) minmax(0, 1.25fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: start;
    padding-block: clamp(4.5rem, 8vw, 7.5rem);
  }

  .about-profile {
    position: sticky;
    top: 7rem;
  }

  .about-profile figure {
    margin: 0;
  }

  .about-profile figure > :is(img, span) {
    display: grid;
    width: 100%;
    aspect-ratio: 4 / 3;
    place-items: center;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--accent-soft);
    color: var(--accent-hover);
    object-fit: cover;
    filter: saturate(0.78) brightness(1.03);
    box-shadow: var(--shadow-sm);
  }

  .about-profile figcaption {
    margin-top: 0.55rem;
    color: var(--text-muted);
    font-size: 0.7rem;
  }

  .about-profile h2 {
    margin: 1.5rem 0 0.2rem;
    font-size: 1.5rem;
  }

  .about-profile > div > p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.82rem;
  }

  .about-profile dl {
    margin: 1.5rem 0;
    border-top: 1px solid var(--border);
  }

  .about-profile dl div {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 0.75rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--border);
  }

  .about-profile dt {
    color: var(--text-muted);
    font-size: 0.72rem;
  }

  .about-profile dd {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.78rem;
    line-height: 1.65;
  }

  .about-profile nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    color: var(--primary-strong);
    font-size: 0.78rem;
    font-weight: 600;
  }

  .about-content {
    width: min(100%, var(--reading));
  }

  .about-content :global(h2) {
    margin: 4.5rem 0 1.1rem;
    font-size: clamp(1.8rem, 3.5vw, 2.9rem);
    letter-spacing: -0.018em;
    line-height: 1.2;
  }

  .about-content :global(h2:first-child) {
    margin-top: 0;
  }

  .about-content :global(p),
  .about-content :global(li) {
    color: var(--text-secondary);
  }

  .about-content :global(blockquote) {
    margin: 2rem 0;
    padding: 1.3rem;
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
  }

  .about-content :global(blockquote p) {
    margin: 0;
    color: var(--text-main);
  }

  .about-method {
    padding-block: clamp(4.5rem, 8vw, 7.5rem);
    border-top: 1px solid var(--border-strong);
  }

  .about-method header p {
    margin: 0 0 0.6rem;
    color: var(--accent-hover);
    font-size: 0.84rem;
    font-weight: 600;
  }

  .about-method header h2 {
    max-width: 18ch;
    margin: 0;
    font-size: clamp(2.3rem, 4vw, 3rem);
    letter-spacing: -0.018em;
    line-height: 1.18;
  }

  .about-method__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.55fr);
    gap: clamp(3rem, 8vw, 8rem);
    margin-top: 3rem;
  }

  .about-method__abilities {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem;
  }

  .about-method ol {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
    list-style: none;
  }

  .about-method li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 0.8rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--border);
  }

  .about-method li span {
    color: var(--text-muted);
    font-size: 0.76rem;
  }

  @media (max-width: 900px) {
    .about-page,
    .about-method__layout {
      grid-template-columns: 1fr;
    }

    .about-profile {
      position: static;
      display: grid;
      grid-template-columns: minmax(220px, 0.6fr) minmax(0, 1fr);
      gap: 2rem;
    }
  }

  @media (max-width: 620px) {
    .about-profile,
    .about-method__abilities {
      grid-template-columns: 1fr;
    }
  }
</style>
