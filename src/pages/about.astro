---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { getEntry, render } from 'astro:content';
import InnerPageHero from '../components/InnerPageHero.astro';
import { abilities, siteConfig } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const about = await getEntry('spec', 'about');
if (!about) throw new Error('Missing src/content/spec/about.md');
const { Content } = await render(about);
const hasImage = existsSync(join(process.cwd(), 'public/assets/images/about.webp'));
---

<BaseLayout title="关于赵天琦｜游戏 AI 与 AI 产品实践" description={about.data.description}>
  <InnerPageHero eyebrow="ABOUT / TIANQI.Z" title="从复杂系统出发，走向游戏 AI 产品" description="交通工程让我理解系统、数据与流程；AI 实践让我把这些方法转化为需求判断、快速原型和可验证的产品迭代。" />
  <section class="about-page section page-shell">
    <aside class="about-profile panel">
      <div class="about-profile__image">
        {hasImage ? <img src="/assets/images/about.webp" width="1600" height="1000" alt="原创成年女性研究者在窗边整理产品笔记的插画" loading="lazy" decoding="async" /> : <span aria-hidden="true">◇</span>}
      </div>
      <h2>{siteConfig.name}</h2>
      <p>AI Product Explorer</p>
      <dl><div><dt>当前方向</dt><dd>游戏 AI 产品 / AI 应用产品 / AI Agent</dd></div><div><dt>当前状态</dt><dd>{siteConfig.availability}</dd></div><div><dt>个人签名</dt><dd>{siteConfig.signature}</dd></div></dl>
      <div class="about-profile__links"><a href="/projects/">查看项目</a><a href={siteConfig.github} target="_blank" rel="noreferrer">GitHub ↗</a><a href="/resume/">在线简历</a></div>
    </aside>
    <article class="about-content panel prose"><Content /></article>
    <section class="about-method panel"><header><span class="eyebrow">PRODUCT METHOD</span><h2>从需求拆解到评测迭代</h2></header><div>{abilities.map((ability) => <article><span>{ability.index}</span><h3>{ability.title}</h3><p>{ability.description}</p></article>)}</div></section>
  </section>
</BaseLayout>

<style>
  .about-page { display: grid; grid-template-columns: minmax(230px, .68fr) minmax(0, 2fr); gap: 1rem; align-items: start; }
  .about-profile { position: sticky; top: 96px; padding: 1.2rem; }
  .about-profile__image { display: grid; aspect-ratio: 4 / 3; place-items: center; overflow: hidden; border-radius: 16px; background: linear-gradient(145deg, var(--primary-soft), #f2dce5); color: var(--violet); font-size: 2rem; }
  .about-profile__image img { width: 100%; height: 100%; object-fit: cover; }
  .about-profile h2 { margin: 1.2rem 0 .25rem; font-size: 1.4rem; }
  .about-profile > p { margin: 0; color: var(--text-secondary); font-size: .78rem; }
  .about-profile dl { margin: 1rem 0; }
  .about-profile dl div { padding: .8rem 0; border-top: 1px solid var(--border); }
  .about-profile dt { color: var(--text-muted); font-size: .62rem; }
  .about-profile dd { margin: .3rem 0 0; font-size: .75rem; line-height: 1.65; }
  .about-profile__links { display: grid; gap: .5rem; }
  .about-profile__links a { padding: .65rem; border: 1px solid var(--border); border-radius: 11px; color: var(--primary-strong); font-size: .72rem; text-align: center; }
  .about-content { padding: clamp(1.6rem, 5vw, 4rem); }
  .about-content :global(h2) { margin: 3.4rem 0 1.2rem; padding-top: 1rem; border-top: 1px solid var(--border); font-size: clamp(1.55rem, 3.5vw, 2.6rem); letter-spacing: -.04em; }
  .about-content :global(h2:first-child) { margin-top: 0; padding-top: 0; border-top: 0; }
  .about-content :global(p), .about-content :global(li) { color: var(--text-secondary); line-height: 1.95; }
  .about-content :global(blockquote) { margin: 1.5rem 0; padding: 1rem 1.2rem; border-left: 4px solid var(--primary); border-radius: 0 13px 13px 0; background: var(--primary-soft); }
  .about-content :global(blockquote p) { margin: 0; color: var(--text-main); }
  .about-method { grid-column: 1 / -1; padding: clamp(1.5rem, 4vw, 2.8rem); }
  .about-method header h2 { margin: .55rem 0 1.5rem; font-size: clamp(1.8rem, 4vw, 3.7rem); letter-spacing: -.055em; }
  .about-method > div { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--border); }
  .about-method article { padding: 1.4rem; background: var(--surface-solid); }
  .about-method article > span { color: var(--primary); font-family: var(--font-mono); font-size: .7rem; }
  .about-method h3 { margin: 1.6rem 0 .7rem; }
  .about-method p { margin: 0; color: var(--text-secondary); font-size: .76rem; line-height: 1.75; }
  @media (max-width: 900px) { .about-page { grid-template-columns: 1fr; } .about-profile { position: static; } .about-method { grid-column: 1; } .about-method > div { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .about-method > div { grid-template-columns: 1fr; } }
</style>
