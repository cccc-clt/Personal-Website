---
import { getCollection } from 'astro:content';
import InsightDetail from '../../components/InsightDetail.astro';

export async function getStaticPaths() {
  const articles = (await getCollection('research')).filter(
    (entry) => entry.data.status === 'published' && entry.data.section === 'notes',
  );
  return articles.map((article) => ({
    params: { slug: article.data.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
---

<InsightDetail article={article} />
