---
import { getCollection } from 'astro:content';
import NoteFilters from '../../components/NoteFilters.astro';
import NoteTimelineCard from '../../components/NoteTimelineCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortInsightsByDate } from '../../utils/content';

const notes = (await getCollection('research'))
  .filter((entry) => entry.data.status === 'published' && entry.data.section === 'notes')
  .sort(sortInsightsByDate);
---

<BaseLayout
  title="随笔 | 赵天琦｜游戏 AI 产品作品集"
  description="记录游戏比赛、个人游玩体验、Game Jam 开发过程与阶段性成长。"
  canonicalPath="/notes/"
  pagefindIgnore={notes.length === 0}
  pageClass="notes-page"
>
  <div class="notes-shell page-shell">
    <header class="notes-intro reveal">
      <p class="notes-intro__label">Notes</p>
      <h1>随笔</h1>
      <p class="notes-intro__description">
        记录游戏比赛、游玩体验与成长过程，也保留那些尚未形成正式研究结论的真实观察。
      </p>
      <p class="notes-intro__count" aria-live="polite">
        共 <strong data-note-count>{notes.length}</strong> 篇记录
      </p>
    </header>

    <section class="notes-content" aria-label="随笔内容">
      {
        notes.length > 0 ? (
          <>
            <div class="notes-content__filters reveal">
              <NoteFilters notes={notes} />
            </div>

            <ol class="notes-timeline" data-note-list data-reveal-group>
              {notes.map((article) => (
                <li data-note-item data-note-kind={article.data.kind}>
                  <NoteTimelineCard article={article} />
                </li>
              ))}
            </ol>

            <div class="notes-filtered-empty" data-note-filtered-empty hidden>
              <h2>这个类型下还没有内容</h2>
              <p>可以切换到“全部”，继续浏览已经发布的随笔。</p>
            </div>
          </>
        ) : (
          <div class="notes-timeline notes-timeline--empty">
            <section
              class="notes-empty reveal"
              aria-labelledby="notes-empty-title"
              data-pagefind-ignore
            >
              <h2 id="notes-empty-title">第一批随笔正在整理中</h2>
              <p>
                这里将记录游戏比赛、个人游戏体验与阶段性成长。完成后的文章会按时间顺序出现在这里。
              </p>
              <ul aria-label="随笔栏目方向">
                <li>比赛记录</li>
                <li>游戏记录</li>
                <li>成长随记</li>
              </ul>
            </section>
          </div>
        )
      }
    </section>
  </div>
</BaseLayout>

<script>
  const getValidNoteKinds = () =>
    [...document.querySelectorAll<HTMLButtonElement>('[data-note-kind-filter]')].map(
      (button) => button.dataset.noteKindFilter,
    );

  const normalizedNoteKind = () => {
    const requested = new URL(location.href).searchParams.get('type') ?? 'all';
    return getValidNoteKinds().includes(requested) ? requested : 'all';
  };

  const applyNoteFilter = () => {
    const items = document.querySelectorAll<HTMLElement>('[data-note-item]');
    if (!items.length) return;
    const kind = normalizedNoteKind();
    let visible = 0;

    items.forEach((item) => {
      const matches = kind === 'all' || item.dataset.noteKind === kind;
      item.hidden = !matches;
      if (matches) visible += 1;
    });

    document.querySelectorAll<HTMLButtonElement>('[data-note-kind-filter]').forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.noteKindFilter === kind));
    });

    const count = document.querySelector<HTMLElement>('[data-note-count]');
    if (count) count.textContent = String(visible);
    const empty = document.querySelector<HTMLElement>('[data-note-filtered-empty]');
    if (empty) empty.hidden = visible > 0;
  };

  const updateNoteKind = (kind: string) => {
    const url = new URL(location.href);
    if (kind === 'all') url.searchParams.delete('type');
    else url.searchParams.set('type', kind);
    history.pushState({}, '', url);
    applyNoteFilter();
  };

  document.addEventListener('click', (event) => {
    if (!document.querySelector('[data-note-list]')) return;
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
      '[data-note-kind-filter]',
    );
    if (!button) return;
    const selected = button.dataset.noteKindFilter ?? 'all';
    const current = normalizedNoteKind();
    updateNoteKind(current === selected ? 'all' : selected);
  });

  addEventListener('popstate', applyNoteFilter);
  document.addEventListener('site:page-view', applyNoteFilter);
  applyNoteFilter();
</script>

<style>
  :global(body.notes-page main) {
    background: var(--surface-warm);
  }

  .notes-shell {
    min-height: 72vh;
    padding-block: clamp(5.75rem, 8vw, 7.25rem) clamp(5rem, 9vw, 8rem);
  }

  .notes-intro {
    max-width: 780px;
    margin-inline: auto;
    padding-bottom: clamp(1.5rem, 2.5vw, 2rem);
    border-bottom: 1px solid var(--border-strong);
    text-align: center;
  }

  .notes-intro__label {
    margin: 0 0 0.5rem;
    color: var(--accent-hover);
    font-size: 0.8rem;
    font-weight: 650;
    letter-spacing: 0.08em;
  }

  .notes-intro h1 {
    margin: 0;
    font-family: 'Songti SC', 'STSong', 'Noto Serif SC', 'Source Han Serif SC', serif;
    font-size: clamp(3rem, 6vw, 5rem);
    letter-spacing: -0.025em;
    line-height: 1.05;
    text-wrap: balance;
  }

  .notes-intro__description {
    max-width: 40ch;
    margin: 0.9rem auto 0;
    color: var(--text-secondary);
    font-size: clamp(0.98rem, 1.5vw, 1.08rem);
    line-height: 1.75;
    text-wrap: pretty;
  }

  .notes-intro__count {
    margin: 0.75rem auto 0;
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.5;
  }

  .notes-intro__count strong {
    color: var(--accent-hover);
    font-weight: 750;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
  }

  .notes-content {
    margin-top: clamp(1.5rem, 2.5vw, 2rem);
  }

  .notes-content__filters {
    max-width: 1080px;
    margin-inline: auto;
    margin-bottom: clamp(2rem, 3.5vw, 3rem);
  }

  .notes-timeline {
    position: relative;
    display: grid;
    max-width: 1080px;
    gap: clamp(2rem, 4vw, 3rem);
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .notes-timeline[data-note-list]::before {
    position: absolute;
    top: 2.35rem;
    bottom: 2.35rem;
    left: 1.24rem;
    width: 1px;
    background: var(--border-strong);
    content: '';
  }

  .notes-timeline > li {
    min-width: 0;
  }

  [data-note-item][hidden],
  .notes-filtered-empty[hidden] {
    display: none;
  }

  .notes-filtered-empty,
  .notes-empty {
    max-width: 900px;
    padding: clamp(2rem, 5vw, 3.25rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-solid);
  }

  .notes-filtered-empty {
    margin: 3rem auto 0;
    text-align: center;
  }

  .notes-empty {
    margin-left: 2.5rem;
  }

  .notes-filtered-empty h2,
  .notes-empty h2 {
    margin: 0;
    font-family: 'Songti SC', 'STSong', 'Noto Serif SC', 'Source Han Serif SC', serif;
    font-size: clamp(1.7rem, 4vw, 2.5rem);
    letter-spacing: -0.018em;
    line-height: 1.3;
  }

  .notes-filtered-empty p,
  .notes-empty > p {
    max-width: 58ch;
    margin: 0.9rem 0 0;
    color: var(--text-secondary);
    line-height: 1.8;
    text-wrap: pretty;
  }

  .notes-empty ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .notes-empty li {
    padding: 0.4rem 0.68rem;
    border-radius: var(--radius-pill);
    background: var(--surface-soft);
    color: var(--text-secondary);
    font-size: 0.72rem;
  }

  @media (max-width: 768px) {
    .notes-shell {
      padding-block: 5.5rem 4.5rem;
    }

    .notes-intro h1 {
      font-size: clamp(2.8rem, 14vw, 4rem);
    }

    .notes-intro__description {
      max-width: 38ch;
      margin-top: 0.8rem;
      line-height: 1.7;
    }

    .notes-intro__count {
      margin-top: 0.7rem;
    }

    .notes-timeline[data-note-list]::before {
      top: 2rem;
      bottom: 2rem;
      left: 0.64rem;
    }

    .notes-empty {
      margin-left: 0;
    }
  }

  @media (max-width: 390px) {
    .notes-empty {
      padding-inline: 1.25rem;
    }
  }
</style>
