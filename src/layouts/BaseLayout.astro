---
import FloatingControls from '../components/FloatingControls.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import { siteConfig } from '../config/site';
import '@fontsource-variable/noto-sans-sc/wght.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  pageClass?: string;
  pageType?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = '/images/og/og-general.webp',
  noindex = false,
  pageClass = '',
  pageType = 'website',
  publishedTime,
  modifiedTime,
  structuredData = [],
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const socialImage = Astro.site ? new URL(image, Astro.site) : undefined;
const extraStructuredData = Array.isArray(structuredData) ? structuredData : [structuredData];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': Astro.site ? new URL('/#person', Astro.site).toString() : '#person',
      name: siteConfig.name,
      alternateName: siteConfig.englishName,
      ...(Astro.site ? { url: Astro.site.toString() } : {}),
      jobTitle: 'AI 产品实践者',
      affiliation: { '@type': 'CollegeOrUniversity', name: siteConfig.school },
      sameAs: [siteConfig.github],
      knowsAbout: ['游戏 AI', 'AI Agent', 'RAG', 'Prompt Engineering', 'AI 产品评测'],
    },
    {
      '@type': 'WebSite',
      '@id': Astro.site ? new URL('/#website', Astro.site).toString() : '#website',
      name: siteConfig.siteName,
      description: siteConfig.description,
      inLanguage: 'zh-CN',
      ...(Astro.site ? { url: Astro.site.toString() } : {}),
    },
    ...extraStructuredData,
  ],
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f7f4ef" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {
      Astro.site && (
        <link
          rel="alternate"
          type="application/rss+xml"
          title={siteConfig.siteName}
          href="/rss.xml"
        />
      )
    }
    <meta property="og:type" content={pageType} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={siteConfig.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    {
      publishedTime && (
        <meta property="article:published_time" content={publishedTime.toISOString()} />
      )
    }
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <title>{title}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme');
        document.documentElement.dataset.theme = saved === 'dark' ? 'dark' : 'light';
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('reveal-ready');
        }
      })();
    </script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class={pageClass}>
    <div id="swup-container" class="transition-swup-fade">
      <a class="skip-link" href="#main-content">跳到主要内容</a>
      <Header />
      <main id="main-content" data-pagefind-body>
        <slot />
      </main>
      <Footer />
      <SearchOverlay />
      <FloatingControls />
    </div>

    <script>
      interface PagefindData {
        url: string;
        excerpt?: string;
        meta?: { title?: string };
      }

      interface PagefindResult {
        data: () => Promise<PagefindData>;
      }

      interface PagefindModule {
        init: () => Promise<void>;
        search: (query: string) => Promise<{ results: PagefindResult[] }>;
      }

      interface SwupInstance {
        hooks: { on: (event: 'page:view', handler: () => void) => void };
      }

      const browserWindow = window as typeof window & { swup?: SwupInstance };
      const getMenu = () => document.querySelector<HTMLElement>('[data-mobile-menu]');
      const getMenuButton = () => document.querySelector<HTMLButtonElement>('[data-menu-button]');
      const getSearch = () => document.querySelector<HTMLDialogElement>('[data-search-dialog]');

      const setMenu = (open: boolean, restore = false) => {
        const menu = getMenu();
        const button = getMenuButton();
        button?.setAttribute('aria-expanded', String(open));
        button?.setAttribute('aria-label', open ? '关闭导航' : '打开导航');
        menu?.setAttribute('aria-hidden', String(!open));
        document.body.classList.toggle('nav-open', open);
        if (open) menu?.querySelector<HTMLElement>('a')?.focus();
        if (!open && restore) button?.focus();
      };

      const closeSearch = (restore = false) => {
        const dialog = getSearch();
        if (dialog?.open) dialog.close();
        if (restore) document.querySelector<HTMLButtonElement>('[data-search-open]')?.focus();
      };

      document.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        if (target.closest('[data-menu-button]')) {
          const open = getMenuButton()?.getAttribute('aria-expanded') !== 'true';
          setMenu(open, !open);
        }
        if (target.closest('[data-mobile-menu] a')) setMenu(false);
        if (target.closest('[data-theme-toggle]')) {
          const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          localStorage.setItem('theme', next);
        }
        if (target.closest('[data-search-open]')) {
          setMenu(false);
          const dialog = getSearch();
          dialog?.showModal();
          dialog?.querySelector<HTMLInputElement>('input')?.focus();
        }
        if (target.closest('[data-search-close]')) closeSearch(true);
        if (target.closest('[data-back-to-top]')) {
          const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
        }
      });

      document.addEventListener('submit', (event) => {
        const form = (event.target as HTMLElement).closest<HTMLFormElement>(
          '[data-archive-search-form]',
        );
        if (!form) return;
        event.preventDefault();
        const query = form.querySelector<HTMLInputElement>('[data-archive-search-input]')?.value;
        const dialog = getSearch();
        const input = dialog?.querySelector<HTMLInputElement>('[data-pagefind-input]');
        if (!dialog || !input) return;
        setMenu(false);
        dialog.showModal();
        input.value = query?.trim() ?? '';
        input.focus();
        input.dispatchEvent(new Event('input', { bubbles: true }));
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        if (getMenuButton()?.getAttribute('aria-expanded') === 'true') setMenu(false, true);
        else if (getSearch()?.open) closeSearch(true);
      });

      document.addEventListener('input', async (event) => {
        const input = (event.target as HTMLElement).closest<HTMLInputElement>(
          '[data-pagefind-input]',
        );
        if (!input) return;
        const results = document.querySelector<HTMLElement>('[data-pagefind-results]');
        const query = input.value.trim();
        if (!results) return;
        if (!query) {
          results.innerHTML = '<p class="search-empty">输入关键词搜索项目、随笔与研究及页面。</p>';
          return;
        }
        results.innerHTML = '<p class="search-empty">正在搜索…</p>';
        try {
          const pagefindUrl = '/pagefind/pagefind.js';
          const pagefind = (await import(/* @vite-ignore */ pagefindUrl)) as PagefindModule;
          await pagefind.init();
          const search = await pagefind.search(query);
          const items = await Promise.all(search.results.slice(0, 8).map((item) => item.data()));
          results.innerHTML = items.length
            ? items
                .map(
                  (item) =>
                    `<a class="search-result" href="${item.url}"><strong>${item.meta?.title ?? '未命名页面'}</strong><span>${item.excerpt ?? ''}</span></a>`,
                )
                .join('')
            : '<p class="search-empty">没有找到相关内容。</p>';
        } catch {
          results.innerHTML =
            '<p class="search-empty">本地开发时搜索索引尚未生成；执行 npm run build 后即可使用。</p>';
        }
      });

      const updateChrome = () => {
        document.querySelector('[data-header]')?.classList.toggle('is-scrolled', scrollY > 18);
        const backToTop = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
        if (backToTop) backToTop.hidden = scrollY < Math.max(480, innerHeight * 0.72);
      };

      const syncPortalFilters = () => {
        const mode = matchMedia('(min-width: 1101px)').matches ? 'desktop' : 'compact';
        document
          .querySelectorAll<HTMLDetailsElement>('[data-portal-filters]')
          .forEach((details) => {
            if (details.dataset.portalMode === mode) return;
            details.open = mode === 'desktop';
            details.dataset.portalMode = mode;
          });
      };

      let revealObserver: IntersectionObserver | undefined;
      const setupReveals = () => {
        revealObserver?.disconnect();
        const reveals = [...document.querySelectorAll<HTMLElement>('.reveal')];
        if (!reveals.length) return;

        document.querySelectorAll<HTMLElement>('[data-reveal-group]').forEach((group) => {
          [...group.children].forEach((child, index) => {
            const item = child.matches('.reveal')
              ? (child as HTMLElement)
              : child.querySelector<HTMLElement>('.reveal');
            item?.style.setProperty('--reveal-delay', `${Math.min(index, 7) * 90}ms`);
          });
        });

        if (
          matchMedia('(prefers-reduced-motion: reduce)').matches ||
          !document.documentElement.classList.contains('reveal-ready')
        ) {
          reveals.forEach((item) => item.classList.add('is-visible'));
          return;
        }

        revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
        );

        reveals.forEach((item) => {
          if (item.getBoundingClientRect().top < innerHeight * 0.92) {
            item.classList.add('is-visible');
          } else {
            revealObserver?.observe(item);
          }
        });
      };

      const handlePageView = () => {
        setMenu(false);
        closeSearch();
        updateChrome();
        syncPortalFilters();
        setupReveals();
      };

      let hasSwupHook = false;
      const installSwupHook = () => {
        if (hasSwupHook || !browserWindow.swup) return;
        hasSwupHook = true;
        browserWindow.swup.hooks.on('page:view', handlePageView);
      };

      addEventListener('scroll', updateChrome, { passive: true });
      addEventListener('resize', syncPortalFilters, { passive: true });
      updateChrome();
      syncPortalFilters();
      setupReveals();
      if (browserWindow.swup) installSwupHook();
      else document.addEventListener('swup:enable', installSwupHook, { once: true });
    </script>
  </body>
</html>
