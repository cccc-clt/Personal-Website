---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config/site';
import type { TargetTrack } from '../types/project';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  track?: TargetTrack;
  image?: string;
  noindex?: boolean;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  track = 'general',
  image = '/images/og/og-general.webp',
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, siteConfig.url);
const socialImage = new URL(image, siteConfig.url);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteConfig.name,
  alternateName: siteConfig.englishName,
  url: siteConfig.url,
  jobTitle: 'AI 产品经理',
  sameAs: [siteConfig.github],
  knowsAbout: ['AI Agent', 'Game AI', 'RAG', 'Prompt Engineering', 'LLM Evaluation'],
};
---

<!doctype html>
<html lang="zh-CN" data-track={track}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f8faff" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={siteConfig.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
