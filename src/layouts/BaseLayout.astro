---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FloatingControls from '../components/FloatingControls.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import { siteConfig } from '../config/site';
import '@fontsource-variable/inter/standard.css';
import '@fontsource-variable/noto-sans-sc/wght.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  pageClass?: string;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = '/images/og/og-general.webp',
  noindex = false,
  pageClass = '',
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const socialImage = Astro.site ? new URL(image, Astro.site) : undefined;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteConfig.name,
  alternateName: siteConfig.englishName,
  ...(Astro.site ? { url: Astro.site.toString() } : {}),
  jobTitle: '游戏 AI 产品实践者',
  affiliation: { '@type': 'CollegeOrUniversity', name: siteConfig.school },
  sameAs: [siteConfig.github],
  knowsAbout: ['游戏 AI', 'AI Agent', 'RAG', 'Prompt Engineering', 'AI 产品评测'],
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#edf3f8" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {
      Astro.site && (
        <link
          rel="alternate"
          type="application/rss+xml"
          title={siteConfig.siteName}
          href="/rss.xml"
        />
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={siteConfig.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <title>{title}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme');
        const dark =
          saved === 'dark' || (!saved && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class={pageClass}>
    <div id="swup-container" class="transition-swup-fade">
      <a class="skip-link" href="#main-content">跳到主要内容</a>
      <Header />
      <main id="main-content" data-pagefind-body>
        <slot />
      </main>
      <Footer />
      <SearchOverlay />
      <FloatingControls />
    </div>

    <script>
      interface PagefindData {
        url: string;
        excerpt?: string;
        meta?: { title?: string };
      }

      interface PagefindResult {
        data: () => Promise<PagefindData>;
      }

      interface PagefindModule {
        init: () => Promise<void>;
        search: (query: string) => Promise<{ results: PagefindResult[] }>;
      }

      interface SwupHooks {
        on: (event: 'page:view', handler: () => void) => void;
      }

      interface SwupInstance {
        hooks: SwupHooks;
      }

      const browserWindow = window as typeof window & { swup?: SwupInstance };
      const getMenu = () => document.querySelector<HTMLElement>('[data-mobile-menu]');
      const getMenuButton = () => document.querySelector<HTMLButtonElement>('[data-menu-button]');
      const setMenu = (open: boolean, restore = false) => {
        const menu = getMenu();
        const button = getMenuButton();
        button?.setAttribute('aria-expanded', String(open));
        button?.setAttribute('aria-label', open ? '关闭导航' : '打开导航');
        menu?.setAttribute('aria-hidden', String(!open));
        document.body.classList.toggle('nav-open', open);
        if (open) menu?.querySelector<HTMLElement>('a')?.focus();
        if (!open && restore) button?.focus();
      };

      const getSearch = () => document.querySelector<HTMLDialogElement>('[data-search-dialog]');
      const closeSearch = (restore = false) => {
        const dialog = getSearch();
        if (dialog?.open) dialog.close();
        if (restore) document.querySelector<HTMLButtonElement>('[data-search-open]')?.focus();
      };

      document.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        if (target.closest('[data-menu-button]')) {
          const open = getMenuButton()?.getAttribute('aria-expanded') !== 'true';
          setMenu(open, !open);
        }
        if (target.closest('[data-mobile-menu] a')) setMenu(false);
        if (target.closest('[data-theme-toggle]')) {
          const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          localStorage.setItem('theme', next);
        }
        if (target.closest('[data-search-open]')) {
          if (getMenuButton()?.getAttribute('aria-expanded') === 'true') setMenu(false);
          const dialog = getSearch();
          dialog?.showModal();
          dialog?.querySelector<HTMLInputElement>('input')?.focus();
        }
        if (target.closest('[data-search-close]')) closeSearch(true);
        if (target.closest('[data-back-to-top]')) {
          const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
        }
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        if (getMenuButton()?.getAttribute('aria-expanded') === 'true') setMenu(false, true);
        else if (getSearch()?.open) closeSearch(true);
      });

      document.addEventListener('input', async (event) => {
        const input = (event.target as HTMLElement).closest<HTMLInputElement>(
          '[data-pagefind-input]',
        );
        if (!input) return;
        const results = document.querySelector<HTMLElement>('[data-pagefind-results]');
        const query = input.value.trim();
        if (!results) return;
        if (!query) {
          results.innerHTML = '<p class="search-empty">输入关键词搜索项目、随想与页面。</p>';
          return;
        }
        results.innerHTML = '<p class="search-empty">正在搜索…</p>';
        try {
          const pagefindUrl = '/pagefind/pagefind.js';
          const pagefind = (await import(/* @vite-ignore */ pagefindUrl)) as PagefindModule;
          await pagefind.init();
          const search = await pagefind.search(query);
          const items = await Promise.all(search.results.slice(0, 8).map((item) => item.data()));
          results.innerHTML = items.length
            ? items
                .map(
                  (item) =>
                    `<a class="search-result" href="${item.url}"><strong>${item.meta?.title ?? '未命名页面'}</strong><span>${item.excerpt ?? ''}</span></a>`,
                )
                .join('')
            : '<p class="search-empty">没有找到相关内容。</p>';
        } catch {
          results.innerHTML =
            '<p class="search-empty">本地开发时搜索索引尚未生成；执行 npm run build 后即可使用。</p>';
        }
      });

      const updateChrome = () => {
        document
          .querySelector('[data-header]')
          ?.classList.toggle('is-scrolled', window.scrollY > 24);
        const backToTop = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
        if (backToTop) {
          backToTop.hidden = window.scrollY < Math.max(480, window.innerHeight * 0.72);
        }
      };

      const heroSessionKey = 'tianqi-home-hero-seen-v1';
      let activeHero: HTMLElement | null = null;
      let heroController: AbortController | null = null;
      let heroFrame = 0;

      const setupHomeHero = () => {
        const hero = document.querySelector<HTMLElement>('[data-home-hero]');
        if (hero === activeHero && hero?.dataset.intro !== 'pending') return;

        heroController?.abort();
        if (heroFrame) cancelAnimationFrame(heroFrame);
        heroFrame = 0;
        activeHero = hero;
        if (!hero) return;

        const controller = new AbortController();
        const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const mobileLayout = matchMedia('(max-width: 900px)').matches;
        heroController = controller;

        let intro: 'full' | 'quick' | 'static' = 'static';
        if (!reduceMotion) {
          try {
            const hasSeenHero = sessionStorage.getItem(heroSessionKey) === 'true';
            intro = hasSeenHero ? 'quick' : 'full';
            if (!hasSeenHero) sessionStorage.setItem(heroSessionKey, 'true');
          } catch {
            intro = 'static';
          }
        }
        hero.dataset.intro = intro;

        if (reduceMotion || mobileLayout) {
          hero.style.setProperty('--hero-progress', '0');
          return;
        }

        const updateHeroProgress = () => {
          const travel = Math.max(hero.offsetHeight * 0.78, 1);
          const progress = Math.min(Math.max(window.scrollY / travel, 0), 1);
          hero.style.setProperty('--hero-progress', progress.toFixed(3));
          heroFrame = 0;
        };

        const requestHeroUpdate = () => {
          if (heroFrame) return;
          heroFrame = requestAnimationFrame(updateHeroProgress);
        };

        window.addEventListener('scroll', requestHeroUpdate, {
          passive: true,
          signal: controller.signal,
        });
        window.addEventListener('resize', requestHeroUpdate, {
          passive: true,
          signal: controller.signal,
        });
        controller.signal.addEventListener(
          'abort',
          () => {
            if (heroFrame) cancelAnimationFrame(heroFrame);
            heroFrame = 0;
          },
          { once: true },
        );
        updateHeroProgress();
      };

      let hasSwupHeroHook = false;
      const installSwupHeroHook = () => {
        if (hasSwupHeroHook || !browserWindow.swup) return;
        hasSwupHeroHook = true;
        browserWindow.swup.hooks.on('page:view', () => {
          setMenu(false);
          closeSearch();
          setupHomeHero();
          updateChrome();
        });
      };

      window.addEventListener('scroll', updateChrome, { passive: true });
      setupHomeHero();
      updateChrome();
      if (browserWindow.swup) installSwupHeroHook();
      else document.addEventListener('swup:enable', installSwupHeroHook, { once: true });
    </script>
  </body>
</html>
