---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import type { ProjectCoverKey } from '../config/visualAssets';
import ProjectCover from './ProjectCover.astro';

interface Props {
  images: string[];
  title: string;
  slug: string;
  index: string;
  cover?: ProjectCoverKey;
}

const { images, title, slug, index, cover } = Astro.props;
const availableImages = images.filter(
  (src) =>
    src.startsWith('/') &&
    !src.startsWith('//') &&
    existsSync(join(process.cwd(), 'public', src.replace(/^\//, ''))),
);
const dialogId = `gallery-${slug}`;
---

<div class="gallery">
  {
    availableImages.length > 0 ? (
      <div class="gallery__grid">
        {availableImages.map((src, imageIndex) => (
          <button
            class="gallery__item"
            type="button"
            data-gallery-open={dialogId}
            data-gallery-src={src}
            data-gallery-alt={`${title} 项目截图 ${imageIndex + 1}`}
            data-gallery-caption={`${title} · 图 ${String(imageIndex + 1).padStart(2, '0')}`}
          >
            <img
              src={src}
              alt={`${title} 项目截图 ${imageIndex + 1}`}
              width="1600"
              height="900"
              loading="lazy"
              decoding="async"
            />
            <span>放大查看</span>
          </button>
        ))}
      </div>
    ) : (
      <figure class="gallery__fallback">
        <ProjectCover slug={slug} title={title} index={index} cover={cover} />
        <figcaption>
          <strong>概念图 · 非运行截图</strong>
          真实项目截图尚未写入本地。本页不会用概念封面冒充产品运行界面。
        </figcaption>
      </figure>
    )
  }
</div>

{
  availableImages[0] && (
    <dialog
      class="gallery-dialog"
      id={dialogId}
      data-gallery-dialog
      aria-label={`${title} 图片预览`}
    >
      <button class="gallery-dialog__close" type="button" aria-label="关闭图片" data-gallery-close>
        ×
      </button>
      <figure>
        <img
          src={availableImages[0]}
          alt={`${title} 项目截图 1`}
          width="1600"
          height="900"
          data-gallery-image
        />
        <figcaption data-gallery-caption>{title} · 图 01</figcaption>
      </figure>
    </dialog>
  )
}

<script>
  let galleryTrigger: HTMLButtonElement | null = null;

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const openButton = target.closest<HTMLButtonElement>('[data-gallery-open]');
    if (openButton) {
      const dialog = document.getElementById(
        openButton.dataset.galleryOpen ?? '',
      ) as HTMLDialogElement | null;
      const image = dialog?.querySelector<HTMLImageElement>('[data-gallery-image]');
      const caption = dialog?.querySelector<HTMLElement>('[data-gallery-caption]');
      if (!dialog || !image || !openButton.dataset.gallerySrc) return;
      galleryTrigger = openButton;
      image.src = openButton.dataset.gallerySrc;
      image.alt = openButton.dataset.galleryAlt ?? '项目截图';
      if (caption) caption.textContent = openButton.dataset.galleryCaption ?? '';
      dialog.showModal();
      dialog.querySelector<HTMLButtonElement>('[data-gallery-close]')?.focus();
      return;
    }

    const closeButton = target.closest<HTMLButtonElement>('[data-gallery-close]');
    if (closeButton) closeButton.closest<HTMLDialogElement>('dialog')?.close();
    if (target.matches('[data-gallery-dialog]')) (target as HTMLDialogElement).close();
  });

  document.addEventListener(
    'close',
    (event) => {
      if ((event.target as HTMLElement).matches('[data-gallery-dialog]')) galleryTrigger?.focus();
    },
    true,
  );
</script>

<style>
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
  }

  .gallery__item {
    position: relative;
    min-height: 280px;
    overflow: hidden;
    padding: 0;
    border-radius: var(--radius-md);
    background: var(--surface-soft);
    cursor: zoom-in;
  }

  .gallery__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 300ms var(--ease-out);
  }

  .gallery__item:hover img {
    scale: 1.02;
  }

  .gallery__item > span {
    position: absolute;
    right: 0.8rem;
    bottom: 0.8rem;
    padding: 0.45rem 0.65rem;
    border-radius: 8px;
    background: rgba(18, 27, 36, 0.82);
    color: #fff;
    font-size: 0.7rem;
  }

  .gallery__fallback {
    margin: 0;
  }

  .gallery__fallback :global(.project-cover) {
    border-radius: var(--radius-md);
  }

  .gallery__fallback figcaption {
    display: grid;
    gap: 0.25rem;
    margin-top: 0.8rem;
    color: var(--text-muted);
    font-size: 0.74rem;
    line-height: 1.6;
  }

  .gallery__fallback strong {
    color: var(--text-main);
  }

  .gallery-dialog {
    width: min(1180px, calc(100vw - 32px));
    max-width: none;
    max-height: calc(100dvh - 32px);
    padding: 1rem;
    border: 0;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--surface-solid);
    color: var(--text-main);
  }

  .gallery-dialog::backdrop {
    background: rgba(8, 12, 17, 0.78);
    backdrop-filter: blur(6px);
  }

  .gallery-dialog figure {
    margin: 0;
  }

  .gallery-dialog img {
    width: 100%;
    max-height: calc(100dvh - 120px);
    object-fit: contain;
  }

  .gallery-dialog figcaption {
    padding: 0.7rem 0.2rem 0;
    color: var(--text-muted);
    font-size: 0.76rem;
  }

  .gallery-dialog__close {
    position: absolute;
    z-index: 2;
    top: 1.4rem;
    right: 1.4rem;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface-solid) 92%, transparent);
    color: var(--text-main);
    cursor: pointer;
    font-size: 1.4rem;
  }
</style>
