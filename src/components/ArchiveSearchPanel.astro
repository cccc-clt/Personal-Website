---
interface Props {
  label?: string;
  placeholder: string;
}

const { label = '站内搜索', placeholder } = Astro.props;
---

<form class="archive-search" data-archive-search-form role="search">
  <label for={`archive-search-${Astro.url.pathname.replaceAll('/', '-')}`}>{label}</label>
  <div>
    <input
      id={`archive-search-${Astro.url.pathname.replaceAll('/', '-')}`}
      type="search"
      name="query"
      placeholder={placeholder}
      autocomplete="off"
      data-archive-search-input
    />
    <button type="submit" aria-label="使用站内搜索查找">
      <span aria-hidden="true">⌕</span>
    </button>
  </div>
  <p>提交后将在 Pagefind 站内搜索中显示结果。</p>
</form>

<style>
  .archive-search {
    display: grid;
    gap: 0.65rem;
  }

  label {
    color: var(--text-primary);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .archive-search > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 44px;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    background: var(--surface-solid);
    transition: border-color 220ms ease;
  }

  .archive-search > div:focus-within {
    border-color: var(--accent);
  }

  input {
    min-width: 0;
    min-height: 44px;
    padding: 0.7rem 0 0.7rem 0.85rem;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text-primary);
    font-size: 0.78rem;
  }

  input::placeholder {
    color: var(--text-muted);
  }

  button {
    display: grid;
    min-width: 44px;
    min-height: 44px;
    place-items: center;
    border: 0;
    background: transparent;
    color: var(--accent-hover);
    cursor: pointer;
    font-size: 1.15rem;
  }

  button:hover {
    background: var(--accent-soft);
  }

  p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.68rem;
    line-height: 1.55;
  }
</style>
