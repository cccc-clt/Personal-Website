---
import type { CollectionEntry } from 'astro:content';
import { getInsightPath } from '../utils/content';

interface Props {
  previous?: CollectionEntry<'research'>;
  next?: CollectionEntry<'research'>;
  series?: boolean;
  pendingNextLabel?: string;
  pendingNextEyebrow?: string;
}

const { previous, next, series = false, pendingNextLabel, pendingNextEyebrow } = Astro.props;
---

{
  (previous || next || pendingNextLabel) && (
    <nav class="article-pager" aria-label="上一篇与下一篇" data-pagefind-ignore>
      {previous ? (
        <a href={getInsightPath(previous)}>
          <span>{series ? '系列上一篇' : '上一篇'}</span>
          <strong>{previous.data.title}</strong>
        </a>
      ) : (
        <span aria-hidden="true" />
      )}
      {next ? (
        <a class="article-pager__next" href={getInsightPath(next)}>
          <span>{series ? '系列下一篇' : '下一篇'}</span>
          <strong>{next.data.title}</strong>
        </a>
      ) : (
        pendingNextLabel && (
          <span class="article-pager__next article-pager__pending" aria-disabled="true">
            <span>{pendingNextEyebrow ?? '系列下一篇'}</span>
            <strong>{pendingNextLabel}</strong>
          </span>
        )
      )}
    </nav>
  )
}

<style>
  .article-pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-strong);
  }

  a {
    display: grid;
    gap: 0.42rem;
    min-width: 0;
    padding: 0.25rem 0;
  }

  .article-pager__pending {
    display: grid;
    gap: 0.42rem;
    min-width: 0;
    padding: 0.25rem 0;
  }

  a span,
  .article-pager__pending span {
    color: var(--text-muted);
    font-size: 0.72rem;
  }

  a strong,
  .article-pager__pending strong {
    color: var(--text-primary);
    font-size: 0.9rem;
    line-height: 1.55;
    text-wrap: pretty;
  }

  a:hover strong {
    color: var(--accent-hover);
  }

  .article-pager__pending strong {
    color: var(--text-muted);
    font-weight: 580;
  }

  .article-pager__next {
    text-align: right;
  }

  @media (max-width: 600px) {
    .article-pager {
      grid-template-columns: 1fr;
    }

    .article-pager__next {
      padding-top: 1rem;
      border-top: 1px solid var(--border);
      text-align: left;
    }
  }
</style>
