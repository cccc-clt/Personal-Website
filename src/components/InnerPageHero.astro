---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}
const { eyebrow, title, description } = Astro.props;
---

<header class="inner-hero">
  <div class="page-shell inner-hero__grid">
    <div>
      <span class="eyebrow">{eyebrow}</span>
      <h1>{title}</h1>
      <p>{description}</p>
      <slot />
    </div>
    <div class="inner-hero__art" aria-hidden="true"><i></i><i></i><i></i><span>◇</span></div>
  </div>
</header>

<style>
  .inner-hero { padding: 9.5rem 0 4.5rem; background: linear-gradient(145deg, color-mix(in srgb, var(--primary-soft) 80%, transparent), color-mix(in srgb, var(--pink) 22%, var(--page-bg))); }
  .inner-hero__grid { display: grid; grid-template-columns: minmax(0, 1fr) 240px; gap: 3rem; align-items: center; }
  h1 { max-width: 960px; margin: 0.8rem 0 1.2rem; font-size: clamp(2.5rem, 6vw, 6rem); letter-spacing: -0.065em; line-height: 1.06; text-wrap: balance; }
  p { max-width: 760px; margin: 0; color: var(--text-secondary); font-size: clamp(0.92rem, 1.4vw, 1.08rem); line-height: 1.85; }
  .inner-hero__art { position: relative; aspect-ratio: 1; border: 1px solid var(--border); border-radius: 42% 58% 55% 45%; background: radial-gradient(circle at 30% 30%, white, transparent 26%), linear-gradient(145deg, var(--primary), var(--violet) 62%, var(--pink)); opacity: 0.62; rotate: 7deg; }
  .inner-hero__art i { position: absolute; border: 1px solid rgba(255,255,255,.65); rotate: 45deg; }
  .inner-hero__art i:nth-child(1) { inset: 20%; }
  .inner-hero__art i:nth-child(2) { inset: 33%; }
  .inner-hero__art i:nth-child(3) { inset: 43%; }
  .inner-hero__art span { position: absolute; top: 50%; left: 50%; color: white; font-size: 2rem; translate: -50% -50%; }
  @media (max-width: 760px) { .inner-hero { padding: 7.5rem 0 3rem; } .inner-hero__grid { grid-template-columns: 1fr; } .inner-hero__art { display: none; } }
</style>
