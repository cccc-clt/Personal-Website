---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  code?: string;
}
const { eyebrow, title, description, code = 'PORTFOLIO_INDEX' } = Astro.props;
---

<section class="inner-hero">
  <div class="inner-hero-grid" aria-hidden="true"></div>
  <div class="shell inner-hero-content" data-reveal>
    <span class="eyebrow"><i aria-hidden="true"></i>{eyebrow}</span>
    <h1>{title}</h1>
    <p>{description}</p>
    <div class="inner-hero-code"><span>{code}</span><i></i><small>SYSTEM READY</small></div>
  </div>
</section>
