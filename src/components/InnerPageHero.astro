---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="inner-hero">
  <div class="page-shell inner-hero__grid">
    <span class="inner-hero__context">{eyebrow}</span>
    <div>
      <h1>{title}</h1>
      <p>{description}</p>
      <slot />
    </div>
  </div>
</header>

<style>
  .inner-hero {
    padding: clamp(8rem, 15vw, 12rem) 0 clamp(3.5rem, 7vw, 6.5rem);
    border-bottom: 1px solid var(--border);
  }

  .inner-hero__grid {
    display: grid;
    grid-template-columns: minmax(150px, 0.25fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 7rem);
    align-items: start;
  }

  .inner-hero__context {
    padding-top: 0.8rem;
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 620;
  }

  h1 {
    max-width: 18ch;
    margin: 0;
    font-size: clamp(2.65rem, 6vw, 5.8rem);
    letter-spacing: -0.035em;
    line-height: 1.08;
  }

  p {
    max-width: 66ch;
    margin: 1.4rem 0 0;
    color: var(--text-secondary);
    font-size: clamp(1rem, 1.45vw, 1.2rem);
    line-height: 1.82;
  }

  @media (max-width: 720px) {
    .inner-hero__grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .inner-hero__context {
      padding-top: 0;
    }
  }
</style>
