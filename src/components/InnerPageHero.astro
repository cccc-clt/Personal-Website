---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="inner-hero">
  <div class="page-shell inner-hero__content reveal">
    <span class="inner-hero__context">{eyebrow}</span>
    <h1>{title}</h1>
    <p>{description}</p>
    <slot />
  </div>
</header>

<style>
  .inner-hero {
    padding: clamp(8.5rem, 13vw, 10.5rem) 0 clamp(4.5rem, 7vw, 6.5rem);
    border-bottom: 1px solid var(--border);
  }

  .inner-hero__content {
    max-width: min(920px, var(--container));
  }

  .inner-hero__context {
    display: inline-flex;
    margin-bottom: 1rem;
    color: var(--accent-hover);
    font-size: 0.84rem;
    font-weight: 600;
  }

  h1 {
    max-width: 18ch;
    margin: 0;
    font-size: clamp(3.1rem, 5.8vw, 4.25rem);
    letter-spacing: -0.025em;
    line-height: 1.12;
  }

  p {
    max-width: 66ch;
    margin: 1.5rem 0 0;
    color: var(--text-secondary);
    font-size: clamp(1.03rem, 1.4vw, 1.18rem);
    line-height: 1.8;
  }

  @media (max-width: 700px) {
    .inner-hero {
      padding: 7.5rem 0 4rem;
    }

    h1 {
      font-size: clamp(2.6rem, 11vw, 3.5rem);
    }
  }
</style>
