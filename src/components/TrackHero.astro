---
import ImageWithFallback from './ImageWithFallback.astro';
import LabGuide from './LabGuide.astro';
import TrackSwitcher from './TrackSwitcher.astro';
import type { TrackConfig } from '../types/project';

interface Props {
  config: TrackConfig;
}

const { config } = Astro.props;
---

<section class="track-hero" style={`--track-accent:${config.accent}`}>
  <div class="track-hero__mist track-hero__mist--one"></div>
  <div class="track-hero__mist track-hero__mist--two"></div>
  <div class="container track-hero__scene">
    <div class="track-hero__copy">
      <span class="eyebrow" data-reveal>{config.eyebrow}</span>
      <p class="track-hero__name en" data-reveal>赵天琦 <span>Tianqi Zhao</span></p>
      <h1 class="display" data-reveal="2">{config.title}</h1>
      <p class="track-hero__role" data-reveal="2">{config.role}</p>
      <p class="lede" data-reveal="3">{config.description}</p>
      <div class="track-hero__tags" aria-label="专业关键词" data-reveal="3">
        {config.tags.map((tag) => <span>{tag}</span>)}
      </div>
      <div class="track-hero__actions" data-reveal="3">
        <a class="button button--primary" href="/projects"
          >查看精选项目 <span aria-hidden="true">↘</span></a
        >
        <a class="button" href="/resume">查看简历</a>
        <a class="button button--quiet" href="#contact">联系我 <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <div class="track-hero__visual" aria-label="Game AI 数字实验室场景" data-reveal="2">
      <div class="scene-arc scene-arc--one"></div>
      <div class="scene-arc scene-arc--two"></div>
      <ImageWithFallback
        class="track-hero__character"
        avif="/images/character/lab-guide-hero.avif"
        webp="/images/character/lab-guide-hero.webp"
        mobileAvif="/images/character/lab-guide-mobile.avif"
        mobileWebp="/images/character/lab-guide-mobile.webp"
        alt="原创成年女性 Game AI Lab Guide"
        width={1080}
        height={1320}
        priority
        fallbackLabel="CSS ORIGINAL LAB GUIDE"
      >
        <LabGuide slot="fallback" />
      </ImageWithFallback>
      <div class="lab-fragment lab-fragment--prompt">
        <span class="mono">PROMPT / 04</span>
        <strong>Intent → Constraint</strong>
      </div>
      <div class="lab-fragment lab-fragment--experiment">
        <span class="mono">EXPERIMENT</span>
        <strong>Evidence ready</strong>
        <i aria-hidden="true"></i>
      </div>
      <div class="lab-fragment lab-fragment--agent">
        <span class="mono">AGENT PATH</span>
        <b></b><b></b><b></b>
      </div>
    </div>

    <div class="track-hero__bottom">
      <dl>
        <div><dt>07</dt><dd>AI 项目实践</dd></div>
        <div><dt>04</dt><dd>定向求职视图</dd></div>
        <div><dt>E2E</dt><dd>需求到评测闭环</dd></div>
      </dl>
      <TrackSwitcher current={config.key} />
    </div>
  </div>
</section>

<style>
  .track-hero {
    position: relative;
    min-height: calc(100svh - 78px);
    overflow: hidden;
    padding: clamp(4.5rem, 8vw, 8rem) 0 2.5rem;
    background:
      linear-gradient(
        115deg,
        color-mix(in srgb, var(--track-accent) 5%, transparent),
        transparent 48%
      ),
      linear-gradient(180deg, rgba(255, 255, 255, 0.1), rgba(234, 241, 255, 0.3));
  }

  .track-hero::after {
    position: absolute;
    right: -9vw;
    bottom: -34vw;
    width: 78vw;
    height: 62vw;
    border: 1px solid color-mix(in srgb, var(--track-accent) 18%, transparent);
    border-radius: 50%;
    content: '';
    rotate: -11deg;
  }

  .track-hero__mist {
    position: absolute;
    border-radius: 50%;
    filter: blur(34px);
    pointer-events: none;
  }

  .track-hero__mist--one {
    top: 2%;
    right: 5%;
    width: 38vw;
    height: 38vw;
    background: color-mix(in srgb, var(--track-accent) 18%, white 82%);
    opacity: 0.55;
  }

  .track-hero__mist--two {
    bottom: 5%;
    left: -8%;
    width: 28vw;
    height: 18vw;
    background: var(--rose-mist);
    opacity: 0.32;
  }

  .track-hero__scene {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(390px, 0.92fr);
    gap: clamp(1rem, 2vw, 3rem);
    align-items: center;
  }

  .track-hero__copy {
    z-index: 3;
    padding-bottom: 2rem;
  }

  h1 {
    max-width: 820px;
    margin: 1.2rem 0 1.6rem;
    overflow-wrap: normal;
    white-space: pre-line;
    word-break: auto-phrase;
  }

  .track-hero__name {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin: 1.3rem 0 0;
    font-size: 1.08rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .track-hero__name span {
    color: var(--ink-500);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .track-hero__role {
    margin-bottom: 1.25rem;
    color: var(--track-accent);
    font-size: clamp(1.18rem, 1.8vw, 1.65rem);
    font-weight: 680;
  }

  .track-hero__copy .lede {
    max-width: 720px;
    margin-bottom: 1.5rem;
  }

  .track-hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .track-hero__tags span {
    padding: 0.45rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.28);
    color: var(--ink-650);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .track-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 2.1rem;
  }

  .track-hero__visual {
    position: relative;
    min-height: 640px;
    align-self: stretch;
  }

  .track-hero__character {
    position: absolute;
    z-index: 3;
    right: -3%;
    bottom: -3%;
    display: grid;
    width: min(600px, 44vw);
    min-height: 0;
    place-items: end center;
    overflow: visible;
    background: transparent;
  }

  .track-hero__character :global(img) {
    width: 100%;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 30px 40px rgba(75, 91, 153, 0.2));
  }

  .scene-arc {
    position: absolute;
    border: 1px solid color-mix(in srgb, var(--track-accent) 24%, transparent);
    border-radius: 50%;
  }

  .scene-arc--one {
    inset: 9% -6% 1% 1%;
    rotate: -13deg;
  }

  .scene-arc--two {
    inset: 22% 4% 15% 12%;
    border-style: dashed;
    rotate: 14deg;
  }

  .lab-fragment {
    position: absolute;
    z-index: 6;
    padding: 0.85rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.74);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.58);
    box-shadow: 0 18px 45px rgba(75, 92, 150, 0.14);
    backdrop-filter: blur(16px);
  }

  .lab-fragment span,
  .lab-fragment strong {
    display: block;
  }

  .lab-fragment span {
    margin-bottom: 0.35rem;
    color: var(--ink-500);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
  }

  .lab-fragment strong {
    font-size: 0.8rem;
  }

  .lab-fragment--prompt {
    top: 20%;
    left: 1%;
  }

  .lab-fragment--experiment {
    right: -1%;
    bottom: 17%;
  }

  .lab-fragment--experiment i {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--mint);
    box-shadow: 0 0 0 4px rgba(100, 216, 189, 0.18);
  }

  .lab-fragment--agent {
    top: 11%;
    right: 5%;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .lab-fragment--agent span {
    margin: 0 0.25rem 0 0;
  }

  .lab-fragment--agent b {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--track-accent) 75%, white);
  }

  .track-hero__bottom {
    grid-column: 1 / -1;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  dl {
    display: flex;
    gap: 3.5rem;
    margin: 0;
  }

  dl div {
    min-width: 120px;
  }

  dt {
    color: var(--track-accent);
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 700;
  }

  dd {
    margin: 0.45rem 0 0;
    color: var(--ink-500);
    font-size: 0.78rem;
  }

  @media (max-width: 1050px) {
    .track-hero__scene {
      grid-template-columns: minmax(0, 1fr) minmax(330px, 0.72fr);
    }

    .track-hero__visual {
      min-height: 560px;
    }
  }

  @media (max-width: 820px) {
    .track-hero {
      padding-top: 4rem;
    }

    .track-hero__scene {
      grid-template-columns: 1fr;
    }

    .track-hero__visual {
      min-height: min(650px, 125vw);
      order: 2;
    }

    .track-hero__character {
      right: 50%;
      bottom: -2%;
      width: min(560px, 95vw);
      transform: translateX(50%);
    }

    .track-hero__bottom {
      order: 3;
      align-items: stretch;
      flex-direction: column;
    }

    dl {
      justify-content: space-between;
      gap: 1rem;
    }

    dl div {
      min-width: 0;
    }
  }

  @media (max-width: 520px) {
    .track-hero__actions .button {
      flex: 1 1 44%;
    }

    .track-hero__actions .button--quiet {
      flex-basis: 100%;
    }

    .track-hero__visual {
      min-height: 500px;
    }

    .lab-fragment--agent {
      display: none;
    }

    .lab-fragment--prompt {
      top: 12%;
    }

    .lab-fragment--experiment {
      right: 0;
      bottom: 8%;
    }
  }
</style>
