<dialog class="search-dialog" data-search-dialog aria-labelledby="search-title">
  <div class="search-panel">
    <header>
      <div>
        <span class="eyebrow">站内搜索</span><h2 id="search-title">搜索这个个人空间</h2>
      </div>
      <button class="icon-button" type="button" data-search-close aria-label="关闭搜索">×</button>
    </header>
    <label class="search-field">
      <span class="sr-only">搜索关键词</span>
      <input
        type="search"
        data-pagefind-input
        placeholder="输入项目、Agent、RAG……"
        autocomplete="off"
      />
    </label>
    <div class="search-results" data-pagefind-results aria-live="polite">
      <p class="search-empty">输入关键词搜索项目、研究与随想及其他页面。</p>
    </div>
  </div>
</dialog>
