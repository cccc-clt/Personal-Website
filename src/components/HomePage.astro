---
import { getCollection } from 'astro:content';
import { abilities, siteConfig } from '../config/site';
import { avatarConfig } from '../config/visualAssets';
import HeroBanner from './HeroBanner.astro';
import ProjectCard from './ProjectCard.astro';

const allProjects = (await getCollection('projects')).sort(
  (a, b) => a.data.order.general - b.data.order.general,
);
const featuredProjectSlugs = [
  'ai-game-content-copilot',
  'elysia-ai-character-agent',
  'ai-game-growth-workflow',
];
const getProjectSlug = (project: (typeof allProjects)[number]) => project.id.replace(/\.mdx?$/, '');
const projectBySlug = new Map(allProjects.map((project) => [getProjectSlug(project), project]));
const featuredProjects = featuredProjectSlugs.flatMap((slug) => {
  const project = projectBySlug.get(slug);
  return project ? [project] : [];
});
const projectCount = String(allProjects.length).padStart(2, '0');
---

<HeroBanner />

<div class="home-flow page-shell">
  <section class="home-projects" id="featured-projects" aria-labelledby="featured-projects-title">
    <header class="home-heading">
      <div class="home-heading__index" aria-hidden="true">01</div>
      <div>
        <p>精选项目</p>
        <h2 id="featured-projects-title">三个真实案例，三种 AI 产品命题</h2>
      </div>
      <a href="/projects/">查看全部 {projectCount} 个项目 <span aria-hidden="true">→</span></a>
    </header>

    <div class="home-projects__grid">
      {
        featuredProjects.map((project, index) => (
          <ProjectCard project={project} homepagePriority={index === 0 ? 'primary' : 'secondary'} />
        ))
      }
    </div>
  </section>

  <section class="home-method" aria-labelledby="home-method-title">
    <header class="home-heading">
      <div class="home-heading__index" aria-hidden="true">02</div>
      <div>
        <p>产品方法</p>
        <h2 id="home-method-title">从场景判断到评测回路</h2>
      </div>
      <a href="/about/">了解我的方法 <span aria-hidden="true">→</span></a>
    </header>

    <ol class="method-flow">
      {
        abilities.map((ability) => (
          <li>
            <span>{ability.index}</span>
            <div>
              <p>{ability.english}</p>
              <h3>{ability.title}</h3>
              <p>{ability.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="career-cta" aria-labelledby="career-cta-title">
    <div class="career-cta__avatar" aria-hidden="true">
      <img
        src={avatarConfig.image}
        width={avatarConfig.width}
        height={avatarConfig.height}
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="career-cta__copy">
      <p>{siteConfig.name} · {siteConfig.englishName}</p>
      <h2 id="career-cta-title">游戏 AI 产品经理 / AI 应用产品经理方向</h2>
      <p>
        交通工程本科生，持续围绕游戏 AI、角色 Agent、工作流与产品评测推进真实项目实践。
        如果你想进一步了解我的经历与判断方式，可以从在线简历或完整介绍开始。
      </p>
    </div>
    <div class="career-cta__actions" aria-label="职业信息入口">
      <a class="career-link career-link--primary" href="/resume/">查看在线简历</a>
      <a class="career-link" href="/about/">关于我</a>
      <a class="career-link" href={siteConfig.github} target="_blank" rel="noreferrer">
        GitHub <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</div>

<style>
  .home-flow {
    display: grid;
    gap: clamp(5rem, 9vw, 9rem);
    padding-top: clamp(4.5rem, 8vw, 7rem);
    padding-bottom: clamp(5rem, 9vw, 8rem);
  }

  .home-projects,
  .home-method {
    scroll-margin-top: 7rem;
  }

  .home-heading {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto;
    gap: clamp(1rem, 2.4vw, 2rem);
    align-items: end;
    padding-bottom: clamp(1.4rem, 2.8vw, 2rem);
    border-bottom: 1px solid var(--border);
  }

  .home-heading__index {
    color: var(--violet);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.6;
  }

  .home-heading p {
    margin: 0 0 0.5rem;
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0;
  }

  .home-heading h2 {
    max-width: 840px;
    margin: 0;
    font-size: clamp(2rem, 4.4vw, 4rem);
    letter-spacing: -0.02em;
    line-height: 1.12;
    text-wrap: balance;
  }

  .home-heading > a {
    display: inline-flex;
    min-height: 44px;
    gap: 0.5rem;
    align-items: center;
    color: var(--text-secondary);
    font-size: 0.78rem;
    font-weight: 600;
    white-space: nowrap;
    transition:
      color 180ms ease,
      transform 180ms var(--ease-out);
  }

  .home-heading > a:hover {
    color: var(--primary-strong);
    transform: translateX(3px);
  }

  .home-heading > a:focus-visible,
  .career-link:focus-visible {
    border-radius: 8px;
    outline: 3px solid color-mix(in srgb, var(--primary-strong) 58%, transparent);
    outline-offset: 4px;
  }

  .home-projects__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .home-projects__grid > :global(:first-child) {
    grid-column: 1 / -1;
  }

  .method-flow {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding: 0;
    margin: 1.25rem 0 0;
    list-style: none;
  }

  .method-flow li {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    min-width: 0;
    padding: 1.4rem clamp(1rem, 2vw, 1.5rem);
    border-left: 1px solid var(--border);
  }

  .method-flow li:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .method-flow li:last-child {
    padding-right: 0;
  }

  .method-flow li > span {
    color: var(--violet);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    line-height: 1.6;
  }

  .method-flow li > div > p:first-child {
    margin: 0 0 0.55rem;
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .method-flow h3 {
    margin: 0;
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
    letter-spacing: -0.015em;
  }

  .method-flow li > div > p:last-child {
    margin: 0.65rem 0 0;
    color: var(--text-secondary);
    font-size: 0.78rem;
    line-height: 1.75;
    text-wrap: pretty;
  }

  .career-cta {
    position: relative;
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr) auto;
    gap: clamp(1.2rem, 3vw, 2.2rem);
    align-items: center;
    overflow: hidden;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background:
      radial-gradient(
        circle at 90% 10%,
        color-mix(in srgb, var(--violet) 18%, transparent),
        transparent 15rem
      ),
      linear-gradient(
        125deg,
        color-mix(in srgb, var(--primary-soft) 64%, var(--surface-solid)),
        color-mix(in srgb, var(--surface-solid) 92%, var(--pink))
      );
  }

  .career-cta::after {
    position: absolute;
    top: -32px;
    right: 7%;
    width: 72px;
    height: 72px;
    border: 1px solid color-mix(in srgb, var(--violet) 20%, transparent);
    content: '';
    rotate: 45deg;
  }

  .career-cta__avatar {
    position: relative;
    z-index: 1;
    overflow: hidden;
    width: 96px;
    height: 96px;
    border: 1px solid color-mix(in srgb, var(--surface-solid) 82%, var(--border));
    border-radius: 28px;
    background: var(--surface-solid);
    box-shadow: 0 14px 32px color-mix(in srgb, var(--text-main) 10%, transparent);
  }

  .career-cta__avatar img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .career-cta__copy {
    position: relative;
    z-index: 1;
    min-width: 0;
  }

  .career-cta__copy > p:first-child {
    margin: 0 0 0.45rem;
    color: var(--violet);
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0;
  }

  .career-cta h2 {
    margin: 0;
    font-size: clamp(1.35rem, 2.6vw, 2.25rem);
    letter-spacing: -0.02em;
    line-height: 1.2;
    text-wrap: balance;
  }

  .career-cta__copy > p:last-child {
    max-width: 720px;
    margin: 0.7rem 0 0;
    color: var(--text-secondary);
    font-size: 0.82rem;
    line-height: 1.75;
  }

  .career-cta__actions {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: flex-end;
    max-width: 280px;
  }

  .career-link {
    display: inline-flex;
    min-height: 44px;
    gap: 0.35rem;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 0.9rem;
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    background: color-mix(in srgb, var(--surface-solid) 70%, transparent);
    color: var(--text-main);
    font-size: 0.76rem;
    font-weight: 600;
    transition:
      transform 180ms var(--ease-out),
      border-color 180ms ease;
  }

  .career-link--primary {
    border-color: var(--text-main);
    background: var(--text-main);
    color: var(--surface-solid);
  }

  .career-link:hover {
    border-color: color-mix(in srgb, var(--primary) 56%, var(--border-strong));
    transform: translateY(-2px);
  }

  @media (max-width: 1020px) {
    .method-flow {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .method-flow li:nth-child(3) {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--border);
    }

    .method-flow li:nth-child(4) {
      border-top: 1px solid var(--border);
    }

    .career-cta {
      grid-template-columns: 88px minmax(0, 1fr);
    }

    .career-cta__avatar {
      width: 88px;
      height: 88px;
    }

    .career-cta__actions {
      grid-column: 2;
      justify-content: flex-start;
      max-width: none;
    }
  }

  @media (max-width: 760px) {
    .home-flow {
      gap: 4.75rem;
      padding-top: 4rem;
      padding-bottom: 5rem;
    }

    .home-heading {
      grid-template-columns: 2rem minmax(0, 1fr);
    }

    .home-heading > a {
      grid-column: 2;
      width: fit-content;
    }

    .home-projects__grid {
      grid-template-columns: 1fr;
    }

    .home-projects__grid > :global(:first-child) {
      grid-column: 1;
    }
  }

  @media (max-width: 560px) {
    .home-heading {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }

    .home-heading__index {
      margin-bottom: 0.25rem;
    }

    .home-heading > a {
      grid-column: 1;
      margin-top: 0.5rem;
    }

    .method-flow {
      grid-template-columns: 1fr;
    }

    .method-flow li,
    .method-flow li:first-child,
    .method-flow li:nth-child(3),
    .method-flow li:last-child {
      padding: 1.15rem 0;
      border-top: 1px solid var(--border);
      border-left: 0;
    }

    .method-flow li:first-child {
      border-top: 0;
    }

    .career-cta {
      grid-template-columns: 68px minmax(0, 1fr);
      align-items: start;
    }

    .career-cta__avatar {
      width: 68px;
      height: 68px;
      border-radius: 20px;
    }

    .career-cta__copy > p:last-child {
      grid-column: 1 / -1;
    }

    .career-cta__actions {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 100%;
    }

    .career-link--primary {
      grid-column: 1 / -1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-heading > a,
    .career-link {
      transition: none;
    }

    .home-heading > a:hover,
    .career-link:hover {
      transform: none;
    }
  }
</style>
