---
import { getCollection } from 'astro:content';
import { abilities, productWorkflow, researchCategoryLabels, siteConfig } from '../config/site';
import { avatarConfig } from '../config/visualAssets';
import { estimateReadingMinutes, formatDate } from '../utils/content';
import HeroBanner from './HeroBanner.astro';
import ProjectCard from './ProjectCard.astro';

const allProjects = (await getCollection('projects')).sort(
  (a, b) => a.data.order.general - b.data.order.general,
);
const featuredProjectSlugs = [
  'ai-game-content-copilot',
  'ai-product-evaluation-workbench',
  'elysia-ai-character-agent',
  'mobile-uiagent-evaluation-lab',
];
const projectBySlug = new Map(allProjects.map((project) => [project.id, project]));
const featuredProjects = featuredProjectSlugs.flatMap((slug) => {
  const project = projectBySlug.get(slug);
  return project ? [project] : [];
});
const research = (await getCollection('research'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const featuredResearch = research.find((entry) => entry.data.featured) ?? research[0];
---

<HeroBanner />

<div class="home-flow page-shell">
  <section class="home-projects" id="featured-projects" aria-labelledby="featured-projects-title">
    <header class="home-heading">
      <div>
        <p>精选项目</p>
        <h2 id="featured-projects-title">四个案例，回答四类 AI 产品问题</h2>
      </div>
      <a class="text-link" href="/projects/">查看全部 {allProjects.length} 个项目</a>
    </header>
    <div class="home-projects__grid">
      {featuredProjects.map((project) => <ProjectCard project={project} mode="featured" />)}
    </div>
  </section>

  <section class="home-method" aria-labelledby="home-method-title">
    <header class="home-heading">
      <div>
        <p>产品方法</p>
        <h2 id="home-method-title">能力不是标签，而是一条可复盘的工作流</h2>
      </div>
      <a class="text-link" href="/about/">了解判断方式</a>
    </header>
    <div class="home-method__layout">
      <div class="home-method__abilities">
        {
          abilities.map((ability) => (
            <article>
              <h3>{ability.title}</h3>
              <p>{ability.description}</p>
            </article>
          ))
        }
      </div>
      <ol class="home-method__flow" aria-label="七步产品工作流">
        {
          productWorkflow.map((step, index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{step}</strong>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    featuredResearch && (
      <section class="home-research" aria-labelledby="home-research-title">
        <div class="home-research__context">
          <p>Research</p>
          <span>将项目中的判断、方法和失败边界整理为可继续讨论的研究记录。</span>
        </div>
        <article>
          <div class="home-research__meta">
            <span>{researchCategoryLabels[featuredResearch.data.category]}</span>
            <span>{formatDate(featuredResearch.data.publishedAt)}</span>
            <span>{estimateReadingMinutes(featuredResearch.body)} 分钟阅读</span>
          </div>
          <h2 id="home-research-title">{featuredResearch.data.title}</h2>
          <p>{featuredResearch.data.summary}</p>
          <a class="text-link" href={`/research/${featuredResearch.id}/`}>
            阅读方法文章
          </a>
        </article>
      </section>
    )
  }

  <section class="home-about" aria-labelledby="home-about-title">
    <div class="home-about__portrait">
      <img
        src={avatarConfig.image}
        width={avatarConfig.width}
        height={avatarConfig.height}
        alt="赵天琦个人网站的原创二次元头像"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div>
      <p>关于赵天琦</p>
      <h2 id="home-about-title">从复杂系统出发，走向面向真实任务的 AI 产品。</h2>
      <p>
        交通工程训练了我理解参与者、约束、路径和反馈；AI
        产品实践让我把这些方法用于场景判断、原型、Agent
        工作流与评测。网站只呈现仓库和已有材料能够核验的事实。
      </p>
      <a class="text-link" href="/about/">阅读完整介绍</a>
    </div>
  </section>

  <section class="career-cta" aria-labelledby="career-cta-title">
    <div>
      <p>{siteConfig.availability}</p>
      <h2 id="career-cta-title">如果你在寻找会把 AI 想法推进到验证回路的人，可以从这里继续。</h2>
    </div>
    <div class="career-cta__actions">
      <a class="button button--primary" href="/resume/">查看在线简历</a>
      <a class="button" href="/projects/">浏览全部项目</a>
      <a class="text-link" href={siteConfig.github} target="_blank" rel="noreferrer">GitHub</a>
    </div>
  </section>
</div>

<style>
  .home-flow {
    display: grid;
    gap: clamp(6rem, 12vw, 11rem);
    padding-block: clamp(5rem, 9vw, 8rem) clamp(6rem, 12vw, 11rem);
  }

  section {
    scroll-margin-top: 7rem;
  }

  .home-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }

  .home-heading p,
  .home-research__context > p,
  .home-about > div:last-child > p:first-child,
  .career-cta > div:first-child > p {
    margin: 0 0 0.7rem;
    color: var(--primary-strong);
    font-size: 0.82rem;
    font-weight: 620;
  }

  .home-heading h2 {
    max-width: 18ch;
    margin: 0;
    font-size: clamp(2.2rem, 4.7vw, 4.6rem);
    letter-spacing: -0.035em;
    line-height: 1.12;
  }

  .home-projects__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1.25rem;
    align-items: start;
  }

  .home-projects__grid > :global(:nth-child(1)),
  .home-projects__grid > :global(:nth-child(4)) {
    grid-column: span 7;
  }

  .home-projects__grid > :global(:nth-child(2)),
  .home-projects__grid > :global(:nth-child(3)) {
    grid-column: span 5;
  }

  .home-projects__grid > :global(:nth-child(2)) {
    margin-top: 5rem;
  }

  .home-projects__grid > :global(:nth-child(4)) {
    margin-top: -3rem;
  }

  .home-method__layout {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(340px, 0.58fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .home-method__abilities {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    border-top: 1px solid var(--border-strong);
  }

  .home-method__abilities article {
    min-height: 190px;
    padding: 1.5rem 1.5rem 2.2rem 0;
    border-bottom: 1px solid var(--border);
  }

  .home-method__abilities article:nth-child(odd) {
    padding-right: 2.5rem;
  }

  .home-method__abilities article:nth-child(even) {
    padding-left: 2.5rem;
    border-left: 1px solid var(--border);
  }

  .home-method__abilities h3 {
    margin: 0;
    font-size: 1.35rem;
  }

  .home-method__abilities p {
    margin: 0.8rem 0 0;
    color: var(--text-secondary);
    line-height: 1.75;
  }

  .home-method__flow {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: method;
  }

  .home-method__flow li {
    display: grid;
    grid-template-columns: 3.2rem 1fr;
    gap: 1rem;
    align-items: center;
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--border);
  }

  .home-method__flow span {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .home-method__flow strong {
    font-size: 1rem;
  }

  .home-research {
    display: grid;
    grid-template-columns: minmax(180px, 0.32fr) minmax(0, 1fr);
    gap: clamp(3rem, 8vw, 9rem);
    padding: clamp(2rem, 5vw, 4.5rem) 0;
    border-top: 1px solid var(--border-strong);
    border-bottom: 1px solid var(--border-strong);
  }

  .home-research__context span {
    display: block;
    max-width: 26ch;
    color: var(--text-secondary);
    font-size: 0.84rem;
    line-height: 1.7;
  }

  .home-research article {
    max-width: 850px;
  }

  .home-research__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.2rem;
    color: var(--text-muted);
    font-size: 0.74rem;
  }

  .home-research h2 {
    margin: 1.2rem 0 0;
    font-size: clamp(2.1rem, 4vw, 4rem);
    letter-spacing: -0.03em;
    line-height: 1.18;
  }

  .home-research article > p {
    max-width: 65ch;
    margin: 1rem 0 1.5rem;
    color: var(--text-secondary);
    line-height: 1.8;
  }

  .home-about {
    display: grid;
    grid-template-columns: minmax(240px, 0.52fr) minmax(0, 1fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: center;
  }

  .home-about__portrait {
    width: min(100%, 440px);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 16px 16px 6rem 16px;
    background: var(--surface-tint);
  }

  .home-about__portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-about h2 {
    max-width: 16ch;
    margin: 0;
    font-size: clamp(2.3rem, 4.7vw, 4.6rem);
    letter-spacing: -0.035em;
    line-height: 1.12;
  }

  .home-about > div:last-child > p:nth-of-type(2) {
    max-width: 64ch;
    margin: 1.25rem 0 1.6rem;
    color: var(--text-secondary);
    line-height: 1.85;
  }

  .career-cta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(2rem, 7vw, 7rem);
    align-items: end;
    padding: clamp(2rem, 5vw, 4.5rem);
    border-radius: var(--radius-md);
    background: var(--text-main);
    color: #f5f8fa;
  }

  .career-cta h2 {
    max-width: 21ch;
    margin: 0;
    font-size: clamp(2rem, 4.2vw, 4rem);
    letter-spacing: -0.032em;
    line-height: 1.14;
  }

  .career-cta > div:first-child > p {
    color: #b8cad4;
  }

  .career-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    align-items: center;
    justify-content: flex-end;
  }

  .career-cta .button {
    border-color: rgba(255, 255, 255, 0.28);
    background: transparent;
    color: #fff;
  }

  .career-cta .button--primary {
    border-color: #fff;
    background: #fff;
    color: #17202d;
  }

  .career-cta .text-link {
    padding-inline: 0.7rem;
    color: #d6e3e9;
  }

  @media (max-width: 920px) {
    .home-projects__grid > :global(*) {
      grid-column: span 6 !important;
      margin-top: 0 !important;
    }

    .home-method__layout,
    .career-cta {
      grid-template-columns: 1fr;
    }

    .career-cta__actions {
      justify-content: flex-start;
    }
  }

  @media (max-width: 720px) {
    .home-heading {
      align-items: start;
      flex-direction: column;
    }

    .home-projects__grid {
      display: grid;
      grid-template-columns: 1fr;
    }

    .home-projects__grid > :global(*) {
      grid-column: 1 !important;
    }

    .home-method__abilities,
    .home-research,
    .home-about {
      grid-template-columns: 1fr;
    }

    .home-method__abilities article:nth-child(n) {
      min-height: 0;
      padding: 1.4rem 0;
      border-left: 0;
    }

    .home-research {
      gap: 2rem;
    }

    .home-about__portrait {
      aspect-ratio: 16 / 10;
      border-radius: var(--radius-md);
    }
  }

  @media (max-width: 520px) {
    .career-cta {
      padding: 1.5rem;
    }

    .career-cta__actions {
      align-items: stretch;
      flex-direction: column;
    }

    .career-cta__actions > * {
      width: 100%;
      justify-content: center;
    }
  }
</style>
