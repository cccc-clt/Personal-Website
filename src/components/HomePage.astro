---
import { getCollection } from 'astro:content';
import { abilities } from '../config/site';
import { timeline } from '../data/siteContent';
import HeroBanner from './HeroBanner.astro';
import MainGridLayout from './MainGridLayout.astro';
import ProfileCard from './ProfileCard.astro';
import ProjectCard from './ProjectCard.astro';
import RightSidebar from './RightSidebar.astro';

const allProjects = (await getCollection('projects')).sort((a, b) => a.data.order.general - b.data.order.general);
const homepageProjectOrder = [
  'ai-game-content-copilot',
  'elysia-ai-character-agent',
  'ai-game-growth-workflow',
  'ai-product-evaluation-workbench',
];
const homepageProjectRank = new Map(homepageProjectOrder.map((slug, index) => [slug, index]));
const getProjectSlug = (project: (typeof allProjects)[number]) => project.id.replace(/\.mdx?$/, '');
const projects = [...allProjects].sort((a, b) => {
  const aRank = homepageProjectRank.get(getProjectSlug(a)) ?? Number.MAX_SAFE_INTEGER;
  const bRank = homepageProjectRank.get(getProjectSlug(b)) ?? Number.MAX_SAFE_INTEGER;

  return aRank === bRank ? a.data.order.general - b.data.order.general : aRank - bRank;
});
const projectCount = String(allProjects.length).padStart(2, '0');
---

<HeroBanner />
<MainGridLayout>
  <ProfileCard slot="left" />

  <article class="welcome-card panel">
    <span class="eyebrow">WELCOME TO MY SPACE</span>
    <h2>你好，我是赵天琦。</h2>
    <p>我是一名交通工程专业本科生，目前正在向游戏 AI 与 AI 产品方向发展。</p>
    <p>我持续实践 Prompt、Agent、RAG、模型评测和快速原型，尝试把复杂技术转化为更清楚、更可用、更容易验证的产品方案。</p>
    <div class="welcome-card__links"><a href="/about/">进一步认识我 →</a><a href="/stack/">查看工具链 →</a></div>
  </article>

  <section class="home-projects" aria-labelledby="featured-title">
    <header class="home-section__heading"><div><span class="eyebrow">FEATURED PROJECTS</span><h2 id="featured-title">精选项目</h2></div><a href="/projects/">全部 {projectCount} 个项目 ↗</a></header>
    <div class="home-projects__spotlight">
      {projects.slice(0, 3).map((project, index) => <ProjectCard project={project} homepagePriority={index === 0 ? 'primary' : 'secondary'} />)}
    </div>
    <div class="home-projects__divider"><span>更多项目实践</span><span>04—{projectCount}</span></div>
    <div class="home-projects__list">
      {projects.slice(3).map((project, index) => <ProjectCard project={project} homepagePriority={index === 0 ? 'supporting' : 'compact'} />)}
    </div>
  </section>

  <section class="home-section panel" aria-labelledby="method-title">
    <header class="home-section__heading"><div><span class="eyebrow">PRODUCT PRACTICE</span><h2 id="method-title">我如何推进 AI 产品</h2></div><a href="/about/">了解我的方法 ↗</a></header>
    <div class="practice-grid">
      {abilities.map((ability) => <article><span>{ability.index}</span><h3>{ability.title}</h3><p>{ability.description}</p></article>)}
    </div>
  </section>

  <section class="home-section panel" aria-labelledby="timeline-title">
    <header class="home-section__heading"><div><span class="eyebrow">MY TIMELINE</span><h2 id="timeline-title">项目与学习时间线</h2></div><a href="/archive/">完整归档 ↗</a></header>
    <ol class="mini-timeline">{timeline.map((item) => <li><span class="mini-timeline__label">{item.period}</span><i aria-hidden="true"></i><div><span>{item.type}</span><h3>{item.title}</h3><p>{item.text}</p></div></li>)}</ol>
  </section>

  <a class="all-projects panel" href="/projects/"><span><small>CONTINUE EXPLORING</small>查看全部作品与案例研究</span><b aria-hidden="true">→</b></a>

  <RightSidebar slot="right" />
</MainGridLayout>

<style>
  .welcome-card,
  .home-section,
  .all-projects {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    transition:
      border-color 240ms ease,
      box-shadow 240ms ease,
      transform 240ms var(--ease-out);
  }

  .welcome-card,
  .home-section {
    padding: clamp(1.45rem, 3vw, 2.4rem);
  }

  .welcome-card::before {
    position: absolute;
    z-index: -1;
    top: -9rem;
    right: -7rem;
    width: 25rem;
    height: 25rem;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--violet) 17%, transparent), transparent 68%);
    content: '';
    pointer-events: none;
  }

  .welcome-card::after {
    position: absolute;
    top: 1.45rem;
    right: 1.55rem;
    color: color-mix(in srgb, var(--violet) 54%, var(--text-muted));
    content: '✦';
    font-size: 1.1rem;
    opacity: 0.55;
  }

  .welcome-card h2 {
    max-width: 760px;
    margin: 0.72rem 0 1.1rem;
    font-size: clamp(1.9rem, 4vw, 3.45rem);
    letter-spacing: -0.055em;
    line-height: 1.08;
  }

  .welcome-card p {
    max-width: 780px;
    margin: 0 0 0.68rem;
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.88;
  }

  .welcome-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 1.25rem;
    color: var(--primary-strong);
    font-size: 0.76rem;
    font-weight: 750;
  }

  .welcome-card__links a,
  .home-section__heading > a {
    transition:
      color 180ms ease,
      transform 180ms var(--ease-out);
  }

  .welcome-card__links a:hover,
  .home-section__heading > a:hover {
    color: var(--primary-strong);
    transform: translateX(3px);
  }

  .welcome-card:hover,
  .home-section:hover {
    border-color: color-mix(in srgb, var(--primary) 24%, var(--border));
    box-shadow: 0 22px 56px color-mix(in srgb, var(--text-main) 10%, transparent);
  }

  .home-section::before {
    position: absolute;
    z-index: -1;
    top: -36px;
    right: -36px;
    width: 105px;
    height: 105px;
    border: 1px solid color-mix(in srgb, var(--primary) 15%, transparent);
    content: '';
    rotate: 45deg;
  }

  .home-section__heading {
    display: flex;
    gap: 1rem;
    align-items: end;
    justify-content: space-between;
    padding-bottom: 1.45rem;
    border-bottom: 1px solid var(--border);
  }

  .home-section__heading h2 {
    margin: 0.45rem 0 0;
    font-size: clamp(1.65rem, 3.5vw, 2.8rem);
    letter-spacing: -0.05em;
    line-height: 1.08;
  }

  .home-section__heading > a {
    color: var(--text-muted);
    font-size: 0.7rem;
  }

  .home-projects {
    position: relative;
    padding: clamp(1.5rem, 3vw, 2.5rem) 0;
    border-block: 1px solid var(--border);
  }

  .home-projects__spotlight {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 1rem;
    margin-top: 1.5rem;
  }

  .home-projects__spotlight > :global(:first-child) {
    grid-column: 1 / -1;
  }

  .home-projects__divider {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 0 0.75rem;
    margin-top: 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .home-projects__divider span:last-child {
    color: var(--violet);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
  }

  .home-projects__list {
    display: grid;
  }

  .home-projects .home-section__heading > a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
  }

  .practice-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: 1.35rem;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--border);
  }

  .practice-grid article {
    position: relative;
    padding: 1.3rem;
    background: color-mix(in srgb, var(--surface-solid) 94%, var(--primary-soft));
    transition:
      background 220ms ease,
      transform 220ms var(--ease-out);
  }

  .practice-grid article::after {
    position: absolute;
    top: 0.9rem;
    right: 1rem;
    width: 7px;
    height: 7px;
    border: 1px solid color-mix(in srgb, var(--violet) 55%, var(--border-strong));
    content: '';
    opacity: 0.48;
    rotate: 45deg;
  }

  .practice-grid article:hover {
    z-index: 1;
    background: color-mix(in srgb, var(--surface-solid) 82%, var(--primary-soft));
    transform: translateY(-2px);
  }

  .practice-grid span,
  .mini-timeline span {
    color: var(--violet);
    font-family: var(--font-mono);
    font-size: 0.66rem;
  }

  .practice-grid h3,
  .mini-timeline h3 {
    margin: 0.65rem 0 0.5rem;
    font-size: 1rem;
  }

  .practice-grid p,
  .mini-timeline p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.78rem;
    line-height: 1.75;
  }

  .mini-timeline {
    padding: 0;
    margin: 1.05rem 0 0;
    list-style: none;
  }

  .mini-timeline li {
    display: grid;
    grid-template-columns: 95px 12px 1fr;
    gap: 0.8rem;
    padding: 1.05rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 72%, transparent);
  }

  .mini-timeline li:last-child {
    border-bottom: 0;
  }

  .mini-timeline__label {
    color: var(--text-muted) !important;
    font-family: var(--font-mono);
    font-size: 0.6rem !important;
  }

  .mini-timeline i {
    position: relative;
    width: 9px;
    height: 9px;
    margin-top: 0.2rem;
    border: 2px solid var(--surface-solid);
    border-radius: 50%;
    background: var(--primary);
    box-shadow:
      0 0 0 1px var(--primary),
      0 0 16px color-mix(in srgb, var(--primary) 42%, transparent);
  }

  .mini-timeline i::after {
    position: absolute;
    top: 10px;
    bottom: -84px;
    left: 3px;
    width: 1px;
    background: linear-gradient(var(--border-strong), color-mix(in srgb, var(--violet) 26%, var(--border)));
    content: '';
  }

  .mini-timeline li:last-child i::after {
    display: none;
  }

  .all-projects {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    padding: 1.65rem 1.9rem;
    background:
      radial-gradient(circle at 87% 18%, color-mix(in srgb, var(--surface-solid) 78%, transparent), transparent 8rem),
      linear-gradient(120deg, var(--primary-soft), color-mix(in srgb, var(--pink) 23%, var(--surface-solid)));
  }

  .all-projects::after {
    position: absolute;
    right: 5rem;
    width: 48px;
    height: 48px;
    border: 1px solid color-mix(in srgb, var(--primary) 26%, transparent);
    content: '';
    rotate: 45deg;
    transition: rotate 360ms var(--ease-out);
  }

  .all-projects:hover {
    border-color: color-mix(in srgb, var(--primary) 36%, var(--border));
    box-shadow: var(--shadow-float);
    transform: translateY(-3px);
  }

  .all-projects:hover::after {
    rotate: 135deg;
  }

  .all-projects span {
    position: relative;
    z-index: 1;
    font-size: clamp(1.08rem, 2.2vw, 1.55rem);
    font-weight: 750;
  }

  .all-projects small {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    font-weight: 500;
    letter-spacing: 0.06em;
  }

  .all-projects b {
    position: relative;
    z-index: 1;
    font-size: 1.7rem;
    transition: transform 220ms var(--ease-out);
  }

  .all-projects:hover b {
    transform: translateX(5px);
  }

  @media (max-width: 840px) {
    .home-projects__spotlight {
      grid-template-columns: 1fr;
    }

    .home-projects__spotlight > :global(:first-child) {
      grid-column: 1;
    }

    .home-projects__spotlight {
      gap: 1rem;
    }
  }

  @media (max-width: 680px) {
    .practice-grid {
      grid-template-columns: 1fr;
    }

    .home-projects {
      padding-block: 1.5rem;
    }

    .home-projects__divider {
      margin-top: 1rem;
    }

    .home-section__heading {
      align-items: start;
      flex-direction: column;
    }

    .welcome-card::after,
    .all-projects::after {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .welcome-card,
    .home-section,
    .all-projects,
    .practice-grid article,
    .all-projects b,
    .welcome-card__links a,
    .home-section__heading > a {
      transition: none;
    }
  }
</style>
