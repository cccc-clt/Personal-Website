---
import { getCollection } from 'astro:content';
import { abilities, siteConfig } from '../config/site';
import { avatarConfig } from '../config/visualAssets';
import ArticleCard from './ArticleCard.astro';
import HeroBanner from './HeroBanner.astro';
import InfoCard from './InfoCard.astro';
import ProjectCard from './ProjectCard.astro';

const allProjects = (await getCollection('projects')).sort(
  (a, b) => a.data.order.general - b.data.order.general,
);
const featuredProjectSlugs = [
  'ai-game-content-copilot',
  'elysia-ai-character-agent',
  'mobile-uiagent-evaluation-lab',
  'ai-product-evaluation-workbench',
];
const projectBySlug = new Map(allProjects.map((project) => [project.id, project]));
const featuredProjects = featuredProjectSlugs.flatMap((slug) => {
  const project = projectBySlug.get(slug);
  return project ? [project] : [];
});
const research = (await getCollection('research'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const featuredResearch = research.find((entry) => entry.data.featured) ?? research[0];
const abilityLabels = ['问题定义', '工作流设计', '原型验证', '评测回路'];
---

<HeroBanner />

<section class="home-projects" id="featured-projects" aria-labelledby="featured-projects-title">
  <div class="page-shell">
    <header class="home-heading reveal">
      <div>
        <p>精选项目</p>
        <h2 id="featured-projects-title">用四个案例，说明我如何推进 AI 产品。</h2>
      </div>
      <a class="text-link" href="/projects/">查看全部项目</a>
    </header>
    <div class="home-projects__grid" data-reveal-group>
      {featuredProjects.map((project) => <ProjectCard project={project} mode="featured" />)}
    </div>
  </div>
</section>

<section class="home-method" aria-labelledby="home-method-title">
  <div class="page-shell">
    <header class="home-heading reveal">
      <div>
        <p>产品方法</p>
        <h2 id="home-method-title">把模糊想法，变成可以验证的下一步。</h2>
      </div>
      <a class="text-link" href="/about/">查看完整方法</a>
    </header>
    <div class="home-method__grid" data-reveal-group>
      {
        abilities.map((ability, index) => (
          <InfoCard
            label={abilityLabels[index]}
            title={ability.title}
            description={ability.description}
          />
        ))
      }
    </div>
  </div>
</section>

{
  featuredResearch && (
    <section class="home-research" aria-labelledby="home-research-title">
      <div class="page-shell">
        <header class="home-heading reveal">
          <div>
            <p>最新研究</p>
            <h2 id="home-research-title">记录判断，也记录尚未验证的部分。</h2>
          </div>
          <a class="text-link" href="/research/">
            浏览研究
          </a>
        </header>
        <div class="home-research__card" data-reveal-group>
          <ArticleCard article={featuredResearch} />
        </div>
      </div>
    </section>
  )
}

<section class="home-about" aria-labelledby="home-about-title">
  <div class="page-shell home-about__layout">
    <figure class="home-about__portrait reveal">
      <img
        src={avatarConfig.image}
        width={avatarConfig.width}
        height={avatarConfig.height}
        alt="赵天琦个人网站的原创二次元头像"
        loading="lazy"
        decoding="async"
      />
      <figcaption>原创个人头像 · 仅用于品牌表达</figcaption>
    </figure>
    <div class="home-about__copy reveal">
      <p>关于我</p>
      <h2 id="home-about-title">从复杂系统出发，做面向真实任务的 AI 产品。</h2>
      <p>
        交通工程训练了我理解参与者、约束、路径和反馈；AI
        产品实践让我把这些方法用于场景判断、原型、Agent
        工作流与评测。网站只呈现仓库和已有材料能够核验的事实。
      </p>
      <a class="text-link" href="/about/">阅读完整介绍</a>
    </div>
  </div>
</section>

<section class="career-cta" aria-labelledby="career-cta-title">
  <div class="page-shell career-cta__layout reveal">
    <div>
      <p>{siteConfig.availability}</p>
      <h2 id="career-cta-title">如果你正在寻找能把 AI 想法推进到验证回路的人。</h2>
    </div>
    <div class="career-cta__actions">
      <a class="button button--primary" href="/resume/">查看在线简历</a>
      <a class="button" href="/projects/">浏览项目</a>
      <a class="text-link" href={siteConfig.github} target="_blank" rel="noreferrer">GitHub</a>
    </div>
  </div>
</section>

<style>
  section {
    scroll-margin-top: 6rem;
  }

  .home-projects,
  .home-method,
  .home-research,
  .home-about {
    padding-block: clamp(4.5rem, 8vw, 7.5rem);
  }

  .home-method,
  .home-about {
    background: var(--page-bg-soft);
  }

  .home-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(2.5rem, 4.5vw, 3.5rem);
  }

  .home-heading p,
  .home-about__copy > p:first-child,
  .career-cta__layout > div:first-child > p {
    margin: 0 0 0.65rem;
    color: var(--accent-hover);
    font-size: 0.84rem;
    font-weight: 600;
  }

  .home-heading h2,
  .home-about h2,
  .career-cta h2 {
    max-width: 19ch;
    margin: 0;
    font-size: clamp(2.3rem, 4vw, 3rem);
    letter-spacing: -0.018em;
    line-height: 1.18;
  }

  .home-projects__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.4rem;
    align-items: stretch;
  }

  .home-projects__grid > :global(.project-card:first-child) {
    grid-column: 1 / -1;
  }

  .home-projects__grid :global(.project-card:first-child .project-card__link) {
    grid-template-columns: minmax(0, 1.35fr) minmax(320px, 0.65fr);
  }

  .home-projects__grid :global(.project-card:first-child .project-card__visual) {
    border-radius: var(--radius-card) 0 0 var(--radius-card);
  }

  .home-projects__grid :global(.project-card:first-child .project-cover) {
    height: 100%;
    min-height: 410px;
    border-radius: inherit;
  }

  .home-projects__grid :global(.project-card:first-child .project-card__body) {
    justify-content: center;
    padding: clamp(2rem, 4vw, 3.2rem);
  }

  .home-method__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .home-research__card {
    max-width: 980px;
  }

  .home-research__card :global(.article-card__link) {
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  }

  .home-research__card :global(.article-card figure) {
    min-width: 0;
    min-height: 390px;
    aspect-ratio: auto;
  }

  .home-research__card :global(.article-card__body) {
    justify-content: center;
    padding: clamp(2rem, 5vw, 3.5rem);
  }

  .home-about__layout {
    display: grid;
    grid-template-columns: minmax(240px, 0.42fr) minmax(0, 0.78fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: center;
  }

  .home-about__portrait {
    width: min(100%, 360px);
    margin: 0;
  }

  .home-about__portrait img {
    aspect-ratio: 1;
    width: 100%;
    border-radius: var(--radius-md);
    object-fit: cover;
    filter: saturate(0.78) brightness(1.03);
    box-shadow: var(--shadow-sm);
  }

  .home-about__portrait figcaption {
    margin-top: 0.7rem;
    color: var(--text-muted);
    font-size: 0.72rem;
  }

  .home-about__copy > p:nth-of-type(2) {
    max-width: 62ch;
    margin: 1.4rem 0 1.5rem;
    color: var(--text-secondary);
    line-height: 1.82;
  }

  .career-cta {
    padding-block: clamp(4.5rem, 8vw, 7rem);
    border-block: 1px solid var(--border);
    background: var(--surface-warm);
  }

  .career-cta__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 3rem;
    align-items: end;
  }

  .career-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1rem;
    align-items: center;
    justify-content: flex-end;
  }

  @media (max-width: 960px) {
    .home-projects__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .home-projects__grid :global(.project-card:first-child .project-card__link),
    .home-research__card :global(.article-card__link) {
      grid-template-columns: 1fr;
    }

    .home-projects__grid :global(.project-card:first-child .project-card__visual) {
      border-radius: var(--radius-card) var(--radius-card) 0 0;
    }

    .home-projects__grid :global(.project-card:first-child .project-cover),
    .home-research__card :global(.article-card figure) {
      min-height: 0;
    }

    .career-cta__layout {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .career-cta__actions {
      justify-content: flex-start;
    }
  }

  @media (max-width: 700px) {
    .home-projects,
    .home-method,
    .home-research,
    .home-about {
      padding-block: 4rem;
    }

    .home-heading {
      align-items: start;
      flex-direction: column;
      gap: 1.2rem;
    }

    .home-projects__grid,
    .home-method__grid,
    .home-about__layout {
      grid-template-columns: 1fr;
    }

    .home-about__layout {
      gap: 2.5rem;
    }

    .home-about__portrait {
      width: min(72%, 300px);
    }

    .career-cta__actions {
      align-items: stretch;
      flex-direction: column;
    }

    .career-cta__actions .button,
    .career-cta__actions .text-link {
      width: 100%;
      justify-content: center;
    }
  }
</style>
