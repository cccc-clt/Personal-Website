---
import { getCollection } from 'astro:content';
import { abilities, siteConfig } from '../config/site';
import { avatarConfig } from '../config/visualAssets';
import ArticleCard from './ArticleCard.astro';
import HeroBanner from './HeroBanner.astro';
import InfoCard from './InfoCard.astro';
import NoteTimelineCard from './NoteTimelineCard.astro';
import ProjectCard from './ProjectCard.astro';
import { sortInsightsByDate } from '../utils/content';

const featuredProjects = (await getCollection('projects'))
  .filter((project) => project.data.homepageFeatured)
  .sort((a, b) => (a.data.homepageOrder ?? 99) - (b.data.homepageOrder ?? 99))
  .slice(0, 3);

const insights = await getCollection('research');
const publishedResearch = insights
  .filter(
    (entry) =>
      entry.data.status === 'published' &&
      entry.data.section === 'research' &&
      entry.data.homepageFeatured,
  )
  .sort((a, b) => (a.data.homepageOrder ?? 99) - (b.data.homepageOrder ?? 99))
  .slice(0, 3);
const publishedNotes = insights
  .filter((entry) => entry.data.status === 'published' && entry.data.section === 'notes')
  .sort(sortInsightsByDate)
  .slice(0, 3);

const abilityLabels = ['问题定义', '工作流设计', '原型验证', '评测回路'];
---

<HeroBanner />

<section class="home-projects" id="featured-projects" aria-labelledby="featured-projects-title">
  <div class="page-shell">
    <header class="home-heading reveal">
      <div>
        <h2 id="featured-projects-title">精选项目</h2>
        <p>从游戏内容、角色智能体到增长评测，展示三类游戏 AI 产品实践。</p>
      </div>
      <a class="text-link" href="/projects/">查看全部</a>
    </header>
    <div class="home-projects__grid" data-reveal-group>
      {featuredProjects.map((project) => <ProjectCard project={project} mode="featured" />)}
    </div>
  </div>
</section>

<section class="home-method" aria-labelledby="home-method-title">
  <div class="page-shell">
    <header class="home-heading home-heading--method reveal">
      <div>
        <span>产品方法</span>
        <h2 id="home-method-title">把模糊想法，变成可以验证的下一步。</h2>
      </div>
      <a class="text-link" href="/about/">查看完整方法</a>
    </header>
    <div class="home-method__grid" data-reveal-group>
      {
        abilities.map((ability, index) => (
          <InfoCard
            label={abilityLabels[index]}
            title={ability.title}
            description={ability.description}
          />
        ))
      }
    </div>
  </div>
</section>

<section class="home-research" aria-labelledby="home-research-title">
  <div class="page-shell">
    <header class="home-heading reveal">
      <div>
        <h2 id="home-research-title">研究与产品随笔</h2>
        <p>呈现系统研究，也记录从真实项目与产品问题中形成的判断。</p>
      </div>
      <a class="text-link" href="/insights/">查看全部研究与产品随笔</a>
    </header>
    <div class="home-research__grid" data-reveal-group>
      {publishedResearch.map((article) => <ArticleCard article={article} />)}
    </div>
  </div>
</section>

{
  publishedNotes.length > 0 && (
    <section class="home-notes" aria-labelledby="home-notes-title">
      <div class="page-shell">
        <header class="home-heading reveal">
          <div>
            <h2 id="home-notes-title">最近随笔</h2>
            <p>记录比赛、个人游玩体验与阶段性成长过程。</p>
          </div>
          <a class="text-link" href="/notes/">
            查看全部随笔
          </a>
        </header>
        <div class="home-notes__grid" data-reveal-group>
          {publishedNotes.map((article) => (
            <NoteTimelineCard article={article} compact />
          ))}
        </div>
      </div>
    </section>
  )
}

<section class="home-about" aria-labelledby="home-about-title">
  <div class="page-shell home-about__layout">
    <figure class="home-about__portrait reveal">
      <img
        src={avatarConfig.image}
        width={avatarConfig.width}
        height={avatarConfig.height}
        alt="赵天琦个人网站的原创二次元头像"
        loading="lazy"
        decoding="async"
      />
      <figcaption>原创个人头像 · 仅用于品牌表达</figcaption>
    </figure>
    <div class="home-about__copy reveal">
      <p>关于我</p>
      <h2 id="home-about-title">从复杂系统出发，做面向真实任务的 AI 产品。</h2>
      <p>
        交通工程训练了我理解参与者、约束、路径和反馈；AI
        产品实践让我把这些方法用于场景判断、原型、Agent
        工作流与评测。网站只呈现仓库和已有材料能够核验的事实。
      </p>
      <a class="text-link" href="/about/">阅读完整介绍</a>
    </div>
  </div>
</section>

<section class="home-development" aria-labelledby="home-development-title">
  <div class="page-shell">
    <header class="home-development__heading reveal">
      <h2 id="home-development-title">补充实践</h2>
      <p lang="en">Professional Development</p>
    </header>

    <article class="development-entry reveal">
      <div class="development-entry__content">
        <header class="development-entry__header">
          <h3>Forage Product Management Job Simulation</h3>
          <p>
            Forage Academy <span aria-hidden="true">·</span>
            <time datetime="2026-08">2026.08</time>
          </p>
        </header>

        <p class="development-entry__summary">
          完成移动策略 RPG 场景下的 KPI 判断、玩家洞察优先级与 Stakeholder Presentation
          项目规划实践。
        </p>

        <ul class="development-entry__skills" aria-label="技能标签">
          <li>KPI &amp; Metrics</li>
          <li>Player Insights</li>
          <li>Project Planning</li>
        </ul>
      </div>

      <a
        class="text-link development-entry__certificate"
        href="/certificates/forage-product-management-job-simulation-2026-08.pdf"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="在新标签页查看 Forage Product Management Job Simulation 完成证书（PDF）"
      >
        查看证书 <span aria-hidden="true">↗</span>
      </a>
    </article>
  </div>
</section>

<section class="career-cta" aria-labelledby="career-cta-title">
  <div class="page-shell career-cta__layout reveal">
    <div>
      <p>{siteConfig.availability}</p>
      <h2 id="career-cta-title">如果你正在寻找能把 AI 想法推进到验证回路的人。</h2>
    </div>
    <div class="career-cta__actions">
      <a class="button button--primary" href="/projects/">浏览项目</a>
      <a class="text-link" href={siteConfig.github} target="_blank" rel="noopener noreferrer"
        >GitHub</a
      >
    </div>
  </div>
</section>

<style>
  section {
    scroll-margin-top: 6rem;
  }

  .home-projects,
  .home-method,
  .home-research,
  .home-notes,
  .home-about {
    padding-block: clamp(4.5rem, 8vw, 7.5rem);
  }

  .home-method,
  .home-about {
    background: var(--page-bg-soft);
  }

  .home-notes {
    border-block: 1px solid var(--border);
    background: var(--surface-warm);
  }

  .home-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(2.5rem, 4.5vw, 3.5rem);
  }

  .home-heading h2,
  .home-about h2,
  .career-cta h2 {
    max-width: 20ch;
    margin: 0;
    font-size: clamp(2.3rem, 4vw, 3rem);
    letter-spacing: -0.018em;
    line-height: 1.18;
  }

  .home-heading > div > p {
    max-width: 58ch;
    margin: 0.8rem 0 0;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .home-heading--method span,
  .home-about__copy > p:first-child,
  .career-cta__layout > div:first-child > p {
    display: block;
    margin: 0 0 0.65rem;
    color: var(--accent-hover);
    font-size: 0.84rem;
    font-weight: 600;
  }

  .home-projects__grid,
  .home-research__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 2vw, 1.875rem);
    align-items: stretch;
  }

  .home-projects__grid > *,
  .home-research__grid > * {
    min-width: 0;
  }

  .home-notes__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 2.5vw, 2.5rem);
  }

  .home-notes__grid > * {
    min-width: 0;
  }

  .home-method__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .home-about__layout {
    display: grid;
    grid-template-columns: minmax(240px, 0.42fr) minmax(0, 0.78fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: center;
  }

  .home-about__portrait {
    width: min(100%, 360px);
    margin: 0;
  }

  .home-about__portrait img {
    aspect-ratio: 1;
    width: 100%;
    border-radius: var(--radius-md);
    object-fit: cover;
    filter: saturate(0.78) brightness(1.03);
    box-shadow: var(--shadow-sm);
  }

  .home-about__portrait figcaption {
    margin-top: 0.7rem;
    color: var(--text-muted);
    font-size: 0.72rem;
  }

  .home-about__copy > p:nth-of-type(2) {
    max-width: 62ch;
    margin: 1.4rem 0 1.5rem;
    color: var(--text-secondary);
    line-height: 1.82;
  }

  .home-development {
    padding-block: clamp(3.25rem, 5.5vw, 4.75rem);
  }

  .home-development__heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.9rem;
    margin-bottom: 1.5rem;
  }

  .home-development__heading h2 {
    margin: 0;
    font-size: clamp(1.45rem, 2.5vw, 1.8rem);
    letter-spacing: -0.012em;
    line-height: 1.3;
  }

  .home-development__heading p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .development-entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    min-width: 0;
    align-items: end;
    gap: 1.25rem clamp(2rem, 5vw, 4rem);
    padding: clamp(1.4rem, 3vw, 1.8rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-solid);
  }

  .development-entry__content {
    min-width: 0;
  }

  .development-entry__header h3 {
    margin: 0;
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    letter-spacing: -0.008em;
    line-height: 1.4;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .development-entry__header p {
    margin: 0.4rem 0 0;
    color: var(--text-secondary);
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .development-entry__summary {
    max-width: 68ch;
    margin: 0.9rem 0 0;
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.75;
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }

  .development-entry__skills {
    display: flex;
    min-width: 0;
    flex-wrap: wrap;
    gap: 0.42rem;
    margin: 0.95rem 0 0;
    padding: 0;
    list-style: none;
  }

  .development-entry__skills li {
    max-width: 100%;
    padding: 0.32rem 0.56rem;
    border-radius: var(--radius-pill);
    background: var(--surface-soft);
    color: var(--text-secondary);
    font-size: 0.68rem;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  .development-entry__certificate {
    min-height: 44px;
    justify-self: end;
    padding-block: 0.55rem;
    font-size: 0.84rem;
    white-space: nowrap;
  }

  .development-entry__certificate::after {
    content: none;
  }

  .development-entry__certificate span {
    transition: translate 280ms var(--ease-out);
  }

  .development-entry__certificate:hover span {
    translate: 3px -2px;
  }

  .career-cta {
    padding-block: clamp(4.5rem, 8vw, 7rem);
    border-block: 1px solid var(--border);
    background: var(--surface-warm);
  }

  .career-cta__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 3rem;
    align-items: end;
  }

  .career-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1rem;
    align-items: center;
    justify-content: flex-end;
  }

  @media (max-width: 960px) {
    .home-projects__grid,
    .home-research__grid,
    .home-notes__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .career-cta__layout {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .career-cta__actions {
      justify-content: flex-start;
    }
  }

  @media (max-width: 700px) {
    .home-projects,
    .home-method,
    .home-research,
    .home-notes,
    .home-about {
      padding-block: 4rem;
    }

    .home-heading {
      align-items: start;
      flex-direction: column;
      gap: 1.2rem;
    }

    .home-projects__grid,
    .home-research__grid,
    .home-notes__grid,
    .home-method__grid,
    .home-about__layout {
      grid-template-columns: 1fr;
    }

    .home-about__layout {
      gap: 2.5rem;
    }

    .home-about__portrait {
      width: min(72%, 300px);
    }

    .home-development {
      padding-block: 3rem;
    }

    .development-entry {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 1rem;
    }

    .development-entry__certificate {
      justify-self: start;
    }

    .career-cta__actions {
      align-items: stretch;
      flex-direction: column;
    }

    .career-cta__actions .button,
    .career-cta__actions .text-link {
      width: 100%;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .development-entry__certificate span {
      transition: none;
    }

    .development-entry__certificate:hover span {
      translate: none;
    }
  }
</style>
