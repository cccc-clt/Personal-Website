---
import { siteConfig } from '../config/site';

const hasPublishedFeeds = Boolean(Astro.site);
---

<footer class="site-footer">
  <div class="page-shell site-footer__grid">
    <div class="site-footer__intro">
      <span class="eyebrow">{siteConfig.name} · 2027 届</span>
      <p>{siteConfig.signature}</p>
    </div>
    <nav class="site-footer__links" aria-label="页脚导航">
      <a href="/projects/">项目</a>
      <a href="/insights/">研究</a>
      <a href="/notes/">随笔</a>
      <a href="/about/">关于</a>
      <a href="/resume/">简历</a>
      <a href="/stack/">工具栈</a>
      <a href="/archive/">归档</a>
      <a href="/credits/">资源说明</a>
    </nav>
    <div class="site-footer__meta">
      <p>© 2026 {siteConfig.name} · 基于 Astro 构建</p>
      {
        hasPublishedFeeds && (
          <p>
            <a href="/rss.xml">RSS</a> · <a href="/sitemap-index.xml">Sitemap</a>
          </p>
        )
      }
    </div>
  </div>
</footer>
