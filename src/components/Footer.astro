---
import { siteConfig } from '../config/site';

const hasPublishedFeeds = Boolean(Astro.site);
---

<footer class="site-footer">
  <div class="page-shell site-footer__grid">
    <div>
      <span class="eyebrow">TIANQI.Z / PERSONAL SPACE</span>
      <p>{siteConfig.signature}</p>
    </div>
    <nav aria-label="页脚导航">
      <a href="/projects/">项目</a><a href="/game/">游戏观察</a><a href="/moments/">AI 随想</a><a
        href="/archive/">归档</a
      ><a href="/credits/">资源署名</a>
    </nav>
    <div class="site-footer__meta">
      <p>
        本网站基于开源 Astro 主题 <a
          href="https://github.com/LyraVoid/Mizuki"
          target="_blank"
          rel="noreferrer">Mizuki</a
        > 进行二次开发。
      </p>
      <p>
        © 2026 {siteConfig.name}{
          hasPublishedFeeds && (
            <>
              {' '}
              · <a href="/rss.xml">RSS</a> · <a href="/sitemap-index.xml">Sitemap</a>
            </>
          )
        }
      </p>
    </div>
  </div>
</footer>
