---
import ProjectCard from './ProjectCard.astro';
import SectionIntro from './SectionIntro.astro';
import type { ProjectEntry } from '../types/project';

interface Props {
  projects: ProjectEntry[];
  trackLabel: string;
}

const { projects, trackLabel } = Astro.props;
---

<section class="featured-projects section">
  <div class="container">
    <SectionIntro
      eyebrow="02 / SELECTED WORK"
      title={`${trackLabel}，不是功能清单，而是可复盘的产品判断。`}
      description="每个案例都从用户任务开始，交代 AI 为什么必要、哪里必须由人接管，以及失败如何推动下一轮设计。"
    />
    <div class="featured-projects__layout">
      {projects[0] && <ProjectCard project={projects[0]} layout="wide" />}
      <div class="featured-projects__pair">
        {projects[1] && <ProjectCard project={projects[1]} layout="portrait" />}
        {projects[2] && <ProjectCard project={projects[2]} layout="standard" />}
      </div>
      {projects[3] && <ProjectCard project={projects[3]} layout="wide" />}
    </div>
    <div class="featured-projects__more">
      <a class="button" href="/projects">浏览全部 7 个项目 <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .featured-projects {
    background: #f8faff;
  }

  .featured-projects__layout {
    display: grid;
    gap: clamp(5rem, 10vw, 9rem);
  }

  .featured-projects__pair {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: clamp(2rem, 7vw, 8rem);
    align-items: end;
  }

  .featured-projects__pair > :nth-child(2) {
    margin-bottom: 12%;
  }

  .featured-projects__more {
    display: flex;
    justify-content: center;
    margin-top: 5rem;
  }

  @media (max-width: 760px) {
    .featured-projects__pair {
      grid-template-columns: 1fr;
      gap: 5rem;
    }

    .featured-projects__pair > :nth-child(2) {
      margin-bottom: 0;
    }
  }
</style>
