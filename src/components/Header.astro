---
import { siteConfig } from '../config/site';

const pathname = Astro.url.pathname;
const currentCategory = Astro.url.searchParams.get('category');
const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  if (href.includes('category=learning-notes')) {
    return pathname.startsWith('/research/') && currentCategory === 'learning-notes';
  }
  if (href === '/research/') {
    return pathname.startsWith('/research/') && currentCategory !== 'learning-notes';
  }
  return pathname.startsWith(href);
};
---

<header class="site-header" data-header>
  <div class="site-header__inner page-shell">
    <a class="site-brand" href="/" aria-label={`${siteConfig.name}个人网站首页`}>
      <strong>{siteConfig.name}</strong>
      <small>游戏 AI 产品作品集</small>
    </a>

    <nav class="desktop-nav" aria-label="主要导航">
      {
        siteConfig.nav.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <a
        class="header-github"
        href={siteConfig.github}
        target="_blank"
        rel="noreferrer"
        aria-label="访问赵天琦的 GitHub"
      >
        GitHub ↗
      </a>
      <button class="icon-button" type="button" data-search-open aria-label="搜索网站">
        <span aria-hidden="true">⌕</span>
      </button>
      <button
        class="icon-button theme-toggle"
        type="button"
        data-theme-toggle
        aria-label="切换明暗主题"
      >
        <span class="theme-toggle__sun" aria-hidden="true">☼</span>
        <span class="theme-toggle__moon" aria-hidden="true">☾</span>
      </button>
      <button
        class="menu-button"
        type="button"
        aria-label="打开导航"
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-menu-button
      >
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" aria-hidden="true" data-mobile-menu>
    <nav aria-label="移动端导航">
      {
        siteConfig.nav.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            <strong>{item.label}</strong>
          </a>
        ))
      }
    </nav>
    <div class="mobile-menu__footer">
      <div class="mobile-menu__utilities" aria-label="辅助操作">
        <button type="button" data-search-open><span aria-hidden="true">⌕</span>搜索</button>
        <button type="button" data-theme-toggle><span aria-hidden="true">◐</span>主题</button>
        <a href={siteConfig.github} target="_blank" rel="noreferrer">GitHub ↗</a>
      </div>
      <p>{siteConfig.availability}</p>
    </div>
  </div>
</header>
