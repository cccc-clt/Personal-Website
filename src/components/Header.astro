---
import { siteConfig } from '../config/site';

interface Props {
  currentPath: string;
  pageTag?: string;
}

const { currentPath, pageTag = 'AI PRODUCT' } = Astro.props;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header" data-site-header>
  <div class="shell nav-shell">
    <a class="brand" href="/" aria-label="赵天琦个人作品集首页">
      <span class="brand-mark" aria-hidden="true"><span></span></span>
      <span class="brand-copy">
        <strong>TIANQI.Z</strong>
        <small>AI PRODUCT PORTFOLIO</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="主导航">
      {
        siteConfig.nav.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <a href={siteConfig.github} target="_blank" rel="noreferrer"
        >GitHub <span aria-hidden="true">↗</span></a
      >
      <a href="#contact">联系我</a>
    </nav>

    <div class="nav-actions">
      <span class="page-mode"><i aria-hidden="true"></i>{pageTag}</span>
      <a class="button button-small button-primary" href="/resume">简历下载</a>
      <button
        class="menu-toggle"
        type="button"
        aria-label="打开导航菜单"
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-menu-toggle
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu-layer" data-menu-layer hidden>
    <button class="mobile-menu-backdrop" type="button" aria-label="关闭导航菜单" data-menu-close
    ></button>
    <nav id="mobile-menu" class="mobile-menu" aria-label="移动端导航">
      <div class="mobile-menu-head">
        <span class="eyebrow">NAVIGATION</span>
        <button class="icon-close" type="button" aria-label="关闭导航菜单" data-menu-close>×</button
        >
      </div>
      <div class="mobile-links">
        {
          siteConfig.nav.map((item, index) => (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              <span>0{index + 1}</span>
              {item.label}
            </a>
          ))
        }
        <a href={siteConfig.github} target="_blank" rel="noreferrer"><span>05</span>GitHub ↗</a>
        <a href="#contact" data-menu-close><span>06</span>联系我</a>
      </div>
      <div class="mobile-menu-foot">
        <span class="status-dot"></span>
        <p>{siteConfig.status}</p>
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const layer = document.querySelector<HTMLElement>('[data-menu-layer]');
  const closeButtons = document.querySelectorAll<HTMLElement>('[data-menu-close]');

  const setMenu = (open: boolean) => {
    if (!toggle || !layer) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? '关闭导航菜单' : '打开导航菜单');
    layer.hidden = !open;
    document.body.classList.toggle('menu-open', open);
    if (open) layer.querySelector<HTMLElement>('a, button')?.focus();
    else toggle.focus();
  };

  toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
  closeButtons.forEach((button) => button.addEventListener('click', () => setMenu(false)));
  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') setMenu(false);
  });

  const updateHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 16);
  updateHeader();
  window.addEventListener('scroll', updateHeader, { passive: true });
</script>
