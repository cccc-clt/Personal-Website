---
interface Props {
  id: string;
  src: string;
  alt: string;
  caption: string;
  priority?: boolean;
}

const { id, src, alt, caption, priority = false } = Astro.props;
const dialogId = `research-figure-${id}`;
---

<figure class="research-figure">
  <button
    class="research-figure__open"
    type="button"
    aria-label={`放大查看：${caption}`}
    data-research-figure-open={dialogId}
  >
    <img
      src={src}
      alt={alt}
      width="1448"
      height="1086"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
    />
    <span aria-hidden="true">放大查看</span>
  </button>
  <figcaption>{caption}</figcaption>
</figure>

<dialog class="research-figure-dialog" id={dialogId} data-research-figure-dialog>
  <button
    class="research-figure-dialog__close"
    type="button"
    aria-label="关闭图片预览"
    data-research-figure-close
  >
    ×
  </button>
  <figure>
    <img src={src} alt={alt} width="1448" height="1086" loading="lazy" decoding="async" />
    <figcaption>
      <span>{caption}</span>
      <a href={src} target="_blank" rel="noopener noreferrer">在新窗口查看原图</a>
    </figcaption>
  </figure>
</dialog>

<script>
  let researchFigureTrigger: HTMLButtonElement | null = null;

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const openButton = target.closest<HTMLButtonElement>('[data-research-figure-open]');
    if (openButton) {
      const dialog = document.getElementById(
        openButton.dataset.researchFigureOpen ?? '',
      ) as HTMLDialogElement | null;
      if (!dialog) return;
      researchFigureTrigger = openButton;
      dialog.showModal();
      dialog.querySelector<HTMLButtonElement>('[data-research-figure-close]')?.focus();
      return;
    }

    const closeButton = target.closest<HTMLButtonElement>('[data-research-figure-close]');
    if (closeButton) closeButton.closest<HTMLDialogElement>('dialog')?.close();
    if (target.matches('[data-research-figure-dialog]')) (target as HTMLDialogElement).close();
  });

  document.addEventListener(
    'close',
    (event) => {
      if ((event.target as HTMLElement).matches('[data-research-figure-dialog]')) {
        researchFigureTrigger?.focus();
      }
    },
    true,
  );
</script>

<style>
  .research-figure {
    margin: clamp(2.5rem, 6vw, 4.25rem) 0;
  }

  .research-figure__open {
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: #fff;
    cursor: zoom-in;
  }

  .research-figure__open img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0;
    transition: scale 300ms var(--ease-out);
  }

  .research-figure__open:hover img {
    scale: 1.012;
  }

  .research-figure__open:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--accent) 48%, transparent);
    outline-offset: 4px;
  }

  .research-figure__open > span {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    padding: 0.42rem 0.62rem;
    border-radius: var(--radius-xs);
    background: rgb(24 27 31 / 84%);
    color: #fff;
    font-size: 0.7rem;
    line-height: 1;
  }

  .research-figure > figcaption {
    margin-top: 0.75rem;
    color: var(--text-muted);
    font-size: 0.76rem;
    line-height: 1.65;
    text-align: center;
  }

  .research-figure-dialog {
    width: min(1240px, calc(100vw - 32px));
    max-width: none;
    max-height: calc(100dvh - 32px);
    padding: 0.8rem;
    border: 0;
    border-radius: var(--radius-md);
    background: var(--surface-solid);
    color: var(--text-primary);
  }

  .research-figure-dialog::backdrop {
    background: rgb(8 10 13 / 82%);
    backdrop-filter: blur(5px);
  }

  .research-figure-dialog figure {
    display: grid;
    gap: 0.7rem;
    margin: 0;
  }

  .research-figure-dialog img {
    display: block;
    width: 100%;
    max-height: calc(100dvh - 112px);
    object-fit: contain;
  }

  .research-figure-dialog figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    justify-content: space-between;
    padding-inline: 0.2rem 3.4rem;
    color: var(--text-muted);
    font-size: 0.76rem;
    line-height: 1.6;
  }

  .research-figure-dialog figcaption a {
    color: var(--accent-hover);
    font-weight: 650;
  }

  .research-figure-dialog__close {
    position: absolute;
    z-index: 1;
    top: 1.1rem;
    right: 1.1rem;
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
    background: color-mix(in srgb, var(--surface-solid) 92%, transparent);
    color: var(--text-primary);
    cursor: pointer;
    font-size: 1.35rem;
  }

  @media (max-width: 560px) {
    .research-figure {
      margin-block: 2.25rem 2.75rem;
    }

    .research-figure__open > span {
      right: 0.5rem;
      bottom: 0.5rem;
      font-size: 0.66rem;
    }

    .research-figure-dialog {
      width: calc(100vw - 16px);
      max-height: calc(100dvh - 16px);
      padding: 0.5rem;
    }

    .research-figure-dialog img {
      max-height: calc(100dvh - 96px);
    }

    .research-figure-dialog figcaption {
      display: grid;
      padding-inline: 0.2rem 3rem;
    }

    .research-figure-dialog__close {
      top: 0.8rem;
      right: 0.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .research-figure__open img,
    .research-figure__open:hover img {
      transition: none;
      scale: 1;
    }
  }
</style>
