---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getInsightPath,
  getInsightPdfPath,
  parsePublicationDate,
  sortInsightsByDate,
} from '../utils/content';
import ArticleHeader from './ArticleHeader.astro';
import ArticlePager from './ArticlePager.astro';
import ArticleProse from './ArticleProse.astro';
import ArticleToc from './ArticleToc.astro';
import KeyConclusion from './KeyConclusion.astro';
import PdfActions from './PdfActions.astro';
import RelatedInsights from './RelatedInsights.astro';
import ResearchNotice from './ResearchNotice.astro';

interface Props {
  article: CollectionEntry<'research'>;
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const publishedInsights = (await getCollection('research'))
  .filter((entry) => entry.data.status === 'published')
  .sort(sortInsightsByDate);
const relatedInsights = article.data.relatedInsights.flatMap((slug) => {
  const entry = publishedInsights.find((candidate) => candidate.data.slug === slug);
  return entry ? [entry] : [];
});
const sectionInsights = publishedInsights.filter(
  (entry) => entry.data.section === article.data.section,
);
const currentIndex = sectionInsights.findIndex((entry) => entry.id === article.id);
const previous = currentIndex >= 0 ? sectionInsights[currentIndex + 1] : undefined;
const next = currentIndex > 0 ? sectionInsights[currentIndex - 1] : undefined;
const articleUrl = getInsightPath(article);
const pdfReaderUrl = article.data.pdfUrl ? getInsightPdfPath(article) : undefined;
const exactPublishedTime =
  article.data.publishDate.length === 10
    ? parsePublicationDate(article.data.publishDate)
    : undefined;
const exactModifiedTime =
  article.data.updatedDate.length === 10
    ? parsePublicationDate(article.data.updatedDate)
    : undefined;
const absoluteArticleUrl = Astro.site ? new URL(articleUrl, Astro.site).toString() : articleUrl;
const absolutePdfUrl =
  Astro.site && article.data.pdfUrl
    ? new URL(article.data.pdfUrl, Astro.site).toString()
    : article.data.pdfUrl;
const citationDate = article.data.publishDate.replaceAll('-', '.');
const isNote = article.data.section === 'notes';
const citationTitle = article.data.title.startsWith('《')
  ? article.data.title
  : `《${article.data.title}》`;
const structuredData = {
  '@type': article.data.kind === 'research-report' ? 'TechArticle' : 'Article',
  headline: article.data.title,
  alternativeHeadline: article.data.subtitle || undefined,
  description: article.data.description,
  datePublished: article.data.publishDate,
  dateModified: article.data.updatedDate,
  inLanguage: 'zh-CN',
  isAccessibleForFree: true,
  author: { '@id': Astro.site ? new URL('/#person', Astro.site).toString() : '#person' },
  publisher: { '@id': Astro.site ? new URL('/#person', Astro.site).toString() : '#person' },
  keywords: article.data.tags.join(', '),
  mainEntityOfPage: absoluteArticleUrl,
  url: absoluteArticleUrl,
  ...(absolutePdfUrl
    ? {
        associatedMedia: {
          '@type': 'MediaObject',
          contentUrl: absolutePdfUrl,
          encodingFormat: 'application/pdf',
        },
      }
    : {}),
};
---

<BaseLayout
  title={article.data.seoTitle ?? `${article.data.title} | 赵天琦｜游戏 AI 产品经理`}
  description={article.data.description}
  image={article.data.cover?.src}
  canonicalPath={articleUrl}
  pageType="article"
  publishedTime={exactPublishedTime}
  modifiedTime={exactModifiedTime}
  structuredData={structuredData}
>
  <article class="article-detail" id="article-top">
    <ArticleHeader article={article}>
      <ArticleToc headings={headings} variant="mobile" />
    </ArticleHeader>

    <div class="article-layout page-shell">
      <div class="article-reading-column">
        <ArticleProse>
          <Content />
        </ArticleProse>

        <footer class="article-ending">
          <KeyConclusion
            title={isNote ? '这篇记录留下的判断' : '核心结论'}
            text={article.data.coreJudgment}
          />

          <ResearchNotice
            title={article.data.kind === 'research-report' ? '研究边界' : '内容说明'}
            text={article.data.researchBoundary}
          />

          {
            article.data.pdfUrl && pdfReaderUrl && (
              <section
                class="article-ending__pdf"
                aria-labelledby="article-pdf-title"
                data-pagefind-ignore
              >
                <div>
                  <p>PDF 原版</p>
                  <h2 id="article-pdf-title">查看正式排版、完整附录与来源清单</h2>
                </div>
                <PdfActions
                  title={article.data.title}
                  context="article"
                  webUrl={articleUrl}
                  pdfUrl={article.data.pdfUrl}
                  readerUrl={pdfReaderUrl}
                />
              </section>
            )
          }

          <section class="article-ending__tags" aria-label="文章标签">
            <p>标签</p>
            <div>{article.data.tags.map((tag) => <span>{tag}</span>)}</div>
          </section>

          <section class="article-ending__citation" aria-labelledby="citation-title">
            <p id="citation-title">版权与引用说明</p>
            <div>
              本文由赵天琦整理并发布。引用建议：赵天琦，{citationTitle}，{citationDate}，
              <a href={articleUrl}>{absoluteArticleUrl}</a>。
              {
                article.data.kind === 'research-report' && article.data.pdfUrl && (
                  <>研究报告的完整附录与来源清单以 PDF 原版为准。</>
                )
              }
              {
                article.data.kind === 'ai-product-note' && article.data.pdfUrl && (
                  <>本文所附 PDF 版本保留原始排版与资料来源说明。</>
                )
              }
            </div>
          </section>

          <RelatedInsights insights={relatedInsights} />
          <ArticlePager previous={previous} next={next} />
        </footer>
      </div>

      <ArticleToc headings={headings} variant="desktop" />
    </div>
  </article>
</BaseLayout>

<script>
  type TocWindow = Window & { articleTocObserver?: IntersectionObserver };

  const setupArticleToc = () => {
    const tocWindow = window as TocWindow;
    tocWindow.articleTocObserver?.disconnect();

    const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-article-toc] a')];
    if (!tocLinks.length) return;

    const headingIds = [...new Set(tocLinks.map((link) => decodeURIComponent(link.hash.slice(1))))];
    const articleHeadings = headingIds.flatMap((id) => {
      const heading = document.getElementById(id);
      return heading ? [heading] : [];
    });
    if (!articleHeadings.length) return;

    const setActiveHeading = (id: string) => {
      tocLinks.forEach((link) => {
        const linkId = decodeURIComponent(link.hash.slice(1));
        if (linkId === id) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };

    const selectCurrentHeading = () => {
      const passedHeadings = articleHeadings.filter(
        (heading) => heading.getBoundingClientRect().top <= innerHeight * 0.28,
      );
      const current = passedHeadings.at(-1) ?? articleHeadings[0];
      if (current) setActiveHeading(current.id);
    };

    tocWindow.articleTocObserver = new IntersectionObserver(selectCurrentHeading, {
      rootMargin: '-18% 0px -68% 0px',
      threshold: [0, 1],
    });
    articleHeadings.forEach((heading) => tocWindow.articleTocObserver?.observe(heading));

    if (location.hash) {
      const hashId = decodeURIComponent(location.hash.slice(1));
      if (headingIds.includes(hashId)) setActiveHeading(hashId);
      else selectCurrentHeading();
    } else {
      selectCurrentHeading();
    }

    tocLinks.forEach((link) => {
      link.addEventListener('click', () => {
        const mobileToc = link.closest<HTMLDetailsElement>('.article-toc--mobile');
        if (mobileToc) mobileToc.open = false;
      });
    });
  };

  document.addEventListener('site:page-view', setupArticleToc);
  setupArticleToc();
</script>

<style>
  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 6.5rem;
  }

  .article-layout {
    display: grid;
    grid-template-columns: minmax(0, 820px) minmax(240px, 270px);
    gap: clamp(3rem, 4.5vw, 4rem);
    align-items: start;
    justify-content: center;
    padding-bottom: clamp(5rem, 9vw, 8rem);
  }

  .article-reading-column {
    min-width: 0;
  }

  .article-ending {
    display: grid;
    gap: 1.25rem;
    margin-top: clamp(4.5rem, 8vw, 7rem);
    padding-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--border-strong);
  }

  .article-ending__pdf {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.25rem, 3vw, 1.7rem);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
  }

  .article-ending__pdf p,
  .article-ending__tags > p,
  .article-ending__citation > p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.72rem;
    font-weight: 650;
  }

  .article-ending__pdf h2 {
    margin: 0.35rem 0 0;
    font-size: clamp(1.12rem, 2vw, 1.35rem);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .article-ending__tags,
  .article-ending__citation {
    display: grid;
    gap: 0.7rem;
    padding-block: 0.75rem;
  }

  .article-ending__tags > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .article-ending__tags span {
    padding: 0.34rem 0.6rem;
    border-radius: var(--radius-pill);
    background: var(--surface-soft);
    color: var(--text-secondary);
    font-size: 0.72rem;
  }

  .article-ending__citation div {
    color: var(--text-secondary);
    font-size: 0.8rem;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }

  .article-ending__citation a {
    color: var(--accent-hover);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 32%, transparent);
    text-underline-offset: 0.18em;
  }

  @media (max-width: 960px) {
    .article-layout {
      grid-template-columns: minmax(0, 820px);
      gap: 0;
    }
  }

  @media (max-width: 560px) {
    .article-ending__pdf {
      padding-inline: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
  }
</style>
