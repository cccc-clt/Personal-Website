---
import type { CollectionEntry } from 'astro:content';
import { researchCategoryLabels } from '../config/site';
import { getInsightPath, getInsightReadingTime } from '../utils/content';

interface Props {
  insights: CollectionEntry<'research'>[];
}

const { insights } = Astro.props;
---

{
  insights.length > 0 && (
    <section class="related-insights" aria-labelledby="related-insights-title" data-pagefind-ignore>
      <header>
        <p>相关文章</p>
        <h2 id="related-insights-title">沿着同一问题继续阅读</h2>
      </header>
      <div>
        {insights.map((insight) => (
          <a href={getInsightPath(insight)}>
            <span>
              {researchCategoryLabels[insight.data.category]} · {getInsightReadingTime(insight)}
            </span>
            <strong>{insight.data.title}</strong>
          </a>
        ))}
      </div>
    </section>
  )
}

<style>
  .related-insights {
    display: grid;
    gap: 1rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--border);
  }

  header p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.72rem;
    font-weight: 650;
  }

  h2 {
    margin: 0.3rem 0 0;
    font-size: clamp(1.25rem, 2.3vw, 1.55rem);
    letter-spacing: -0.01em;
  }

  .related-insights > div {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  a {
    display: grid;
    gap: 0.5rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }

  a > span {
    color: var(--text-muted);
    font-size: 0.72rem;
  }

  a > strong {
    color: var(--text-primary);
    font-size: 0.86rem;
    line-height: 1.55;
    text-wrap: pretty;
  }

  a:hover strong {
    color: var(--accent-hover);
  }

  @media (max-width: 680px) {
    .related-insights > div {
      grid-template-columns: 1fr;
    }
  }
</style>
