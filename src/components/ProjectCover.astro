---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { projectCovers, type ProjectCoverKey } from '../config/visualAssets';

interface Props {
  slug: string;
  title: string;
  index?: string;
  cover?: ProjectCoverKey;
  compact?: boolean;
}

const { title, cover, compact = false } = Astro.props;
const coverConfig = cover ? projectCovers[cover] : undefined;
const coverCandidates = [coverConfig?.image, coverConfig?.fallback].filter(
  (source): source is string => Boolean(source),
);
const coverPath = coverCandidates.find((source) =>
  existsSync(join(process.cwd(), 'public', source.replace(/^\//, ''))),
);
---

<div
  class:list={['project-cover', { 'project-cover--compact': compact }]}
  role="img"
  aria-label={coverConfig?.alt ?? `${title} 概念封面`}
>
  {
    coverPath ? (
      <img
        class="project-cover__image"
        src={coverPath}
        width={coverConfig?.width ?? 1600}
        height={coverConfig?.height ?? 900}
        alt=""
        loading="lazy"
        decoding="async"
        style={`object-position: ${coverConfig?.position ?? 'center'};`}
      />
    ) : (
      <span class="project-cover__fallback" aria-hidden="true" />
    )
  }
  <span class="project-cover__wash" aria-hidden="true"></span>
</div>

<style>
  .project-cover {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: inherit;
    background: var(--accent-soft);
    isolation: isolate;
  }

  .project-cover__image,
  .project-cover__fallback,
  .project-cover__wash {
    position: absolute;
    inset: 0;
  }

  .project-cover__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.82) contrast(0.96) brightness(1.03);
    transition:
      transform 300ms var(--ease-out),
      filter 300ms ease;
  }

  .project-cover__fallback {
    background:
      radial-gradient(
        circle at 78% 22%,
        color-mix(in srgb, var(--purple) 12%, transparent),
        transparent 32%
      ),
      linear-gradient(145deg, var(--surface-warm), var(--accent-soft));
  }

  .project-cover__wash {
    background: linear-gradient(
      180deg,
      transparent 58%,
      color-mix(in srgb, var(--surface-warm) 34%, transparent)
    );
    pointer-events: none;
  }

  :global(.project-card__link:hover) .project-cover__image {
    filter: saturate(0.9) contrast(0.98) brightness(1.02);
    transform: scale(1.025);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-cover__image,
    :global(.project-card__link:hover) .project-cover__image {
      transition: none;
      transform: none;
    }
  }
</style>
