---
interface Props {
  slug: string;
  title: string;
  index?: string;
  compact?: boolean;
}

const { slug, title, index = 'CASE', compact = false } = Astro.props;
const variantMap: Record<string, string> = {
  'ai-product-evaluation-workbench': 'workbench',
  'mobile-uiagent-evaluation-lab': 'tap',
  'ai-game-growth-workflow': 'growth',
  'automate-ai-car-copilot': 'cockpit',
  'ai-game-content-copilot': 'branch',
  'ai-pdf-learning-assistant': 'documents',
  'elysia-ai-character-agent': 'memory',
};
const variant = variantMap[slug] ?? 'workbench';
---

<div
  class:list={['project-cover', `project-cover--${variant}`, { 'project-cover--compact': compact }]}
  role="img"
  aria-label={`${title} 概念封面`}
>
  <div class="project-cover__wash"></div>
  <div class="project-cover__stage" aria-hidden="true">
    <span></span><span></span><span></span><span></span><span></span><span></span>
  </div>
  <div class="project-cover__meta">
    <span class="mono">{index}</span>
    <span class="project-cover__seal">TQ / AI</span>
  </div>
</div>

<style>
  .project-cover {
    position: relative;
    min-height: 420px;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: #eaf4ff;
    isolation: isolate;
  }

  .project-cover--compact {
    min-height: 320px;
  }

  .project-cover__wash {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 75% 18%, rgba(255, 255, 255, 0.9), transparent 20%),
      radial-gradient(circle at 18% 80%, rgba(250, 207, 219, 0.42), transparent 28%),
      linear-gradient(135deg, rgba(132, 210, 255, 0.44), rgba(224, 216, 255, 0.68));
  }

  .project-cover__stage,
  .project-cover__stage span {
    position: absolute;
  }

  .project-cover__stage {
    inset: 12%;
  }

  .project-cover__stage span {
    display: block;
  }

  .project-cover__meta {
    position: absolute;
    z-index: 3;
    right: 24px;
    bottom: 22px;
    left: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: rgba(31, 40, 77, 0.62);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
  }

  .project-cover__seal {
    padding: 0.45rem 0.65rem;
    border: 1px solid rgba(255, 255, 255, 0.64);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.36);
    backdrop-filter: blur(10px);
    font-family: var(--font-mono);
  }

  .project-cover--workbench .project-cover__wash {
    background:
      radial-gradient(circle at 76% 20%, rgba(255, 255, 255, 0.9), transparent 20%),
      linear-gradient(150deg, #e8f7ff 0%, #dde2ff 55%, #f4e6ee 100%);
  }

  .project-cover--workbench .project-cover__stage {
    display: grid;
    width: 60%;
    height: 60%;
    place-self: center;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    transform: perspective(700px) rotateX(58deg) rotateZ(-28deg) translate(28%, 4%);
  }

  .project-cover--workbench .project-cover__stage span {
    position: relative;
    border: 1px solid rgba(84, 104, 180, 0.22);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.55);
    box-shadow: 14px 18px 24px rgba(84, 99, 157, 0.11);
  }

  .project-cover--workbench .project-cover__stage span:nth-child(2),
  .project-cover--workbench .project-cover__stage span:nth-child(5) {
    background: rgba(104, 125, 224, 0.5);
  }

  .project-cover--tap .project-cover__wash {
    background: linear-gradient(145deg, #f0faff, #dfe6ff 60%, #f5e3ea);
  }

  .project-cover--tap .project-cover__stage {
    inset: 10% 21% 12%;
    border: 1px solid rgba(67, 89, 162, 0.2);
    border-radius: 42px;
    background: rgba(255, 255, 255, 0.43);
    box-shadow: var(--shadow-soft);
  }

  .project-cover--tap .project-cover__stage span {
    width: 24px;
    height: 24px;
    border: 5px solid rgba(96, 132, 233, 0.7);
    border-radius: 50%;
    box-shadow: 0 0 0 13px rgba(101, 154, 240, 0.12);
  }

  .project-cover--tap .project-cover__stage span:nth-child(1) {
    top: 18%;
    left: 20%;
  }
  .project-cover--tap .project-cover__stage span:nth-child(2) {
    top: 38%;
    left: 63%;
  }
  .project-cover--tap .project-cover__stage span:nth-child(3) {
    top: 67%;
    left: 35%;
  }
  .project-cover--tap .project-cover__stage span:nth-child(n + 4) {
    display: none;
  }

  .project-cover--growth .project-cover__wash {
    background: linear-gradient(140deg, #eefbff, #dce9ff 47%, #f6e4e0);
  }

  .project-cover--growth .project-cover__stage span {
    bottom: 18%;
    width: 12%;
    border-radius: 14px 14px 4px 4px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.92), rgba(110, 143, 224, 0.46));
    box-shadow: var(--shadow-float);
  }

  .project-cover--growth .project-cover__stage span:nth-child(1) {
    left: 9%;
    height: 20%;
  }
  .project-cover--growth .project-cover__stage span:nth-child(2) {
    left: 26%;
    height: 32%;
  }
  .project-cover--growth .project-cover__stage span:nth-child(3) {
    left: 43%;
    height: 48%;
  }
  .project-cover--growth .project-cover__stage span:nth-child(4) {
    left: 60%;
    height: 63%;
  }
  .project-cover--growth .project-cover__stage span:nth-child(5) {
    left: 77%;
    height: 78%;
    background: linear-gradient(#ffe8d4, #d88e76);
  }
  .project-cover--growth .project-cover__stage span:nth-child(6) {
    display: none;
  }

  .project-cover--cockpit .project-cover__wash {
    background:
      radial-gradient(circle at 50% 100%, rgba(119, 164, 211, 0.32), transparent 36%),
      linear-gradient(145deg, #e7f6ff, #dfe9fa 52%, #eee8fb);
  }

  .project-cover--cockpit .project-cover__stage {
    inset: 27% 15% 5%;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-bottom: 0;
    border-radius: 50% 50% 0 0;
  }

  .project-cover--cockpit .project-cover__stage span {
    top: 50%;
    left: 50%;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 3px solid rgba(255, 255, 255, 0.72);
    background: #87b7de;
  }

  .project-cover--cockpit .project-cover__stage span:nth-child(2) {
    transform: translate(-150px, 40px);
  }
  .project-cover--cockpit .project-cover__stage span:nth-child(3) {
    transform: translate(140px, 10px);
  }
  .project-cover--cockpit .project-cover__stage span:nth-child(n + 4) {
    display: none;
  }

  .project-cover--branch .project-cover__wash {
    background: linear-gradient(150deg, #fff7f2, #f1dde4 45%, #dddffd);
  }

  .project-cover--branch .project-cover__stage span {
    top: 48%;
    left: 46%;
    width: 42%;
    height: 1px;
    transform-origin: left;
    background: rgba(77, 91, 156, 0.36);
  }

  .project-cover--branch .project-cover__stage span::after {
    position: absolute;
    top: -13px;
    right: 0;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.8);
    box-shadow: var(--shadow-float);
    content: '';
  }

  .project-cover--branch .project-cover__stage span:nth-child(1) {
    rotate: -48deg;
  }
  .project-cover--branch .project-cover__stage span:nth-child(2) {
    rotate: -18deg;
  }
  .project-cover--branch .project-cover__stage span:nth-child(3) {
    rotate: 18deg;
  }
  .project-cover--branch .project-cover__stage span:nth-child(4) {
    rotate: 48deg;
  }
  .project-cover--branch .project-cover__stage span:nth-child(n + 5) {
    display: none;
  }

  .project-cover--documents .project-cover__wash {
    background: linear-gradient(135deg, #eefaff, #dcecff 50%, #e8e4ff);
  }

  .project-cover--documents .project-cover__stage span {
    inset: 10% 22%;
    border: 1px solid rgba(77, 104, 169, 0.18);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.72);
    box-shadow: 18px 24px 38px rgba(75, 91, 148, 0.16);
  }

  .project-cover--documents .project-cover__stage span:nth-child(1) {
    transform: translate(-18%, 18%) rotate(-11deg);
  }
  .project-cover--documents .project-cover__stage span:nth-child(2) {
    transform: translate(0, 5%) rotate(3deg);
  }
  .project-cover--documents .project-cover__stage span:nth-child(3) {
    transform: translate(18%, -8%) rotate(11deg);
    background: rgba(206, 224, 255, 0.86);
  }
  .project-cover--documents .project-cover__stage span:nth-child(n + 4) {
    display: none;
  }

  .project-cover--memory .project-cover__wash {
    background: radial-gradient(
      circle at 50% 50%,
      #fff 0 5%,
      #d7ecff 6% 19%,
      #dcdcfb 20% 39%,
      #f2dfe7 40% 55%,
      #eef7ff 56%
    );
  }

  .project-cover--memory .project-cover__stage span {
    inset: 10%;
    border: 1px solid rgba(81, 99, 171, 0.3);
    border-radius: 50%;
  }

  .project-cover--memory .project-cover__stage span:nth-child(2) {
    inset: 20%;
    border-style: dashed;
    rotate: 25deg;
  }
  .project-cover--memory .project-cover__stage span:nth-child(3) {
    inset: 32%;
    rotate: -20deg;
  }
  .project-cover--memory .project-cover__stage span:nth-child(n + 4) {
    display: none;
  }

  @media (max-width: 640px) {
    .project-cover,
    .project-cover--compact {
      min-height: 270px;
      border-radius: var(--radius-md);
    }
  }
</style>
