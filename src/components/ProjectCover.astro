---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  slug: string;
  title: string;
  index?: string;
  cover?: ImageMetadata;
  coverAlt?: string;
  coverPosition?: 'center top' | 'center center' | 'left top' | 'right top';
  compact?: boolean;
  loading?: 'eager' | 'lazy';
}

const {
  title,
  cover,
  coverAlt,
  coverPosition = 'center top',
  compact = false,
  loading = 'lazy',
} = Astro.props;
const responsiveSizes = compact
  ? '(max-width: 700px) calc(100vw - 40px), (max-width: 960px) calc(50vw - 48px), 400px'
  : '(max-width: 700px) calc(100vw - 40px), min(1280px, calc(100vw - 64px))';
---

<div
  class:list={['project-cover', { 'project-cover--compact': compact }]}
  style={`--cover-position: ${coverPosition};`}
>
  <span class="project-cover__placeholder" aria-hidden="true">{title}</span>
  {
    cover ? (
      <Image
        class="project-cover__image"
        src={cover}
        width={1600}
        height={1000}
        widths={[480, 720, 960, 1280, 1600]}
        sizes={responsiveSizes}
        alt={coverAlt ?? `${title} 的真实产品界面截图`}
        loading={loading}
        decoding="async"
      />
    ) : (
      <span class="project-cover__fallback" role="img" aria-label={`${title} 暂无封面图片`} />
    )
  }
</div>

<style>
  .project-cover {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: inherit;
    background: var(--accent-soft);
    isolation: isolate;
  }

  .project-cover__image,
  .project-cover__fallback,
  .project-cover__placeholder {
    position: absolute;
    inset: 0;
  }

  .project-cover__image {
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--cover-position, center top);
    transition: transform 300ms var(--ease-out);
  }

  .project-cover__placeholder {
    display: grid;
    align-items: center;
    padding: 1.5rem;
    background: var(--accent-soft);
    color: var(--text-secondary);
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 3vw, 1.8rem);
    line-height: 1.25;
  }

  .project-cover__fallback {
    background: var(--accent-soft);
  }

  :global(.project-card__link:hover) .project-cover__image {
    transform: scale(1.02);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-cover__image,
    :global(.project-card__link:hover) .project-cover__image {
      transition: none;
      transform: none;
    }
  }
</style>
