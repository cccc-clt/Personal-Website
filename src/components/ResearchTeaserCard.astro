---
interface Props {
  title: string;
  summary: string;
  category: string;
  tags: string[];
  visualLabel: string;
}

const { title, summary, category, tags, visualLabel } = Astro.props;
---

<article
  class="research-teaser reveal"
  aria-label={`${title}，整理中，尚未发布`}
  data-pagefind-ignore
>
  <figure>
    <div class="research-teaser__visual" aria-hidden="true">
      <span>{visualLabel}</span>
      <strong>IN PROGRESS</strong>
    </div>
    <figcaption>统一占位视觉 · 非研究证据</figcaption>
  </figure>
  <div class="research-teaser__body">
    <div class="research-teaser__tags" aria-label="选题标签">
      {tags.slice(0, 3).map((tag) => <span>{tag}</span>)}
    </div>
    <h3>{title}</h3>
    <p>{summary}</p>
    <div class="research-teaser__meta">
      <span>{category}</span>
      <span>整理中 · 尚未发布</span>
    </div>
  </div>
</article>

<style>
  .research-teaser {
    display: grid;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--surface-solid);
    box-shadow: var(--shadow-sm);
  }

  figure {
    position: relative;
    aspect-ratio: 16 / 8.5;
    margin: 0;
    overflow: hidden;
    background: var(--accent-soft);
  }

  .research-teaser__visual {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(1.25rem, 3vw, 2rem);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--accent-soft) 88%, transparent), transparent),
      repeating-linear-gradient(
        -20deg,
        transparent 0 26px,
        color-mix(in srgb, var(--accent) 8%, transparent) 26px 27px
      );
    color: var(--accent-hover);
  }

  .research-teaser__visual span {
    max-width: 14ch;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.6vw, 2rem);
    line-height: 1.25;
  }

  .research-teaser__visual strong {
    align-self: end;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
  }

  figcaption {
    position: absolute;
    right: 0.9rem;
    bottom: 0.8rem;
    padding: 0.28rem 0.5rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--surface-warm) 90%, transparent);
    color: var(--text-secondary);
    font-size: 0.68rem;
  }

  .research-teaser__body {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: clamp(1.5rem, 3vw, 2rem);
  }

  .research-teaser__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .research-teaser__tags span {
    padding: 0.3rem 0.56rem;
    border-radius: var(--radius-pill);
    background: var(--accent-soft);
    color: var(--accent-hover);
    font-size: 0.72rem;
  }

  h3 {
    margin: 1rem 0 0;
    font-size: clamp(1.55rem, 2.6vw, 2rem);
    letter-spacing: -0.015em;
    line-height: 1.28;
  }

  .research-teaser__body > p {
    display: -webkit-box;
    margin: 0.85rem 0 0;
    overflow: hidden;
    color: var(--text-secondary);
    line-height: 1.72;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .research-teaser__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1rem;
    margin-top: auto;
    padding-top: 1.5rem;
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .research-teaser__meta span:first-child {
    color: var(--accent-hover);
  }
</style>
