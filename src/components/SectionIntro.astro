---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="section-intro">
  <span class="eyebrow">{eyebrow}</span>
  <div class="section-intro__copy">
    <h2 class="section-title">{title}</h2>
    {description && <p class="lede">{description}</p>}
  </div>
</header>
