---
import { existsSync } from 'node:fs';
import path from 'node:path';

interface Props {
  track?: 'general' | 'game' | 'agent' | 'auto';
}
const { track = 'general' } = Astro.props;
const candidates = ['/images/anime-assistant.webp', '/images/avatar.webp'];
const image = candidates.find((candidate) =>
  existsSync(path.join(process.cwd(), 'public', candidate.replace(/^\//, ''))),
);
---

<div class:list={['assistant-visual', `assistant-${track}`]} aria-label="抽象 AI 助手视觉区域">
  <div class="visual-grid" aria-hidden="true"></div>
  <div class="visual-orbit orbit-one" aria-hidden="true"></div>
  <div class="visual-orbit orbit-two" aria-hidden="true"></div>
  <div class="visual-stars" aria-hidden="true"><i></i><i></i><i></i><i></i></div>

  {
    image ? (
      <img
        class="assistant-image"
        src={image}
        alt="赵天琦的原创 AI 助手形象"
        width="620"
        height="700"
      />
    ) : (
      <div class="assistant-figure" aria-hidden="true">
        <div class="figure-halo" />
        <div class="figure-hair back" />
        <div class="figure-neck" />
        <div class="figure-face">
          <>
            <span class="eye left" />
            <span class="eye right" />
          </>
        </div>
        <div class="figure-fringe one" />
        <div class="figure-fringe two" />
        <div class="figure-body">
          <span />
        </div>
        <div class="figure-core">
          <i />
        </div>
      </div>
    )
  }

  <div class="visual-label label-top"><span></span> AI PRODUCT SYSTEM</div>
  <div class="visual-data data-left">
    <span>MODEL STATUS</span><strong>READY</strong><small>CONTEXT · VERIFIED</small>
  </div>
  <div class="visual-data data-right">
    <span>SYSTEM NODE</span><strong>07</strong><small>PRODUCTS CONNECTED</small>
  </div>
  <div class="visual-wave" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
  <div class="currently-card">
    <div><span class="status-dot"></span><small>CURRENTLY</small></div>
    <strong>Open to AI Product Opportunities</strong>
  </div>
</div>
