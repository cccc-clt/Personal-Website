---
import type { TrackConfig } from '../config/site';
import { siteConfig } from '../config/site';
import AnimeAssistantHero from './AnimeAssistantHero.astro';

interface Props {
  config: TrackConfig;
}
const { config } = Astro.props;
const resumeHref = siteConfig.resumes[config.key];
---

<section class="hero-section">
  <div class="hero-glow glow-one" aria-hidden="true"></div>
  <div class="hero-glow glow-two" aria-hidden="true"></div>
  <div class="shell hero-grid">
    <div class="hero-copy" data-reveal>
      <span class="eyebrow"><i aria-hidden="true"></i>{config.eyebrow}</span>
      <h1>{config.title}</h1>
      <p class="hero-role">{config.role}</p>
      <p class="hero-description">{config.description}</p>
      <div class="tag-list hero-tags" aria-label="核心能力标签">
        {config.tags.map((tag) => <span>{tag}</span>)}
      </div>
      <div class="hero-actions">
        <a class="button button-primary" href="#featured-projects"
          >查看精选项目 <span aria-hidden="true">↘</span></a
        >
        <a class="button button-secondary" href="/resume" data-resume-path={resumeHref}>下载简历</a>
        <a class="button button-quiet" href={siteConfig.github} target="_blank" rel="noreferrer"
          >GitHub ↗</a
        >
        <a class="text-link" href="#contact">联系我 <span aria-hidden="true">→</span></a>
      </div>
      <div class="hero-metrics" aria-label="作品集概览">
        <div><strong>07</strong><span>AI 项目实践</span></div>
        <div><strong>04</strong><span>定向求职视图</span></div>
        <div><strong>E2E</strong><span>需求到评测闭环</span></div>
      </div>
    </div>
    <div class="hero-visual-wrap" data-reveal>
      <AnimeAssistantHero track={config.key} />
    </div>
  </div>
  <div class="shell scroll-indicator" aria-hidden="true"><span>SCROLL TO EXPLORE</span><i></i></div>
</section>
