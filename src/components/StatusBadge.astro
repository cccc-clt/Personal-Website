---
import type { ProjectStatus } from '../types/project';

interface Props {
  status: ProjectStatus;
}

const { status } = Astro.props;
const labels: Record<ProjectStatus, string> = {
  LIVE: '已上线',
  TESTED: '已测试',
  ITERATING: '迭代中',
  ARCHIVED: '已归档',
};
---

<span class:list={['status-badge', `status-badge--${status.toLowerCase()}`]}>
  <i aria-hidden="true"></i>{labels[status]}
</span>

<style>
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink-650);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 0 4px color-mix(in srgb, currentColor 13%, transparent);
  }

  .status-badge--live,
  .status-badge--tested {
    color: var(--success);
  }

  .status-badge--iterating {
    color: var(--primary-strong);
  }

  .status-badge--archived {
    color: var(--ink-500);
  }
</style>
