---
interface Props {
  pdfUrl: string;
  title: string;
}

const { pdfUrl, title } = Astro.props;
---

<section class="pdf-viewer" id="pdf-viewer" aria-labelledby="pdf-viewer-title" data-pagefind-ignore>
  <header>
    <div>
      <h2 id="pdf-viewer-title">在线阅读 PDF</h2>
      <p>若浏览器未显示预览，可使用下方备用链接打开原始 PDF。</p>
    </div>
    <a
      class="text-link"
      href={pdfUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`在浏览器中打开${title} PDF`}>打开备用链接</a
    >
  </header>
  <object data={pdfUrl} type="application/pdf" aria-label={`${title}完整 PDF 在线预览`}>
    <div class="pdf-viewer__fallback">
      <p>当前浏览器无法嵌入显示 PDF。</p>
      <a class="button" href={pdfUrl} target="_blank" rel="noopener noreferrer">
        在浏览器中打开 PDF
      </a>
    </div>
  </object>
  <div class="pdf-viewer__mobile" aria-label="移动端 PDF 阅读选项">
    <p>移动端浏览器的内嵌预览支持不一致，请直接打开或下载 PDF。</p>
    <div>
      <a
        class="button button--primary"
        href={pdfUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`在浏览器中打开${title} PDF`}>在浏览器中打开 PDF</a
      >
      <a class="button button--quiet" href={pdfUrl} download aria-label={`下载${title} PDF`}>
        下载 PDF
      </a>
    </div>
  </div>
</section>

<style>
  .pdf-viewer {
    scroll-margin-top: 7rem;
  }

  header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.25rem;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.7rem, 3vw, 2.35rem);
  }

  header p {
    margin: 0.45rem 0 0;
    color: var(--text-secondary);
    font-size: 0.82rem;
  }

  header > a {
    flex: 0 0 auto;
  }

  object {
    display: block;
    width: 100%;
    height: min(850px, calc(100dvh - 7rem));
    min-height: 620px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-solid);
  }

  .pdf-viewer__fallback {
    display: grid;
    min-height: 18rem;
    place-items: center;
    padding: 2rem;
    text-align: center;
  }

  .pdf-viewer__mobile {
    display: none;
  }

  @media (max-width: 700px) {
    header {
      align-items: start;
      flex-direction: column;
    }

    object {
      display: none;
    }

    .pdf-viewer__mobile {
      display: grid;
      gap: 1rem;
      padding: 1.25rem;
      border: 1px solid var(--border-strong);
      border-radius: var(--radius-md);
      background: var(--surface-warm);
    }

    .pdf-viewer__mobile p {
      margin: 0;
      color: var(--text-secondary);
      font-size: 0.88rem;
      line-height: 1.75;
    }

    .pdf-viewer__mobile > div {
      display: grid;
      gap: 0.65rem;
    }

    .pdf-viewer__mobile .button {
      justify-content: center;
      text-align: center;
    }
  }
</style>
