---
import { siteConfig } from '../config/site';
---

<section class="section contact-section" id="contact">
  <div class="shell">
    <div class="contact-panel" data-reveal>
      <div class="contact-copy">
        <span class="eyebrow light"><i aria-hidden="true"></i>LET'S CONNECT</span>
        <h2>寻找能把 AI 能力，变成真实用户价值的机会。</h2>
        <p>目标岗位：AI 产品经理 / 大模型产品经理 / 游戏 AI / AI Agent / 智能座舱 AI</p>
        <div class="availability">
          <span class="status-dot"></span><strong>{siteConfig.status}</strong>
        </div>
      </div>
      <div class="contact-actions">
        <div class="email-card">
          <span>EMAIL</span>
          <strong data-email>{siteConfig.email}</strong>
          <button class="copy-button" type="button" data-copy-email aria-label="复制邮箱地址">
            <span data-copy-label>复制邮箱</span>
          </button>
        </div>
        <div class="contact-link-grid">
          <a href={siteConfig.github} target="_blank" rel="noreferrer"
            ><span>GITHUB</span><strong>查看公开项目</strong><i>↗</i></a
          >
          <a href="/resume"><span>RESUME</span><strong>在线简历</strong><i>→</i></a>
          <a href="/resume"><span>DOWNLOAD</span><strong>下载定向简历</strong><i>↓</i></a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((button) => {
    button.addEventListener('click', async () => {
      const email = button
        .closest('.email-card')
        ?.querySelector<HTMLElement>('[data-email]')
        ?.textContent?.trim();
      const label = button.querySelector<HTMLElement>('[data-copy-label]');
      if (!email || !label) return;

      try {
        await navigator.clipboard.writeText(email);
        label.textContent = '邮箱已复制';
      } catch {
        const selection = window.getSelection();
        const range = document.createRange();
        const emailNode = button.closest('.email-card')?.querySelector<HTMLElement>('[data-email]');
        if (emailNode) {
          range.selectNodeContents(emailNode);
          selection?.removeAllRanges();
          selection?.addRange(range);
          label.textContent = '请手动复制';
        }
      }
      window.setTimeout(() => (label.textContent = '复制邮箱'), 1800);
    });
  });
</script>
