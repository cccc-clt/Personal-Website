---
interface Props {
  title: string;
  context: 'article' | 'reader';
  webUrl: string;
  pdfUrl?: string;
  readerUrl?: string;
}

const { title, context, webUrl, pdfUrl, readerUrl } = Astro.props;
---

<div class="pdf-actions" aria-label={`${title} PDF 操作`}>
  {
    context === 'article' ? (
      <>
        <a class="button button--primary" href={webUrl} aria-current="page">
          网页阅读
        </a>
        {readerUrl && (
          <a class="button" href={readerUrl} aria-label={`阅读${title}的 PDF 版本`}>
            PDF 阅读
          </a>
        )}
        {pdfUrl && (
          <a class="button button--quiet" href={pdfUrl} download aria-label={`下载${title} PDF`}>
            下载 PDF
          </a>
        )}
      </>
    ) : (
      <>
        <a class="button" href={webUrl} aria-label={`返回${title}网页阅读`}>
          返回网页阅读
        </a>
        {pdfUrl && (
          <a
            class="button button--primary"
            href={pdfUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`在浏览器中打开${title} PDF`}
          >
            在浏览器中打开 PDF
          </a>
        )}
        {pdfUrl && (
          <a class="button button--quiet" href={pdfUrl} download aria-label={`下载${title} PDF`}>
            下载 PDF
          </a>
        )}
      </>
    )
  }
</div>

<style>
  .pdf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    align-items: center;
  }

  .pdf-actions .button {
    min-height: 44px;
    padding: 0.66rem 0.9rem;
    font-size: 0.76rem;
  }

  @media (max-width: 560px) {
    .pdf-actions {
      align-items: stretch;
    }

    .pdf-actions .button {
      flex: 1 1 8.5rem;
      justify-content: center;
      text-align: center;
    }
  }
</style>
