---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { siteConfig } from '../config/site';
import { avatarConfig } from '../config/visualAssets';
import { careerDirections } from '../data/siteContent';

const publicAssetExists = (assetPath: string) =>
  existsSync(join(process.cwd(), 'public', assetPath.replace(/^\//, '')));
const hasAvatar = publicAssetExists(avatarConfig.image);
const downloadableResume = siteConfig.resumes.find((item) => publicAssetExists(item.path));
const hasEmail = Boolean(siteConfig.email);
---

<section class="profile-card panel" aria-labelledby="profile-card-name">
  <header class="profile-card__identity">
    <div class="profile-card__avatar">
      {
        hasAvatar ? (
          <img
            src={avatarConfig.image}
            width={avatarConfig.width}
            height={avatarConfig.height}
            alt={avatarConfig.alt}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        ) : (
          <span aria-hidden="true">TQ</span>
        )
      }
    </div>

    <div class="profile-card__name">
      <h2 id="profile-card-name">{siteConfig.name}</h2>
      <p class="profile-card__english">{siteConfig.englishName}</p>
      <p class="profile-card__role">游戏 AI 产品经理<br />AI 应用产品经理</p>
    </div>
  </header>

  <p class="profile-card__status">
    <i aria-hidden="true"></i>
    <span>{siteConfig.availability}</span>
  </p>

  <blockquote>
    <p>{siteConfig.signature}</p>
  </blockquote>

  <dl class="profile-card__facts">
    <div>
      <dt>专业背景</dt>
      <dd>{siteConfig.major}本科生</dd>
    </div>
    <div>
      <dt>实践主线</dt>
      <dd>需求 · 原型 · 评测 · 迭代</dd>
    </div>
  </dl>

  <div class="profile-card__directions">
    <p>核心方向</p>
    <ul aria-label="核心方向">
      {careerDirections.map((item) => <li>{item}</li>)}
    </ul>
  </div>

  <nav class="profile-card__links" aria-label="个人链接">
    <a class="profile-card__link profile-card__link--primary" href="/resume/">
      <span>在线简历</span><i aria-hidden="true">→</i>
    </a>
    <a class="profile-card__link" href={siteConfig.github} target="_blank" rel="noreferrer">
      <span>GitHub</span><i aria-hidden="true">↗</i>
    </a>
    {
      hasEmail && (
        <a class="profile-card__link" href={`mailto:${siteConfig.email}`}>
          <>
            <span>Email</span>
            <i aria-hidden="true">↗</i>
          </>
        </a>
      )
    }
    {
      downloadableResume && (
        <a class="profile-card__link" href={downloadableResume.path} download>
          <>
            <span>PDF 简历</span>
            <i aria-hidden="true">↓</i>
          </>
        </a>
      )
    }
  </nav>
</section>

<style>
  .profile-card {
    --profile-body: color-mix(in srgb, var(--text-main) 78%, var(--surface-solid));
    position: relative;
    overflow: hidden;
    padding: 1.15rem;
    border-color: color-mix(in srgb, var(--primary) 16%, var(--border));
    border-radius: 16px;
    background:
      radial-gradient(
        circle at 92% 3%,
        color-mix(in srgb, var(--violet) 13%, transparent),
        transparent 8rem
      ),
      color-mix(in srgb, var(--surface-solid) 94%, var(--primary-soft));
    box-shadow: 0 6px 14px color-mix(in srgb, var(--text-main) 8%, transparent);
    text-align: left;
    backdrop-filter: none;
  }

  .profile-card__identity {
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr);
    gap: 0.85rem;
    align-items: center;
    text-align: left;
  }

  .profile-card__avatar {
    display: grid;
    width: 80px;
    height: 80px;
    place-items: center;
    margin: 0;
    overflow: hidden;
    border-radius: 16px;
    background: color-mix(in srgb, var(--primary-soft) 78%, var(--surface-solid));
    color: var(--primary-strong);
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 700;
    outline: 1px solid color-mix(in srgb, var(--primary) 22%, transparent);
    outline-offset: 3px;
  }

  .profile-card__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .profile-card h2 {
    margin: 0;
    color: var(--text-main);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .profile-card__english {
    margin: 0.22rem 0 0;
    color: var(--profile-body);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.4;
  }

  .profile-card__role {
    margin: 0.45rem 0 0;
    color: var(--text-main);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.55;
  }

  .profile-card__status {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    margin: 0.9rem 0 0;
    padding: 0.65rem 0.7rem;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--mint) 13%, transparent);
    color: color-mix(in srgb, var(--text-main) 84%, var(--mint));
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.55;
  }

  .profile-card__status i {
    width: 8px;
    height: 8px;
    flex: 0 0 auto;
    margin-top: 0.42rem;
    border-radius: 50%;
    background: var(--mint);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--mint) 18%, transparent);
  }

  blockquote {
    margin: 0.85rem 0 0;
    padding: 0.75rem 0;
    border-block: 1px solid var(--border);
    color: var(--profile-body);
  }

  blockquote p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.75;
    text-wrap: pretty;
  }

  .profile-card__facts {
    margin: 0;
  }

  .profile-card__facts div {
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--border);
  }

  .profile-card__facts dt,
  .profile-card__directions > p {
    margin: 0;
    color: var(--profile-body);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.45;
  }

  .profile-card__facts dd {
    margin: 0.32rem 0 0;
    color: var(--text-main);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.55;
  }

  .profile-card__directions {
    padding-top: 0.75rem;
  }

  .profile-card__directions ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding: 0;
    margin: 0.5rem 0 0;
    list-style: none;
  }

  .profile-card__directions li {
    padding: 0.35rem 0.5rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--primary-soft) 70%, transparent);
    color: var(--profile-body);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .profile-card__links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.45rem;
    margin-top: 0.9rem;
  }

  .profile-card__link {
    display: flex;
    min-height: 46px;
    gap: 0.3rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 0.55rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--surface-solid) 76%, transparent);
    color: var(--text-main);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.25;
    transition:
      border-color 200ms ease,
      background-color 200ms ease,
      color 200ms ease,
      transform 220ms var(--ease-out);
  }

  .profile-card__link--primary {
    border-color: var(--text-main);
    background: var(--text-main);
    color: var(--surface-solid);
  }

  .profile-card__link i {
    display: none;
    font-style: normal;
    transition: transform 200ms var(--ease-out);
  }

  .profile-card__link:hover {
    border-color: color-mix(in srgb, var(--primary) 58%, var(--border-strong));
    background: color-mix(in srgb, var(--primary-soft) 72%, var(--surface-solid));
    color: var(--text-main);
    transform: translateY(-2px);
  }

  .profile-card__link--primary:hover {
    border-color: color-mix(in srgb, var(--text-main) 88%, var(--primary));
    background: color-mix(in srgb, var(--text-main) 88%, var(--primary));
    color: var(--surface-solid);
  }

  .profile-card__link:hover i {
    transform: translate(2px, -1px);
  }

  .profile-card__link:active {
    transform: translateY(0) scale(0.98);
  }

  .profile-card__link:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--primary-strong) 58%, transparent);
    outline-offset: 3px;
  }

  @media (max-width: 760px) {
    .profile-card {
      padding: 1.25rem;
    }

    .profile-card__identity {
      grid-template-columns: 92px minmax(0, 1fr);
      gap: 1rem;
    }

    .profile-card__avatar {
      width: 92px;
      height: 92px;
      margin: 0;
    }

    .profile-card h2 {
      margin-top: 0;
    }

    .profile-card__role {
      margin-top: 0.5rem;
    }

    .profile-card__facts {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      border-bottom: 1px solid var(--border);
    }

    .profile-card__facts div {
      border-bottom: 0;
    }

    .profile-card__facts div + div {
      padding-left: 1rem;
      border-left: 1px solid var(--border);
    }

    .profile-card__facts dt,
    .profile-card__directions > p,
    .profile-card__directions li {
      font-size: 0.875rem;
    }

    .profile-card__link {
      font-size: 0.875rem;
    }

    .profile-card__link i {
      display: inline;
    }
  }

  @media (max-width: 360px) {
    .profile-card__identity {
      grid-template-columns: 80px minmax(0, 1fr);
      gap: 0.85rem;
    }

    .profile-card__avatar {
      width: 80px;
      height: 80px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .profile-card__link,
    .profile-card__link i {
      transition: none;
    }
  }
</style>
