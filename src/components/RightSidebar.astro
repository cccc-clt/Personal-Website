---
import { getCollection } from 'astro:content';
import { careerDirections, featuredProjectLinks, toolStack } from '../data/siteContent';

const projectCount = String((await getCollection('projects')).length).padStart(2, '0');
const directionCount = String(careerDirections.length).padStart(2, '0');
---

<section class="widget panel">
  <span class="eyebrow">CURRENT STATUS</span>
  <h2>开放实习与<br />2027 秋招机会</h2>
  <ul>{careerDirections.map((item) => <li>{item}</li>)}</ul>
</section>

<section class="widget widget--facts panel">
  <span class="eyebrow">PRACTICE SNAPSHOT</span>
  <dl>
    <div><dt>{projectCount}</dt><dd>已整理的真实项目</dd></div>
    <div><dt>{directionCount}</dt><dd>当前关注方向</dd></div>
    <div><dt>RAG</dt><dd>已完成原型实践</dd></div>
    <div><dt>Agent</dt><dd>持续实践与评测</dd></div>
  </dl>
</section>

<section class="widget panel">
  <div class="widget__heading">
    <span class="eyebrow">MY TOOLKIT</span><a href="/stack/">全部 ↗</a>
  </div>
  <div class="tool-cloud">
    {
      toolStack
        .slice(0, 8)
        .map((tool) => <span>{tool.name.replace(' 工作流', '').replace(' 原型', '')}</span>)
    }
  </div>
</section>

<section class="widget panel">
  <span class="eyebrow">FEATURED PROJECTS</span>
  <ol>
    {
      featuredProjectLinks.map((item) => (
        <li>
          <>
            <small>{item.type}</small>
            <a href={item.href}>{item.title}</a>
          </>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .widget {
    padding: 1.15rem;
  }
  .widget h2 {
    margin: 0.85rem 0 1rem;
    font-size: 1.1rem;
    line-height: 1.45;
  }
  .widget ul {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.4rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .widget li {
    color: var(--text-secondary);
    font-size: 0.7rem;
  }
  .widget ul li::before {
    margin-right: 0.3rem;
    color: var(--primary);
    content: '·';
  }
  .widget--facts dl {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.7rem;
    margin: 0.9rem 0 0;
  }
  .widget--facts dl div {
    padding: 0.65rem;
    border-radius: 11px;
    background: var(--surface-soft);
  }
  .widget--facts dt {
    color: var(--primary-strong);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 700;
  }
  .widget--facts dd {
    margin: 0.15rem 0 0;
    color: var(--text-muted);
    font-size: 0.56rem;
    line-height: 1.5;
  }
  .widget__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }
  .widget__heading a {
    color: var(--text-muted);
    font-size: 0.62rem;
  }
  .tool-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.38rem;
    margin-top: 0.9rem;
  }
  .tool-cloud span {
    padding: 0.4rem 0.5rem;
    border-radius: 9px;
    background: var(--primary-soft);
    color: var(--text-secondary);
    font-size: 0.62rem;
  }
  ol {
    padding: 0;
    margin: 0.75rem 0 0;
    list-style: none;
  }
  ol li {
    display: grid;
    gap: 0.18rem;
    padding: 0.7rem 0;
    border-top: 1px solid var(--border);
  }
  ol small {
    color: var(--text-muted);
    font-size: 0.55rem;
  }
  ol a {
    line-height: 1.5;
  }
</style>
