---
import type { CollectionEntry } from 'astro:content';
import { researchCategoryLabels } from '../config/site';
import { formatPublicationDate, getInsightPath, getInsightPdfPath } from '../utils/content';
import PdfActions from './PdfActions.astro';

interface Props {
  article: CollectionEntry<'research'>;
}

const { article } = Astro.props;
const articleUrl = getInsightPath(article);
const pdfReaderUrl = article.data.pdfUrl ? getInsightPdfPath(article) : undefined;
const visibleTags = article.data.tags.slice(0, 3);
---

<header class="article-header page-shell reveal">
  <a class="article-header__back" href="/insights/">← 返回“随笔与研究”</a>

  <div class="article-header__taxonomy" aria-label="文章分类与标签">
    <span class="article-header__category">{researchCategoryLabels[article.data.category]}</span>
    {visibleTags.map((tag) => <span>{tag}</span>)}
  </div>

  <h1>{article.data.title}</h1>
  {article.data.subtitle && <p class="article-header__subtitle">{article.data.subtitle}</p>}
  <p class="article-header__summary">{article.data.description}</p>

  <dl class="article-header__meta" aria-label="文章信息">
    <div>
      <dt>发布时间</dt>
      <dd>
        <time datetime={article.data.publishDate}>
          {formatPublicationDate(article.data.publishDate)}
        </time>
      </dd>
    </div>
    <div>
      <dt>阅读时间</dt>
      <dd>{article.data.readingTime}</dd>
    </div>
    {
      article.data.pageCount && (
        <div>
          <dt>PDF 页数</dt>
          <dd>{article.data.pageCount} 页</dd>
        </div>
      )
    }
  </dl>

  <div data-pagefind-ignore>
    <PdfActions
      title={article.data.title}
      context="article"
      webUrl={articleUrl}
      pdfUrl={article.data.pdfUrl}
      readerUrl={pdfReaderUrl}
    />
  </div>

  <slot />
</header>

<style>
  .article-header {
    display: grid;
    gap: 1.15rem;
    max-width: 1040px;
    padding-block: clamp(6.7rem, 11vw, 9.5rem) clamp(3.2rem, 6vw, 5rem);
  }

  .article-header__back {
    width: fit-content;
    color: var(--text-secondary);
    font-size: 0.8rem;
  }

  .article-header__back:hover {
    color: var(--accent-hover);
  }

  .article-header__taxonomy {
    display: flex;
    flex-wrap: wrap;
    gap: 0.48rem;
    margin-top: 0.5rem;
  }

  .article-header__taxonomy span {
    padding: 0.34rem 0.64rem;
    border-radius: var(--radius-pill);
    background: var(--surface-soft);
    color: var(--text-secondary);
    font-size: 0.72rem;
    line-height: 1.2;
  }

  .article-header__taxonomy .article-header__category {
    background: var(--accent-soft);
    color: var(--accent-hover);
    font-weight: 650;
  }

  h1 {
    max-width: 19ch;
    margin: 0.5rem 0 0;
    font-size: clamp(2.55rem, 6vw, 4.8rem);
    letter-spacing: -0.028em;
    line-height: 1.1;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .article-header__subtitle {
    max-width: 62ch;
    margin: 0;
    color: var(--text-secondary);
    font-family: var(--font-display);
    font-size: clamp(1.12rem, 2.2vw, 1.48rem);
    font-weight: 560;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .article-header__summary {
    max-width: 70ch;
    margin: 0.15rem 0 0;
    color: var(--text-secondary);
    font-size: clamp(0.98rem, 1.4vw, 1.08rem);
    line-height: 1.8;
    text-wrap: pretty;
  }

  .article-header__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin: 0.45rem 0 0;
  }

  .article-header__meta > div {
    display: grid;
    gap: 0.2rem;
  }

  .article-header__meta dt,
  .article-header__meta dd {
    margin: 0;
    font-size: 0.76rem;
  }

  .article-header__meta dt {
    color: var(--text-muted);
  }

  .article-header__meta dd {
    color: var(--text-primary);
    font-weight: 620;
  }

  @media (max-width: 680px) {
    .article-header {
      gap: 1rem;
      padding-top: 5.4rem;
    }

    h1 {
      max-width: 100%;
      font-size: clamp(2.15rem, 10.5vw, 3.25rem);
      line-height: 1.14;
    }

    .article-header__meta {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.8rem 1rem;
    }
  }

  @media (max-width: 360px) {
    .article-header__meta {
      grid-template-columns: 1fr;
    }
  }
</style>
