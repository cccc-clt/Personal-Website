---
import { siteConfig } from '../config/site';
import { heroAssetConfig } from '../config/visualAssets';
---

<section class="home-hero" aria-labelledby="home-title">
  <div class="page-shell home-hero__grid">
    <div class="home-hero__copy" data-reveal-group>
      <p class="home-hero__status hero-reveal reveal">
        <span aria-hidden="true"></span>
        {siteConfig.availability}
      </p>
      <p class="home-hero__name hero-reveal reveal">{siteConfig.name}</p>
      <h1 id="home-title" class="hero-reveal reveal">
        <span>游戏 AI</span>
        <span>产品经理</span>
      </h1>
      <p class="home-hero__description hero-reveal reveal">
        从真实用户任务出发，把需求判断、Agent 工作流、人工节点与产品评测，
        推进为可运行、可回看、可迭代的原型。
      </p>
      <div class="home-hero__actions hero-reveal reveal" aria-label="主要行动">
        <a class="button button--primary" href="#featured-projects">查看精选项目</a>
        <a class="button" href="/resume/">查看简历</a>
        <a class="home-hero__github" href={siteConfig.github} target="_blank" rel="noreferrer">
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <figure class="home-hero__visual hero-reveal reveal" style="--reveal-delay: 450ms">
      <div>
        <img
          src={heroAssetConfig.backgroundImage}
          width="1672"
          height="941"
          alt="蓝色深海中的原创幻想角色品牌插图"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <figcaption>个人视觉 · 用于品牌表达</figcaption>
    </figure>
  </div>
</section>

<style>
  .home-hero {
    display: flex;
    min-height: clamp(680px, 78svh, 748px);
    align-items: center;
    padding: clamp(7.25rem, 9vw, 8.25rem) 0 clamp(3.75rem, 5.5vw, 5.25rem);
  }

  .home-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(390px, 0.92fr);
    gap: clamp(4rem, 5.2vw, 4.75rem);
    align-items: center;
  }

  .home-hero__copy {
    max-width: 680px;
  }

  .home-hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0 0 1.9rem;
    color: var(--accent-hover);
    font-size: 0.84rem;
    font-weight: 600;
  }

  .home-hero__status span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  .home-hero__name {
    margin: 0 0 0.7rem;
    color: var(--text-secondary);
    font-size: 0.94rem;
    font-weight: 600;
  }

  h1 {
    max-width: 9ch;
    margin: 0;
    font-size: clamp(3.65rem, 5.6vw, 4.5rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.06;
    text-wrap: balance;
  }

  h1 span {
    display: block;
  }

  .home-hero__description {
    max-width: 31rem;
    margin: 2rem 0 0;
    color: var(--text-secondary);
    font-size: clamp(1rem, 1.35vw, 1.1rem);
    line-height: 1.78;
    text-wrap: pretty;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1rem;
    align-items: center;
    margin-top: 2.25rem;
  }

  .home-hero__actions .button {
    box-shadow: 0 2px 6px transparent;
    transition:
      translate 280ms var(--ease-out),
      background-color 280ms ease,
      border-color 280ms ease,
      color 280ms ease,
      box-shadow 280ms ease;
  }

  .home-hero__actions .button:hover {
    box-shadow: 0 3px 8px rgba(40, 32, 24, 0.08);
  }

  .home-hero__github {
    position: relative;
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    gap: 0.35rem;
    padding-inline: 0.35rem;
    color: var(--text-secondary);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .home-hero__github::after {
    position: absolute;
    right: 0.35rem;
    bottom: 0.6rem;
    left: 0.35rem;
    height: 1px;
    background: var(--accent);
    content: '';
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 280ms var(--ease-out);
  }

  .home-hero__github:hover {
    color: var(--accent-hover);
  }

  .home-hero__github:hover::after {
    transform: scaleX(1);
  }

  .home-hero__visual {
    width: min(100%, 570px);
    margin: 0;
    justify-self: end;
  }

  .home-hero__visual > div {
    aspect-ratio: 4 / 3;
    padding: 9px;
    overflow: hidden;
    border-radius: 22px;
    background: color-mix(in srgb, var(--surface-solid) 82%, transparent);
    box-shadow:
      0 3px 10px rgba(40, 32, 24, 0.035),
      0 18px 48px rgba(40, 32, 24, 0.075);
  }

  .home-hero__visual img {
    width: 100%;
    height: 100%;
    border-radius: 14px;
    object-fit: cover;
    object-position: 44% center;
    filter: saturate(0.66) contrast(0.94) brightness(1.08);
    transition:
      transform 300ms var(--ease-out),
      filter 300ms ease;
  }

  .home-hero__visual:hover img {
    filter: saturate(0.74) contrast(0.96) brightness(1.05);
    transform: scale(1.015);
  }

  figcaption {
    margin-top: 0.7rem;
    padding-inline: 0.25rem;
    color: var(--text-muted);
    font-size: 0.68rem;
    letter-spacing: 0.02em;
    line-height: 1.5;
  }

  @media (max-height: 780px) and (min-width: 901px) {
    .home-hero {
      min-height: 680px;
      padding: 6.75rem 0 3.5rem;
    }

    .home-hero__status {
      margin-bottom: 1.25rem;
    }

    .home-hero__description {
      margin-top: 1.5rem;
      line-height: 1.7;
    }

    .home-hero__actions {
      margin-top: 1.75rem;
    }
  }

  @media (max-width: 900px) {
    .home-hero {
      min-height: auto;
      padding: 7.75rem 0 4.75rem;
    }

    .home-hero__grid {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }

    .home-hero__visual {
      width: min(100%, 720px);
      justify-self: start;
    }

    .home-hero__visual > div {
      aspect-ratio: 16 / 9;
    }
  }

  @media (max-width: 520px) {
    .home-hero {
      padding: 7rem 0 4rem;
    }

    .home-hero__status {
      margin-bottom: 1.4rem;
      font-size: 0.78rem;
    }

    h1 {
      font-size: clamp(3.1rem, 15vw, 3.75rem);
    }

    .home-hero__description {
      margin-top: 1.6rem;
    }

    .home-hero__actions {
      align-items: stretch;
      flex-direction: column;
      margin-top: 1.9rem;
    }

    .home-hero__actions .button {
      width: 100%;
      justify-content: center;
    }

    .home-hero__github {
      width: max-content;
      min-height: 44px;
      justify-content: flex-start;
    }

    .home-hero__github::after {
      right: 0.35rem;
      left: 0.35rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.reveal-ready) .home-hero .hero-reveal {
      transition-duration: 620ms;
    }

    :global(html.reveal-ready) .home-hero .hero-reveal:not(.is-visible) {
      filter: none;
      transform: translateY(12px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__visual img,
    .home-hero__visual:hover img,
    .home-hero__github::after {
      transition: none;
      transform: none;
    }
  }
</style>
