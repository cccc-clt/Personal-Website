---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { siteConfig } from '../config/site';
import { heroAssetConfig, heroCharacterConfig } from '../config/visualAssets';

const publicRoot = join(process.cwd(), 'public');
const publicAssetExists = (assetPath: string) => existsSync(join(publicRoot, assetPath.replace(/^\//, '')));
const hasHeroBackground = publicAssetExists(heroAssetConfig.backgroundImage);
const hasCharacter = publicAssetExists(heroCharacterConfig.image);
const resume = siteConfig.resumes[0];
const hasResume = publicAssetExists(resume.path);
---

<section
  class:list={[
    'home-banner',
    {
      'home-banner--fallback': !hasHeroBackground,
      'home-banner--character-mobile-hidden': hasCharacter && heroCharacterConfig.hideOnMobile,
    },
  ]}
  aria-labelledby="home-title"
>
  <div class="home-banner__media" aria-hidden="true">
    {
      hasHeroBackground && (
        <img
          src={heroAssetConfig.backgroundImage}
          width="1920"
          height="900"
          alt=""
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      )
    }
  </div>

  <div class="home-banner__veil" aria-hidden="true"></div>
  <div class="home-banner__ornaments" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>

  <div class="page-shell home-banner__content">
    <div class="home-banner__copy">
      <p class="home-banner__eyebrow"><span aria-hidden="true"></span> GAME AI PRODUCT PORTFOLIO · 2026</p>
      <h1 id="home-title">赵天琦 <span>Tianqi Z.</span></h1>
      <p class="home-banner__identity">AI Product Explorer</p>
      <p class="home-banner__role">游戏 AI 产品方向 · AI Agent 产品实践</p>
      <p class="home-banner__description">
        从复杂系统的分析方法出发，持续探索角色表达、内容创造与智能体交互，<br class="home-banner__desktop-break" />
        把想法推进为可运行、可验证、可迭代的 AI 产品原型。
      </p>

      <div class="home-banner__actions">
        <a class="banner-button banner-button--primary" href="/projects/">查看作品集 <small>ENTER</small></a>
        {
          hasResume ? (
            <a class="banner-button" href={resume.path} download>下载简历 <small>LOAD PDF</small></a>
          ) : (
            <a class="banner-button" href="/resume/">在线简历 <small>VIEW PROFILE</small></a>
          )
        }
      </div>

      <ul class="home-banner__topics" aria-label="AI 产品实践方向">
        <li>Prompt</li>
        <li>Agent</li>
        <li>RAG</li>
        <li>Evaluation</li>
      </ul>
    </div>

    <div class:list={['character-stage', { 'character-stage--ready': hasCharacter }]}>
      <div class="character-stage__halo" aria-hidden="true"></div>
      <div class="character-stage__frame">
        <span class="character-stage__index">{heroCharacterConfig.status}</span>
        <div class="character-stage__core">
          {
            hasCharacter ? (
              <img
                class="character-stage__image"
                src={heroCharacterConfig.image}
                width={heroCharacterConfig.width}
                height={heroCharacterConfig.height}
                alt={heroCharacterConfig.alt}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <i aria-hidden="true"></i>
            )
          }
        </div>
        <div class="character-stage__caption">
          <strong>{heroCharacterConfig.name}</strong>
          <span>{heroCharacterConfig.description}</span>
        </div>
      </div>
      <span class="character-stage__spark character-stage__spark--one" aria-hidden="true"></span>
      <span class="character-stage__spark character-stage__spark--two" aria-hidden="true"></span>
      <span class="character-stage__diamond" aria-hidden="true"></span>
    </div>
  </div>

  <div class="home-banner__transition" aria-hidden="true"></div>
</section>

<style>
  .home-banner {
    --hero-ink: #fff;
    --hero-muted: rgba(255, 255, 255, 0.78);
    --hero-line: rgba(255, 255, 255, 0.34);
    position: relative;
    min-height: 620px;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(circle at 78% 35%, rgba(255, 244, 231, 0.78), transparent 19rem),
      linear-gradient(125deg, #8ebed7 0%, #b8b4dc 50%, #ddb2b3 100%);
  }

  .home-banner--fallback {
    --hero-ink: var(--text-main);
    --hero-muted: var(--text-secondary);
    --hero-line: color-mix(in srgb, var(--text-main) 17%, transparent);
    background:
      radial-gradient(circle at 76% 40%, color-mix(in srgb, var(--surface-solid) 88%, transparent) 0 12rem, transparent 28rem),
      radial-gradient(circle at 13% 74%, color-mix(in srgb, var(--pink) 30%, transparent), transparent 25rem),
      radial-gradient(circle at 58% 2%, color-mix(in srgb, var(--violet) 24%, transparent), transparent 22rem),
      linear-gradient(128deg, color-mix(in srgb, var(--page-bg) 78%, white), color-mix(in srgb, var(--primary-soft) 58%, var(--page-bg)) 48%, color-mix(in srgb, var(--pink) 23%, var(--page-bg)));
  }

  .home-banner::before {
    position: absolute;
    z-index: 1;
    inset: 0;
    background-image:
      linear-gradient(var(--hero-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--hero-line) 1px, transparent 1px);
    background-position: center;
    background-size: 72px 72px;
    content: '';
    opacity: 0.08;
    mask-image: radial-gradient(circle at 73% 43%, black, transparent 53%);
  }

  .home-banner__media,
  .home-banner__veil,
  .home-banner__media picture,
  .home-banner__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .home-banner__media img {
    object-fit: cover;
    object-position: center 42%;
  }

  .home-banner__veil {
    z-index: 1;
    background: linear-gradient(90deg, rgba(30, 36, 49, 0.78) 0%, rgba(36, 41, 56, 0.45) 45%, rgba(43, 44, 57, 0.12) 78%);
  }

  .home-banner--fallback .home-banner__veil {
    background:
      linear-gradient(112deg, color-mix(in srgb, var(--surface-solid) 42%, transparent), transparent 48%),
      linear-gradient(0deg, color-mix(in srgb, var(--page-bg) 20%, transparent), transparent 38%);
  }

  .home-banner__content {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(330px, 0.76fr);
    gap: clamp(2rem, 6vw, 6.5rem);
    align-items: center;
    min-height: 620px;
    padding-top: 110px;
    padding-bottom: 118px;
    color: var(--hero-ink);
  }

  .home-banner__copy {
    position: relative;
    z-index: 2;
    max-width: 790px;
  }

  .home-banner__eyebrow {
    display: flex;
    gap: 0.62rem;
    align-items: center;
    margin: 0 0 1.15rem;
    color: var(--hero-muted);
    font-family: var(--font-mono);
    font-size: 0.63rem;
    letter-spacing: 0.13em;
  }

  .home-banner__eyebrow span {
    width: 8px;
    height: 8px;
    border: 1px solid currentColor;
    rotate: 45deg;
  }

  h1 {
    margin: 0;
    color: var(--hero-ink);
    font-size: clamp(3.4rem, 6.5vw, 6.6rem);
    font-weight: 760;
    letter-spacing: -0.075em;
    line-height: 0.94;
    text-wrap: balance;
    text-shadow: 0 18px 46px color-mix(in srgb, var(--hero-ink) 13%, transparent);
  }

  h1 span {
    display: block;
    margin-top: 0.78rem;
    font-family: var(--font-en);
    font-size: clamp(0.95rem, 1.75vw, 1.45rem);
    font-weight: 600;
    letter-spacing: 0.16em;
    line-height: 1;
    opacity: 0.58;
    text-transform: uppercase;
  }

  .home-banner__identity {
    display: inline-flex;
    align-items: center;
    margin: 1.45rem 0 0;
    padding: 0.48rem 0.8rem;
    border: 1px solid var(--hero-line);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--surface-solid) 22%, transparent);
    font-family: var(--font-en);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    backdrop-filter: blur(12px);
  }

  .home-banner__role {
    margin: 1rem 0 0;
    font-size: clamp(0.92rem, 1.5vw, 1.08rem);
    font-weight: 760;
    letter-spacing: 0.02em;
  }

  .home-banner__description {
    max-width: 690px;
    margin: 0.72rem 0 0;
    color: var(--hero-muted);
    font-size: 0.88rem;
    line-height: 1.85;
  }

  .home-banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.72rem;
    margin-top: 1.45rem;
  }

  .banner-button {
    display: inline-flex;
    gap: 0.7rem;
    align-items: baseline;
    padding: 0.76rem 1rem;
    border: 1px solid var(--hero-line);
    border-radius: 15px;
    background: color-mix(in srgb, var(--surface-solid) 18%, transparent);
    color: var(--hero-ink);
    font-size: 0.8rem;
    font-weight: 750;
    box-shadow: 0 10px 28px color-mix(in srgb, var(--text-main) 10%, transparent);
    backdrop-filter: blur(14px);
    transition:
      transform 220ms var(--ease-out),
      border-color 220ms ease,
      background 220ms ease,
      box-shadow 220ms ease;
  }

  .banner-button--primary {
    border-color: color-mix(in srgb, var(--surface-solid) 82%, transparent);
    background: var(--surface-solid);
    color: var(--text-main);
  }

  .banner-button small {
    opacity: 0.52;
    font-family: var(--font-mono);
    font-size: 0.51rem;
  }

  .banner-button:hover {
    border-color: color-mix(in srgb, var(--primary) 55%, var(--hero-line));
    background: color-mix(in srgb, var(--surface-solid) 35%, transparent);
    box-shadow: 0 15px 34px color-mix(in srgb, var(--text-main) 14%, transparent);
    transform: translateY(-3px);
  }

  .banner-button--primary:hover {
    background: color-mix(in srgb, var(--surface-solid) 88%, var(--primary-soft));
  }

  .banner-button:focus-visible {
    outline: 2px solid var(--primary-strong);
    outline-offset: 4px;
  }

  .home-banner__topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.58rem;
    padding: 0;
    margin: 1.25rem 0 0;
    list-style: none;
  }

  .home-banner__topics li {
    padding: 0.28rem 0.52rem;
    border-left: 1px solid var(--hero-line);
    color: var(--hero-muted);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.06em;
  }

  .character-stage {
    position: relative;
    min-height: 420px;
    perspective: 1000px;
  }

  .character-stage::before,
  .character-stage::after {
    position: absolute;
    border-radius: 50%;
    content: '';
    pointer-events: none;
  }

  .character-stage::before {
    inset: 4% 7% 3%;
    border: 1px solid var(--hero-line);
    opacity: 0.5;
    transform: rotate(-8deg);
  }

  .character-stage::after {
    inset: 15% -2% 16% 17%;
    border: 1px dashed var(--hero-line);
    opacity: 0.35;
    transform: rotate(11deg);
  }

  .character-stage__halo {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 92%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--surface-solid) 76%, transparent), color-mix(in srgb, var(--violet) 18%, transparent) 38%, transparent 69%);
    filter: blur(2px);
    opacity: 0.9;
    transform: translate(-50%, -50%);
    animation: hero-glow 5.5s ease-in-out infinite;
  }

  .character-stage__frame {
    position: absolute;
    z-index: 2;
    inset: 16px 32px 28px;
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: 1rem;
    border: 1px solid color-mix(in srgb, var(--surface-solid) 60%, var(--hero-line));
    border-radius: 48% 48% 30px 30px / 24% 24% 30px 30px;
    background:
      linear-gradient(160deg, color-mix(in srgb, var(--surface-solid) 46%, transparent), color-mix(in srgb, var(--surface-solid) 10%, transparent)),
      radial-gradient(circle at 50% 35%, color-mix(in srgb, var(--pink) 20%, transparent), transparent 55%);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--surface-solid) 70%, transparent),
      0 28px 70px color-mix(in srgb, var(--text-main) 17%, transparent);
    backdrop-filter: blur(18px) saturate(1.08);
    transform: rotateY(-4deg) rotateX(1deg);
    animation: hero-float 7s var(--ease-out) infinite;
  }

  .character-stage__index {
    justify-self: center;
    color: var(--hero-muted);
    font-family: var(--font-mono);
    font-size: 0.53rem;
    letter-spacing: 0.13em;
  }

  .character-stage__core {
    position: relative;
    align-self: center;
    justify-self: center;
    width: min(68%, 210px);
    height: 258px;
    border: 1px solid color-mix(in srgb, var(--primary) 34%, var(--hero-line));
    border-radius: 50% 50% 34% 34% / 28% 28% 24% 24%;
    background:
      linear-gradient(145deg, color-mix(in srgb, var(--primary-soft) 56%, transparent), color-mix(in srgb, var(--pink) 18%, transparent)),
      color-mix(in srgb, var(--surface-solid) 16%, transparent);
    box-shadow:
      inset 0 0 40px color-mix(in srgb, var(--surface-solid) 38%, transparent),
      0 16px 42px color-mix(in srgb, var(--violet) 18%, transparent);
    overflow: hidden;
    transition:
      width 260ms var(--ease-out),
      height 260ms var(--ease-out),
      background 260ms ease;
  }

  .character-stage--ready .character-stage__core {
    width: min(82%, 260px);
    height: 330px;
    border-color: color-mix(in srgb, var(--surface-solid) 58%, var(--hero-line));
    background: color-mix(in srgb, var(--surface-solid) 10%, transparent);
  }

  .character-stage--ready .character-stage__core::before,
  .character-stage--ready .character-stage__core::after {
    display: none;
  }

  .character-stage__image {
    position: absolute;
    z-index: 1;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    filter: drop-shadow(0 18px 24px color-mix(in srgb, var(--text-main) 18%, transparent));
  }

  .character-stage__core::before,
  .character-stage__core::after,
  .character-stage__core i::before,
  .character-stage__core i::after {
    position: absolute;
    top: 50%;
    left: 50%;
    background: color-mix(in srgb, var(--hero-ink) 34%, transparent);
    content: '';
    transform: translate(-50%, -50%);
  }

  .character-stage__core::before { width: 1px; height: 88%; }
  .character-stage__core::after { width: 74%; height: 1px; }
  .character-stage__core i::before { width: 1px; height: 23px; rotate: 45deg; }
  .character-stage__core i::after { width: 23px; height: 1px; rotate: 45deg; }

  .character-stage__caption {
    display: grid;
    justify-items: center;
    padding: 0.74rem;
    border: 1px solid var(--hero-line);
    border-radius: 15px;
    background: color-mix(in srgb, var(--surface-solid) 30%, transparent);
    text-align: center;
  }

  .character-stage__caption strong {
    font-size: 0.76rem;
    letter-spacing: 0.05em;
  }

  .character-stage__caption span {
    margin-top: 0.22rem;
    color: var(--hero-muted);
    font-family: var(--font-mono);
    font-size: 0.48rem;
  }

  .character-stage__spark {
    position: absolute;
    z-index: 3;
    width: 1px;
    height: 34px;
    background: var(--hero-ink);
    box-shadow: 0 0 14px color-mix(in srgb, var(--hero-ink) 55%, transparent);
    animation: hero-twinkle 3.8s ease-in-out infinite;
  }

  .character-stage__spark::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 34px;
    height: 1px;
    background: inherit;
    content: '';
    transform: translate(-50%, -50%);
  }

  .character-stage__spark--one { top: 17%; right: 8%; }
  .character-stage__spark--two { bottom: 21%; left: 4%; scale: 0.55; animation-delay: -1.8s; }

  .character-stage__diamond {
    position: absolute;
    z-index: 3;
    top: 10%;
    left: 13%;
    width: 11px;
    height: 11px;
    border: 1px solid var(--hero-ink);
    rotate: 45deg;
    opacity: 0.58;
  }

  .home-banner__ornaments i {
    position: absolute;
    z-index: 2;
    width: 9px;
    height: 9px;
    border: 1px solid var(--hero-line);
    rotate: 45deg;
    opacity: 0.72;
  }

  .home-banner__ornaments i:nth-child(1) { top: 23%; left: 6%; }
  .home-banner__ornaments i:nth-child(2) { top: 16%; left: 54%; scale: 0.65; }
  .home-banner__ornaments i:nth-child(3) { top: 67%; left: 59%; scale: 0.42; }
  .home-banner__ornaments i:nth-child(4) { top: 78%; right: 7%; scale: 0.7; }
  .home-banner__ornaments i:nth-child(5) { top: 36%; right: 2%; scale: 0.38; }

  .home-banner__transition {
    position: absolute;
    z-index: 4;
    right: -5%;
    bottom: -58px;
    left: -5%;
    height: 112px;
    border-radius: 50% 50% 0 0 / 78% 78% 0 0;
    background: var(--page-bg);
    transform: rotate(-0.8deg);
  }

  .home-banner__transition::before {
    position: absolute;
    top: 11px;
    right: 4%;
    left: 4%;
    height: 1px;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--primary) 28%, transparent), transparent);
    content: '';
  }

  :global(:root[data-theme='dark']) .home-banner--fallback {
    background:
      radial-gradient(circle at 76% 40%, color-mix(in srgb, var(--surface-solid) 72%, transparent) 0 11rem, transparent 27rem),
      radial-gradient(circle at 13% 74%, color-mix(in srgb, var(--pink) 17%, transparent), transparent 25rem),
      radial-gradient(circle at 58% 2%, color-mix(in srgb, var(--violet) 18%, transparent), transparent 22rem),
      linear-gradient(128deg, color-mix(in srgb, var(--page-bg) 90%, #222b3d), color-mix(in srgb, var(--primary-soft) 36%, var(--page-bg)) 48%, color-mix(in srgb, var(--pink) 12%, var(--page-bg)));
  }

  @keyframes hero-float {
    0%, 100% { transform: rotateY(-4deg) rotateX(1deg) translateY(0); }
    50% { transform: rotateY(-2deg) rotateX(0deg) translateY(-8px); }
  }

  @keyframes hero-glow {
    0%, 100% { opacity: 0.72; scale: 0.96; }
    50% { opacity: 1; scale: 1.03; }
  }

  @keyframes hero-twinkle {
    0%, 100% { opacity: 0.25; scale: 0.72; }
    45% { opacity: 0.9; scale: 1; }
  }

  @media (max-width: 1080px) {
    .home-banner,
    .home-banner__content { min-height: 570px; }
    .home-banner__content { grid-template-columns: minmax(0, 1fr) minmax(290px, 0.68fr); gap: 2rem; }
    .character-stage { min-height: 370px; }
    .character-stage__frame { inset-inline: 18px; }
    .character-stage__core { height: 220px; }
    .character-stage--ready .character-stage__core { height: 280px; }
  }

  @media (max-width: 760px) {
    .home-banner { min-height: 760px; }
    .home-banner__content {
      grid-template-columns: 1fr;
      gap: 1.3rem;
      min-height: 760px;
      padding-top: 98px;
      padding-bottom: 104px;
    }
    .home-banner__copy { max-width: 620px; }
    .character-stage { min-height: 245px; }
    .character-stage__frame { inset: 0 10% 10px; grid-template-columns: 1fr auto; grid-template-rows: auto 1fr; border-radius: 28px; }
    .character-stage__index { justify-self: start; }
    .character-stage__core { grid-row: 1 / 3; grid-column: 2; width: 115px; height: 175px; }
    .character-stage__caption { align-self: end; justify-items: start; max-width: 230px; text-align: left; }
    .character-stage__halo { width: 58%; left: 72%; }
    .home-banner__media img { object-position: 64% top; }
    .home-banner--character-mobile-hidden,
    .home-banner--character-mobile-hidden .home-banner__content { min-height: 610px; }
    .home-banner--character-mobile-hidden .character-stage { display: none; }
  }

  @media (max-width: 520px) {
    .home-banner { min-height: 735px; }
    .home-banner__content { min-height: 735px; padding-top: 88px; }
    h1 { font-size: clamp(3rem, 15vw, 4.2rem); }
    .home-banner__desktop-break { display: none; }
    .home-banner__description { font-size: 0.8rem; line-height: 1.75; }
    .home-banner__actions { gap: 0.55rem; }
    .banner-button { padding: 0.66rem 0.78rem; }
    .home-banner__topics { gap: 0.35rem; }
    .home-banner__topics li { font-size: 0.52rem; }
    .character-stage { min-height: 215px; }
    .character-stage__frame { inset-inline: 0; }
    .character-stage__core { width: 90px; height: 145px; }
    .character-stage__caption { max-width: 190px; }
    .home-banner--character-mobile-hidden,
    .home-banner--character-mobile-hidden .home-banner__content { min-height: 585px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .character-stage__frame,
    .character-stage__halo,
    .character-stage__spark { animation: none; }
    .banner-button { transition: none; }
  }
</style>
