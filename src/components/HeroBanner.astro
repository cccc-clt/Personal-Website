---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { siteConfig } from '../config/site';
import { profileVisual } from '../config/visualAssets';

const publicRoot = join(process.cwd(), 'public');
const publicAssetExists = (assetPath: string) =>
  existsSync(join(publicRoot, assetPath.replace(/^\//, '')));
const hasProfileVisual = publicAssetExists(profileVisual.image);
const resume = siteConfig.resumes[0];
const hasResume = publicAssetExists(resume.path);
---

<section
  class:list={['home-banner', { 'home-banner--text-only': !hasProfileVisual }]}
  aria-labelledby="home-title"
>
  <div class="home-banner__atmosphere" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
  </div>

  <div class="page-shell home-banner__content">
    <div class="home-banner__copy">
      <p class="home-banner__availability">
        <span aria-hidden="true"></span>
        {siteConfig.availability}
      </p>

      <h1 id="home-title">
        {siteConfig.name}
        <span>{siteConfig.englishName}</span>
      </h1>

      <p class="home-banner__role">
        游戏 AI 产品经理 <span aria-hidden="true">·</span> AI 应用产品经理
      </p>
      <p class="home-banner__description">
        聚焦需求判断、Agent / RAG 工作流、人工确认与产品评测，把想法推进为可运行、可验证、可迭代的
        AI 产品原型。
      </p>

      <div class="home-banner__actions" aria-label="主要行动">
        <a class="banner-button banner-button--primary" href="/projects/">查看代表项目</a>
        {
          hasResume ? (
            <a class="banner-button banner-button--secondary" href={resume.path} download>
              下载简历
            </a>
          ) : (
            <a class="banner-button banner-button--secondary" href="/resume/">
              查看在线简历
            </a>
          )
        }
        <a class="home-banner__github" href={siteConfig.github} target="_blank" rel="noreferrer">
          访问 GitHub <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    {
      hasProfileVisual && (
        <figure class="character-stage">
          <div class="character-stage__halo" aria-hidden="true" />
          <div class="character-stage__frame">
            <img
              src={profileVisual.image}
              width={profileVisual.width}
              height={profileVisual.height}
              alt={profileVisual.alt}
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
          <span class="character-stage__star character-stage__star--one" aria-hidden="true" />
          <span class="character-stage__star character-stage__star--two" aria-hidden="true" />
        </figure>
      )
    }
  </div>
</section>

<style>
  .home-banner {
    --hero-body: color-mix(in srgb, var(--text-main) 82%, var(--page-bg));
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(
        ellipse at 79% 34%,
        color-mix(in srgb, var(--violet) 21%, transparent),
        transparent 43%
      ),
      radial-gradient(
        ellipse at 12% 76%,
        color-mix(in srgb, var(--primary) 17%, transparent),
        transparent 42%
      ),
      radial-gradient(
        ellipse at 52% 4%,
        color-mix(in srgb, var(--pink) 12%, transparent),
        transparent 34%
      ),
      var(--page-bg);
  }

  .home-banner__atmosphere span {
    position: absolute;
    z-index: 0;
    width: 9px;
    height: 9px;
    border: 1px solid color-mix(in srgb, var(--text-main) 28%, transparent);
    rotate: 45deg;
    opacity: 0.52;
  }

  .home-banner__atmosphere span:nth-child(1) {
    top: 19%;
    left: 3.5%;
  }

  .home-banner__atmosphere span:nth-child(2) {
    top: 16%;
    left: 53%;
    scale: 0.62;
  }

  .home-banner__atmosphere span:nth-child(3) {
    right: 4%;
    bottom: 18%;
    scale: 0.78;
  }

  .home-banner__content {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.14fr) minmax(360px, 0.86fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
    min-height: clamp(580px, 47vw, 650px);
    padding-top: clamp(8rem, 10vw, 9.5rem);
    padding-bottom: clamp(5rem, 7vw, 6.5rem);
  }

  .home-banner--text-only .home-banner__content {
    grid-template-columns: minmax(0, 900px);
  }

  .home-banner__copy {
    max-width: 760px;
  }

  .home-banner__availability {
    display: flex;
    gap: 0.7rem;
    align-items: center;
    width: fit-content;
    margin: 0 0 1.35rem;
    color: var(--hero-body);
    font-size: 0.875rem;
    font-weight: 650;
    line-height: 1.5;
  }

  .home-banner__availability span {
    flex: 0 0 auto;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--mint);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--mint) 20%, transparent);
  }

  h1 {
    margin: 0;
    color: var(--text-main);
    font-size: clamp(4rem, 6.6vw, 6rem);
    font-weight: 760;
    letter-spacing: -0.04em;
    line-height: 0.98;
    text-wrap: balance;
  }

  h1 span {
    display: block;
    margin-top: 0.72rem;
    color: color-mix(in srgb, var(--text-main) 70%, var(--page-bg));
    font-family: var(--font-en);
    font-size: clamp(1rem, 1.55vw, 1.3rem);
    font-weight: 650;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
  }

  .home-banner__role {
    margin: 1.65rem 0 0;
    color: var(--text-main);
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    font-weight: 720;
    letter-spacing: -0.02em;
    line-height: 1.35;
    text-wrap: balance;
  }

  .home-banner__role span {
    margin-inline: 0.18em;
    color: var(--violet);
  }

  .home-banner__description {
    max-width: 650px;
    margin: 0.9rem 0 0;
    color: var(--hero-body);
    font-size: 1rem;
    line-height: 1.8;
    text-wrap: pretty;
  }

  .home-banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    margin-top: 1.8rem;
  }

  .banner-button {
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.3rem;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    font-size: 0.9375rem;
    font-weight: 720;
    line-height: 1.2;
    transition:
      transform 220ms var(--ease-out),
      border-color 220ms ease,
      background-color 220ms ease,
      color 220ms ease;
  }

  .banner-button--primary {
    border-color: var(--text-main);
    background: var(--text-main);
    color: var(--surface-solid);
  }

  .banner-button--secondary {
    border-color: var(--border-strong);
    background: color-mix(in srgb, var(--surface-solid) 72%, transparent);
    color: var(--text-main);
  }

  .banner-button:hover {
    transform: translateY(-2px);
  }

  .banner-button--primary:hover {
    border-color: color-mix(in srgb, var(--text-main) 88%, var(--primary));
    background: color-mix(in srgb, var(--text-main) 88%, var(--primary));
  }

  .banner-button--secondary:hover {
    border-color: color-mix(in srgb, var(--primary) 58%, var(--border-strong));
    background: color-mix(in srgb, var(--primary-soft) 72%, var(--surface-solid));
  }

  .banner-button:active {
    transform: translateY(0) scale(0.98);
  }

  .banner-button:focus-visible,
  .home-banner__github:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--primary-strong) 58%, transparent);
    outline-offset: 4px;
  }

  .home-banner__github {
    display: inline-flex;
    min-height: 44px;
    gap: 0.35rem;
    align-items: center;
    padding-inline: 0.35rem;
    color: var(--hero-body);
    font-size: 0.875rem;
    font-weight: 680;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--primary-strong) 42%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
    transition:
      color 180ms ease,
      text-decoration-color 180ms ease;
  }

  .home-banner__github span {
    transition: transform 180ms var(--ease-out);
  }

  .home-banner__github:hover {
    color: var(--text-main);
    text-decoration-color: var(--primary-strong);
  }

  .home-banner__github:hover span {
    transform: translate(2px, -2px);
  }

  .character-stage {
    position: relative;
    width: min(100%, 540px);
    margin: 0;
    justify-self: end;
  }

  .character-stage__halo {
    position: absolute;
    z-index: -1;
    inset: 6% -7% -5% 8%;
    border-radius: 48% 52% 46% 54%;
    background: radial-gradient(
      circle at 52% 45%,
      color-mix(in srgb, var(--surface-solid) 86%, transparent),
      color-mix(in srgb, var(--violet) 20%, transparent) 48%,
      transparent 72%
    );
    filter: blur(14px);
    opacity: 0.9;
  }

  .character-stage__frame {
    position: relative;
    overflow: hidden;
    border-radius: clamp(20px, 3vw, var(--radius-lg));
    background: var(--surface-solid);
    box-shadow: 0 8px 20px color-mix(in srgb, var(--text-main) 13%, transparent);
  }

  .character-stage__frame img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center;
  }

  .character-stage__star {
    position: absolute;
    z-index: 2;
    width: 1px;
    height: 28px;
    background: color-mix(in srgb, var(--text-main) 52%, transparent);
    pointer-events: none;
  }

  .character-stage__star::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 28px;
    height: 1px;
    background: inherit;
    content: '';
    transform: translate(-50%, -50%);
  }

  .character-stage__star--one {
    top: 10%;
    right: -2%;
  }

  .character-stage__star--two {
    bottom: 12%;
    left: -3%;
    scale: 0.58;
  }

  :global(:root[data-theme='dark']) .home-banner {
    background:
      radial-gradient(
        ellipse at 79% 34%,
        color-mix(in srgb, var(--violet) 13%, transparent),
        transparent 43%
      ),
      radial-gradient(
        ellipse at 12% 76%,
        color-mix(in srgb, var(--primary) 10%, transparent),
        transparent 42%
      ),
      radial-gradient(
        ellipse at 52% 4%,
        color-mix(in srgb, var(--pink) 7%, transparent),
        transparent 34%
      ),
      var(--page-bg);
  }

  @media (max-width: 1100px) {
    .home-banner__content {
      grid-template-columns: minmax(0, 1.08fr) minmax(300px, 0.76fr);
      gap: clamp(2rem, 4vw, 3.5rem);
      min-height: 580px;
    }

    .character-stage {
      width: min(100%, 450px);
    }
  }

  @media (max-width: 900px) {
    .home-banner__content {
      grid-template-columns: 1fr;
      gap: 2rem;
      min-height: auto;
      padding-top: 7.5rem;
      padding-bottom: 3.5rem;
    }

    .home-banner__copy {
      max-width: 720px;
    }

    .character-stage {
      width: min(100%, 680px);
      justify-self: center;
    }

    .character-stage__frame img {
      aspect-ratio: 16 / 8.6;
      object-position: center 34%;
    }

    .character-stage__star--one {
      right: 2%;
    }

    .character-stage__star--two {
      left: 1%;
    }
  }

  @media (max-width: 520px) {
    .home-banner__content {
      gap: 1.5rem;
      padding-top: 6.75rem;
      padding-bottom: 3.5rem;
    }

    .home-banner__availability {
      margin-bottom: 1rem;
      font-size: 0.8125rem;
    }

    h1 {
      font-size: clamp(3rem, 15vw, 3.65rem);
      line-height: 1;
    }

    h1 span {
      margin-top: 0.55rem;
      font-size: 0.9375rem;
    }

    .home-banner__role {
      margin-top: 1.25rem;
      font-size: 1.125rem;
    }

    .home-banner__description {
      margin-top: 0.75rem;
      font-size: 0.9375rem;
      line-height: 1.72;
    }

    .home-banner__actions {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.65rem;
      margin-top: 1.4rem;
    }

    .banner-button {
      min-width: 0;
      padding-inline: 0.7rem;
      font-size: 0.875rem;
      text-align: center;
    }

    .home-banner__github {
      grid-column: 1 / -1;
      width: fit-content;
      min-height: 44px;
    }

    .character-stage__frame {
      border-radius: 20px;
    }

    .character-stage__frame img {
      aspect-ratio: 16 / 9;
      object-position: center 32%;
    }

    .home-banner__atmosphere span:nth-child(2) {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .banner-button,
    .home-banner__github,
    .home-banner__github span {
      transition: none;
    }
  }
</style>
