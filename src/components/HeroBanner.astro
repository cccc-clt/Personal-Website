---
import { siteConfig } from '../config/site';
import { heroAssetConfig } from '../config/visualAssets';
---

<section class="home-hero" aria-labelledby="home-title">
  <div class="page-shell home-hero__grid">
    <div class="home-hero__copy" data-reveal>
      <p class="home-hero__status">
        <span aria-hidden="true"></span>
        {siteConfig.availability}
      </p>
      <p class="home-hero__name">{siteConfig.name} · {siteConfig.englishName}</p>
      <h1 id="home-title">我在做能被验证的<br />游戏 AI 产品。</h1>
      <p class="home-hero__role">游戏 AI 产品经理 / AI 应用产品经理方向</p>
      <p class="home-hero__description">
        从真实用户任务出发，把需求判断、Agent
        工作流、人工节点与产品评测推进为可运行、可回看、可迭代的原型。
      </p>
      <div class="home-hero__actions" aria-label="主要行动">
        <a class="button button--primary" href="#featured-projects">查看精选项目</a>
        <a class="text-link" href="/resume/">阅读在线简历</a>
      </div>
    </div>

    <figure class="home-hero__visual" data-reveal="2">
      <div>
        <img
          src={heroAssetConfig.backgroundImage}
          width="1672"
          height="941"
          alt="蓝色深海中的原创幻想角色品牌插图"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <figcaption>
        <span>品牌插图</span>
        深海角色图仅用于个人品牌表达，不是项目运行界面或结果证据。
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .home-hero {
    padding: clamp(8.5rem, 15vw, 12rem) 0 clamp(4rem, 8vw, 7rem);
    border-bottom: 1px solid var(--border);
  }

  .home-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(360px, 0.75fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: center;
  }

  .home-hero__copy {
    max-width: 780px;
  }

  .home-hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0 0 2.2rem;
    color: var(--text-secondary);
    font-size: 0.82rem;
    font-weight: 560;
  }

  .home-hero__status span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--mint);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--mint) 14%, transparent);
  }

  .home-hero__name {
    margin: 0 0 0.8rem;
    color: var(--primary-strong);
    font-size: 1rem;
    font-weight: 620;
  }

  h1 {
    margin: 0;
    font-size: clamp(3.25rem, 6.8vw, 6rem);
    font-weight: 690;
    letter-spacing: -0.04em;
    line-height: 1.03;
  }

  .home-hero__role {
    margin: 1.6rem 0 0;
    color: var(--text-main);
    font-size: clamp(1.08rem, 1.8vw, 1.45rem);
    font-weight: 620;
  }

  .home-hero__description {
    max-width: 62ch;
    margin: 0.9rem 0 0;
    color: var(--text-secondary);
    font-size: 1.02rem;
    line-height: 1.85;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.4rem;
    align-items: center;
    margin-top: 2rem;
  }

  .home-hero__visual {
    width: min(100%, 540px);
    margin: 0;
    justify-self: end;
  }

  .home-hero__visual > div {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 16px 16px 5rem 16px;
    background: var(--surface-tint);
  }

  .home-hero__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 38% center;
    transition: transform 600ms var(--ease-out);
  }

  .home-hero__visual:hover img {
    transform: scale(1.018) translateY(-3px);
  }

  figcaption {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.8rem;
    margin-top: 0.9rem;
    color: var(--text-muted);
    font-size: 0.72rem;
    line-height: 1.6;
  }

  figcaption span {
    color: var(--text-main);
    font-weight: 620;
  }

  @media (max-height: 780px) and (min-width: 901px) {
    .home-hero {
      padding: 7.5rem 0 3.5rem;
    }

    .home-hero__grid {
      gap: clamp(3rem, 6vw, 6rem);
    }

    .home-hero__status {
      margin-bottom: 1.25rem;
    }

    h1 {
      font-size: clamp(3.2rem, 5.5vw, 4.8rem);
    }

    .home-hero__role {
      margin-top: 1rem;
    }

    .home-hero__description {
      line-height: 1.7;
    }

    .home-hero__actions {
      margin-top: 1.25rem;
    }

    .home-hero__visual {
      width: min(100%, 440px);
    }
  }

  @media (max-width: 900px) {
    .home-hero__grid {
      grid-template-columns: 1fr;
    }

    .home-hero__visual {
      width: min(100%, 680px);
      justify-self: start;
    }

    .home-hero__visual > div {
      aspect-ratio: 16 / 9;
      border-radius: 16px;
    }

    .home-hero__visual img {
      object-position: center 44%;
    }
  }

  @media (max-width: 520px) {
    .home-hero {
      padding-top: 7.3rem;
    }

    h1 br {
      display: none;
    }

    .home-hero__status {
      margin-bottom: 1.5rem;
    }

    .home-hero__actions {
      align-items: stretch;
      flex-direction: column;
    }

    .home-hero__actions .button,
    .home-hero__actions .text-link {
      width: 100%;
      justify-content: center;
    }

    figcaption {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__visual img,
    .home-hero__visual:hover img {
      transform: none;
      transition: none;
    }
  }
</style>
