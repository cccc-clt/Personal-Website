---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { siteConfig } from '../config/site';

const publicRoot = join(process.cwd(), 'public');
const desktopBanners = [
  { path: siteConfig.banner.desktop960, width: 960 },
  { path: siteConfig.banner.desktop1440, width: 1440 },
  { path: siteConfig.banner.desktop, width: 1920 },
].filter((asset) => existsSync(join(publicRoot, asset.path.replace(/^\//, ''))));
const hasBanner = desktopBanners.length > 0;
const bannerFallback = desktopBanners.at(-1)?.path;
const desktopSrcset = desktopBanners.map((asset) => `${asset.path} ${asset.width}w`).join(', ');
const hasMobile = existsSync(join(publicRoot, siteConfig.banner.mobile.replace(/^\//, '')));
const resume = siteConfig.resumes[0];
const hasResume = existsSync(join(publicRoot, resume.path.replace(/^\//, '')));
---

<section class:list={['home-banner', { 'home-banner--fallback': !hasBanner }]} aria-labelledby="home-title">
  <div class="home-banner__media" aria-hidden="true">
    {
      hasBanner && bannerFallback && (
        <picture>
          {hasMobile && <source media="(max-width: 640px)" srcset={siteConfig.banner.mobile} />}
          {desktopSrcset && <source srcset={desktopSrcset} sizes="100vw" />}
          <img src={bannerFallback} width="1920" height="900" alt="" fetchpriority="high" decoding="async" />
        </picture>
      )
    }
  </div>
  <div class="home-banner__veil"></div>
  <div class="home-banner__ornaments" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="page-shell home-banner__content">
    <p class="home-banner__eyebrow">TIANQI.Z · GAME AI PRODUCT PRACTICE</p>
    <h1 id="home-title">在现实与幻想之间，<br />寻找 AI 产品的下一种可能。</h1>
    <p class="home-banner__role">赵天琦｜游戏 AI 产品实践者</p>
    <p class="home-banner__description">从需求、原型、Prompt 到测试评估，<br />持续把想法转化为可以运行和验证的 AI 产品。</p>
    <div class="home-banner__actions">
      <a class="banner-button banner-button--primary" href="/projects/">查看作品集 <small>ENTER</small></a>
      {
        hasResume ? (
          <a class="banner-button" href={resume.path} download>下载简历 <small>LOAD PDF</small></a>
        ) : (
          <a class="banner-button" href="/resume/">在线简历 <small>PDF 待补充</small></a>
        )
      }
    </div>
  </div>
  <svg class="home-banner__waves" viewBox="0 0 1440 92" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 38c154 31 278-25 446-8 182 19 244 57 453 30 185-24 337-14 541 8v24H0Z" fill="var(--page-bg)" opacity=".82" />
    <path d="M0 60c175-22 323 12 476 11 179-1 329-46 519-29 152 14 275 43 445 28v22H0Z" fill="var(--page-bg)" />
  </svg>
</section>

<style>
  .home-banner {
    position: relative;
    min-height: 440px;
    overflow: hidden;
    background:
      radial-gradient(circle at 78% 32%, rgba(255, 242, 224, 0.75), transparent 20rem),
      linear-gradient(125deg, #a7d8ef 0%, #d7d7ef 48%, #f2c7c0 100%);
  }

  .home-banner--fallback {
    background:
      radial-gradient(circle at 78% 28%, rgba(255, 255, 255, 0.92), transparent 20rem),
      radial-gradient(circle at 18% 82%, rgba(255, 231, 239, 0.72), transparent 24rem),
      linear-gradient(125deg, #dff3ff 0%, #ece8fb 52%, #f9e7e5 100%);
  }

  .home-banner__media,
  .home-banner__veil,
  .home-banner__media picture,
  .home-banner__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .home-banner__media img {
    object-fit: cover;
    object-position: center;
  }

  .home-banner__veil {
    background: linear-gradient(90deg, rgba(35, 47, 62, 0.7) 0%, rgba(39, 51, 66, 0.4) 42%, rgba(44, 55, 68, 0.06) 75%);
  }

  .home-banner--fallback .home-banner__veil {
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.68), rgba(255, 255, 255, 0.12));
  }

  .home-banner--fallback .home-banner__content {
    color: var(--text-main);
  }

  .home-banner--fallback .home-banner__eyebrow,
  .home-banner--fallback .home-banner__description {
    color: var(--text-secondary);
  }

  .home-banner--fallback h1 {
    text-shadow: none;
  }

  .home-banner--fallback .banner-button {
    border-color: rgba(75, 103, 133, 0.2);
    background: rgba(255, 255, 255, 0.44);
  }

  .home-banner--fallback .banner-button--primary {
    border-color: var(--primary);
    background: var(--surface-solid);
    color: var(--text-main);
  }

  .home-banner__content {
    position: relative;
    z-index: 2;
    padding-top: 112px;
    color: white;
  }

  .home-banner__eyebrow {
    margin: 0 0 1rem;
    color: rgba(255, 255, 255, 0.7);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.11em;
  }

  h1 {
    max-width: 820px;
    margin: 0;
    font-size: clamp(2.35rem, 4.7vw, 4.9rem);
    font-weight: 720;
    letter-spacing: -0.055em;
    line-height: 1.08;
    text-wrap: balance;
    text-shadow: 0 3px 25px rgba(33, 43, 55, 0.2);
  }

  .home-banner__role {
    margin: 1.05rem 0 0;
    font-weight: 700;
  }

  .home-banner__description {
    margin: 0.55rem 0 0;
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.88rem;
    line-height: 1.75;
  }

  .home-banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.35rem;
  }

  .banner-button {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.72rem 0.95rem;
    border: 1px solid rgba(255, 255, 255, 0.48);
    border-radius: 13px;
    background: rgba(255, 255, 255, 0.14);
    font-size: 0.82rem;
    font-weight: 700;
    backdrop-filter: blur(8px);
  }

  .banner-button--primary {
    border-color: white;
    background: white;
    color: #25303e;
  }

  .banner-button small {
    opacity: 0.62;
    font-family: var(--font-mono);
    font-size: 0.52rem;
  }

  .banner-button:hover {
    transform: translateY(-2px);
  }

  .home-banner__ornaments i {
    position: absolute;
    z-index: 2;
    width: 9px;
    height: 9px;
    border: 1px solid rgba(255, 255, 255, 0.55);
    rotate: 45deg;
  }

  .home-banner__ornaments i:nth-child(1) { top: 31%; left: 63%; }
  .home-banner__ornaments i:nth-child(2) { top: 19%; left: 73%; scale: 0.65; }
  .home-banner__ornaments i:nth-child(3) { top: 58%; left: 68%; scale: 0.45; }

  .home-banner__waves {
    position: absolute;
    z-index: 3;
    right: 0;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 70px;
  }

  @media (max-width: 900px) {
    .home-banner { min-height: 360px; }
    .home-banner__content { padding-top: 95px; }
  }

  @media (max-width: 640px) {
    .home-banner { min-height: 290px; }
    .home-banner__content { padding-top: 82px; }
    .home-banner__eyebrow { margin-bottom: 0.65rem; }
    h1 { max-width: 92%; font-size: clamp(1.75rem, 8.6vw, 2.7rem); }
    .home-banner__role { margin-top: 0.75rem; font-size: 0.8rem; }
    .home-banner__description { display: none; }
    .home-banner__actions { margin-top: 0.9rem; }
    .banner-button { padding: 0.58rem 0.72rem; }
    .home-banner:not(.home-banner--fallback) .home-banner__veil { background: linear-gradient(90deg, rgba(35, 47, 62, 0.68), rgba(39, 51, 66, 0.18)); }
  }
</style>
