---
import { siteConfig } from '../config/site';
import { heroAssetConfig } from '../config/visualAssets';
---

<section class="home-hero" aria-labelledby="home-title">
  <div class="page-shell home-hero__grid">
    <div class="home-hero__copy reveal">
      <p class="home-hero__status">
        <span aria-hidden="true"></span>
        {siteConfig.availability}
      </p>
      <p class="home-hero__name">{siteConfig.name}</p>
      <h1 id="home-title">游戏 AI 产品经理</h1>
      <p class="home-hero__description">
        从真实用户任务出发，把需求判断、Agent 工作流、人工节点与产品评测，
        推进为可运行、可回看、可迭代的原型。
      </p>
      <div class="home-hero__actions" aria-label="主要行动">
        <a class="button button--primary" href="#featured-projects">查看项目</a>
        <a class="button" href="/resume/">在线简历</a>
        <a class="home-hero__github" href={siteConfig.github} target="_blank" rel="noreferrer">
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <figure class="home-hero__visual reveal">
      <div>
        <img
          src={heroAssetConfig.backgroundImage}
          width="1672"
          height="941"
          alt="蓝色深海中的原创幻想角色品牌插图"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <figcaption>
        <span>个人视觉</span>
        深海角色图仅用于个人品牌表达，不是项目运行界面或结果证据。
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .home-hero {
    padding: clamp(9rem, 13vw, 11rem) 0 clamp(6rem, 9vw, 8rem);
  }

  .home-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(390px, 0.78fr);
    gap: clamp(4rem, 8vw, 8rem);
    align-items: center;
  }

  .home-hero__copy {
    max-width: 690px;
  }

  .home-hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0 0 2.2rem;
    color: var(--accent-hover);
    font-size: 0.84rem;
    font-weight: 600;
  }

  .home-hero__status span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  .home-hero__name {
    margin: 0 0 0.8rem;
    color: var(--text-secondary);
    font-size: 1rem;
    font-weight: 600;
  }

  h1 {
    max-width: 11ch;
    margin: 0;
    font-size: clamp(3.5rem, 5.8vw, 4.25rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .home-hero__description {
    max-width: 34rem;
    margin: 1.6rem 0 0;
    color: var(--text-secondary);
    font-size: clamp(1.03rem, 1.45vw, 1.15rem);
    line-height: 1.82;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1.1rem;
    align-items: center;
    margin-top: 2rem;
  }

  .home-hero__github {
    position: relative;
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    gap: 0.35rem;
    padding-inline: 0.35rem;
    color: var(--text-secondary);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .home-hero__github::after {
    position: absolute;
    right: 0.35rem;
    bottom: 0.6rem;
    left: 0.35rem;
    height: 1px;
    background: var(--accent);
    content: '';
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 280ms var(--ease-out);
  }

  .home-hero__github:hover {
    color: var(--accent-hover);
  }

  .home-hero__github:hover::after {
    transform: scaleX(1);
  }

  .home-hero__visual {
    width: min(100%, 520px);
    margin: 0;
    justify-self: end;
  }

  .home-hero__visual > div {
    aspect-ratio: 4 / 3;
    padding: 0.75rem;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--surface-solid);
    box-shadow: var(--shadow-sm);
  }

  .home-hero__visual img {
    width: 100%;
    height: 100%;
    border-radius: 9px;
    object-fit: cover;
    object-position: 44% center;
    filter: saturate(0.66) contrast(0.94) brightness(1.08);
    transition:
      transform 300ms var(--ease-out),
      filter 300ms ease;
  }

  .home-hero__visual:hover img {
    filter: saturate(0.74) contrast(0.96) brightness(1.05);
    transform: scale(1.025);
  }

  figcaption {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.8rem;
    margin-top: 0.85rem;
    color: var(--text-muted);
    font-size: 0.72rem;
    line-height: 1.6;
  }

  figcaption span {
    color: var(--text-secondary);
    font-weight: 600;
  }

  @media (max-height: 780px) and (min-width: 901px) {
    .home-hero {
      padding: 6.6rem 0 3.4rem;
    }

    .home-hero__status {
      margin-bottom: 1.25rem;
    }

    h1 {
      font-size: clamp(3rem, 5vw, 3.75rem);
    }

    .home-hero__description {
      margin-top: 1.1rem;
      line-height: 1.7;
    }

    .home-hero__actions {
      margin-top: 1.3rem;
    }

    .home-hero__visual {
      width: min(100%, 460px);
    }
  }

  @media (max-width: 900px) {
    .home-hero {
      padding-top: 8.5rem;
    }

    .home-hero__grid {
      grid-template-columns: 1fr;
      gap: 4rem;
    }

    .home-hero__visual {
      width: min(100%, 720px);
      justify-self: start;
    }

    .home-hero__visual > div {
      aspect-ratio: 16 / 9;
    }
  }

  @media (max-width: 520px) {
    .home-hero {
      padding: 7.5rem 0 4.5rem;
    }

    .home-hero__status {
      margin-bottom: 1.5rem;
    }

    .home-hero__actions {
      align-items: stretch;
      flex-direction: column;
    }

    .home-hero__actions .button,
    .home-hero__github {
      width: 100%;
      justify-content: center;
    }

    .home-hero__github::after {
      right: 35%;
      left: 35%;
    }

    figcaption {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__visual img,
    .home-hero__visual:hover img,
    .home-hero__github::after {
      transition: none;
      transform: none;
    }
  }
</style>
