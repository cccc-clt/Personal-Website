---
import SectionHeading from './SectionHeading.astro';

const steps = [
  {
    code: 'DISCOVER',
    title: '理解场景',
    text: '从目标用户、任务链路和现有方案出发，先确认问题是否值得用 AI 解决。',
  },
  {
    code: 'DESIGN',
    title: '设计系统',
    text: '定义输入输出、模型角色、人工节点、异常处理和产品能力边界。',
  },
  {
    code: 'BUILD',
    title: '快速验证',
    text: '用原型或 Demo 验证关键假设，让讨论围绕真实交互和结果展开。',
  },
  {
    code: 'EVALUATE',
    title: '评测迭代',
    text: '建立覆盖质量、稳定性、延迟、成本与体验的评测闭环。',
  },
];
---

<section class="section method-section">
  <div class="shell">
    <SectionHeading
      eyebrow="PRODUCT METHOD"
      title="不止做出 Demo，更关注 AI 产品如何稳定工作。"
      description="一套贯穿需求、方案、原型与评测的工作方式。"
    />
    <div class="method-flow">
      {
        steps.map((step, index) => (
          <article data-reveal>
            <div class="method-index">
              <>
                <span>0{index + 1}</span>
                <i />
              </>
            </div>
            <small>{step.code}</small>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
