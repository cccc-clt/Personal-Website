---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { heroAssetConfig } from '../config/visualAssets';
import { researchCategoryLabels } from '../config/site';
import {
  formatPublicationDate,
  getInsightPath,
  getInsightPdfPath,
  getInsightReadingTime,
} from '../utils/content';

interface Props {
  article: CollectionEntry<'research'>;
  headingLevel?: 'h2' | 'h3';
}

const { article, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const articleUrl = getInsightPath(article);
const cover = article.data.cover;
const readingTime = getInsightReadingTime(article);
---

<article class="article-card reveal">
  <a
    class="article-card__cover-link"
    href={articleUrl}
    aria-label={`阅读全文：${article.data.title}`}
  >
    <figure>
      {
        cover ? (
          <Image
            src={cover}
            alt={article.data.coverAlt ?? `${article.data.title}封面`}
            width={cover.width}
            height={cover.height}
            loading="lazy"
            decoding="async"
          />
        ) : (
          <img
            src={heroAssetConfig.backgroundImage}
            width="1672"
            height="941"
            alt="蓝色深海幻想角色品牌插图"
            loading="lazy"
            decoding="async"
          />
        )
      }
      {!cover && <figcaption>品牌插图 · 非研究证据</figcaption>}
    </figure>
  </a>

  <div class="article-card__body">
    <div class="article-card__eyeline">
      <span>{article.data.type}</span>
      <time datetime={article.data.publishDate}>
        {formatPublicationDate(article.data.publishDate)}
      </time>
    </div>

    <Heading><a href={articleUrl}>{article.data.title}</a></Heading>
    <p>{article.data.description}</p>

    <div class="article-card__tags" aria-label="内容标签">
      {article.data.tags.slice(0, 4).map((tag) => <span>{tag}</span>)}
    </div>

    <div class="article-card__footer">
      <div class="article-card__meta">
        <span>{researchCategoryLabels[article.data.category]}</span>
        {article.data.pageCount && <span>{article.data.pageCount} 页</span>}
        <span>{readingTime}</span>
      </div>
      <div class="article-card__actions">
        <a class="button button--small" href={articleUrl}>网页阅读</a>
        {
          article.data.pdfUrl && (
            <a
              class="button button--small button--quiet"
              href={getInsightPdfPath(article)}
              aria-label={`阅读${article.data.title}的 PDF 版本`}
            >
              PDF 阅读
            </a>
          )
        }
      </div>
    </div>
  </div>
</article>

<style>
  .article-card {
    display: grid;
    min-width: 0;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--surface-solid);
    box-shadow: var(--shadow-sm);
    transition:
      translate 300ms var(--ease-out),
      box-shadow 300ms ease;
  }

  .article-card:hover {
    box-shadow: var(--shadow-md);
    translate: 0 -4px;
  }

  .article-card__cover-link {
    display: block;
    background: var(--page-bg-soft);
  }

  figure {
    position: relative;
    display: grid;
    aspect-ratio: 16 / 9.5;
    margin: 0;
    place-items: center;
    overflow: hidden;
    background: var(--page-bg-soft);
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 300ms var(--ease-out);
  }

  .article-card__cover-link:hover img {
    transform: scale(1.018);
  }

  figcaption {
    position: absolute;
    right: 0.9rem;
    bottom: 0.8rem;
    padding: 0.28rem 0.5rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--surface-warm) 90%, transparent);
    color: var(--text-secondary);
    font-size: 0.68rem;
  }

  .article-card__body {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: clamp(1.35rem, 3vw, 1.85rem);
  }

  .article-card__eyeline,
  .article-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1rem;
    color: var(--text-muted);
    font-size: 0.72rem;
  }

  .article-card__eyeline {
    justify-content: space-between;
  }

  .article-card__eyeline span,
  .article-card__meta span:first-child {
    color: var(--accent-hover);
    font-weight: 600;
  }

  h2,
  h3 {
    display: -webkit-box;
    margin: 0.9rem 0 0;
    overflow: hidden;
    font-size: clamp(1.45rem, 2.4vw, 1.95rem);
    letter-spacing: -0.015em;
    line-height: 1.3;
    text-wrap: balance;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  h2 a,
  h3 a {
    color: inherit;
  }

  h2 a:hover,
  h3 a:hover {
    color: var(--accent-hover);
  }

  .article-card__body > p {
    display: -webkit-box;
    margin: 0.75rem 0 0;
    overflow: hidden;
    color: var(--text-secondary);
    line-height: 1.72;
    text-wrap: pretty;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .article-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1.15rem;
  }

  .article-card__tags span {
    max-width: 100%;
    padding: 0.3rem 0.56rem;
    border-radius: var(--radius-pill);
    background: var(--accent-soft);
    color: var(--accent-hover);
    font-size: 0.7rem;
    overflow-wrap: anywhere;
  }

  .article-card__footer {
    display: grid;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1.4rem;
  }

  .article-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .button--small {
    min-height: 40px;
    padding: 0.58rem 0.82rem;
    font-size: 0.74rem;
  }

  .button--quiet {
    background: transparent;
  }

  @media (max-width: 420px) {
    .article-card__eyeline {
      display: grid;
      justify-content: start;
    }

    .article-card__actions .button {
      flex: 1 1 9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .article-card,
    .article-card:hover,
    img,
    .article-card__cover-link:hover img {
      transition: none;
      transform: none;
      translate: none;
    }
  }
</style>
