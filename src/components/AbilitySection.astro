---
import { abilities } from '../config/site';
import SectionIntro from './SectionIntro.astro';
---

<section class="abilities section">
  <div class="container">
    <SectionIntro
      eyebrow="03 / CAPABILITIES"
      title="在创意和工程之间，建立一条能被验证的产品路径。"
      description="不是把所有问题都交给模型，而是明确产品目标、工作流、证据和边界。"
    />
    <ol class="abilities__list">
      {
        abilities.map((ability, index) => (
          <li class:list={[`abilities__item`, `abilities__item--${index + 1}`]}>
            <span class="abilities__number mono">{ability.index}</span>
            <div>
              <span class="abilities__english mono">{ability.english}</span>
              <h3>{ability.title}</h3>
              <p>{ability.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .abilities {
    position: relative;
    background: linear-gradient(180deg, #f0f5ff, #f8faff);
  }

  .abilities__list {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .abilities__item {
    position: relative;
    display: grid;
    min-height: 290px;
    grid-template-columns: 48px 1fr;
    gap: 1rem;
    padding: 2rem;
    border-top: 1px solid var(--line-strong);
    background: rgba(255, 255, 255, 0.34);
  }

  .abilities__item--1 {
    grid-column: 1 / span 7;
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
  }

  .abilities__item--2 {
    grid-column: 8 / span 5;
    min-height: 390px;
    border-radius: var(--radius-lg) 0 0 var(--radius-lg);
    background: rgba(218, 229, 255, 0.5);
  }

  .abilities__item--3 {
    grid-column: 2 / span 4;
    min-height: 360px;
    border-radius: var(--radius-lg);
    background: rgba(247, 225, 230, 0.42);
  }

  .abilities__item--4 {
    grid-column: 6 / span 7;
    border-radius: var(--radius-lg);
  }

  .abilities__number,
  .abilities__english {
    color: var(--ink-500);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
  }

  h3 {
    margin: 1.2rem 0 0.9rem;
    font-size: clamp(1.8rem, 3vw, 3.2rem);
    letter-spacing: -0.05em;
  }

  p {
    max-width: 470px;
    margin: 0;
    color: var(--ink-650);
    line-height: 1.8;
  }

  @media (max-width: 800px) {
    .abilities__list {
      grid-template-columns: 1fr;
    }

    .abilities__item,
    .abilities__item--1,
    .abilities__item--2,
    .abilities__item--3,
    .abilities__item--4 {
      grid-column: 1;
      min-height: 260px;
      border-radius: var(--radius-md);
    }
  }
</style>
