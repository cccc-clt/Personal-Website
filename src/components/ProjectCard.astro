---
import type { ProjectEntry } from '../types/project';
import ProjectCover from './ProjectCover.astro';
import StatusBadge from './StatusBadge.astro';

interface Props {
  project: ProjectEntry;
  mode?: 'featured' | 'index';
}

const { project, mode = 'index' } = Astro.props;
const slug = project.id.replace(/\.mdx?$/, '');
const projectUrl = `/projects/${slug}/`;
---

<article class:list={['project-card', `project-card--${mode}`]}>
  <a class="project-card__link" href={projectUrl} aria-label={`查看项目：${project.data.title}`}>
    <figure class="project-card__visual">
      <ProjectCover
        slug={slug}
        title={project.data.title}
        index={project.data.index}
        cover={project.data.cover}
        compact
      />
      <figcaption>概念图 · 非运行截图</figcaption>
    </figure>
    <div class="project-card__body">
      <div class="project-card__meta">
        <span>{project.data.period}</span>
        <StatusBadge status={project.data.status} />
      </div>
      <h3>{project.data.title}</h3>
      <p class="project-card__summary">{project.data.summary}</p>
      <dl class="project-card__facts">
        <div><dt>用户问题</dt><dd>{project.data.problem}</dd></div>
        <div><dt>我的职责</dt><dd>{project.data.role}</dd></div>
        <div><dt>真实产出</dt><dd>{project.data.outcome}</dd></div>
      </dl>
      <div class="project-card__footer">
        <div class="chip-row">
          {
            project.data.categories
              .slice(0, 3)
              .map((category) => <span class="chip">{category}</span>)
          }
        </div>
        <span class="project-card__action">阅读案例 <span aria-hidden="true">→</span></span>
      </div>
    </div>
  </a>
</article>

<style>
  .project-card {
    min-width: 0;
  }

  .project-card__link {
    display: grid;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--surface-solid);
    transition:
      translate 260ms var(--ease-out),
      box-shadow 260ms ease;
  }

  .project-card__link:hover {
    box-shadow: var(--shadow-soft);
    translate: 0 -4px;
  }

  .project-card__visual {
    margin: 0;
  }

  .project-card__visual :global(.project-cover) {
    border-radius: 0;
  }

  .project-card__visual figcaption {
    padding: 0.45rem 1rem 0;
    color: var(--text-muted);
    font-size: 0.68rem;
  }

  .project-card__body {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: 1.25rem clamp(1rem, 3vw, 1.55rem) 1.45rem;
  }

  .project-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--text-muted);
    font-size: 0.72rem;
  }

  h3 {
    margin: 1rem 0 0;
    font-size: clamp(1.35rem, 2.4vw, 2rem);
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .project-card__summary {
    margin: 0.65rem 0 0;
    color: var(--text-secondary);
    line-height: 1.75;
  }

  .project-card__facts {
    display: grid;
    gap: 0.75rem;
    margin: 1.3rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .project-card__facts div {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 0.75rem;
  }

  dt {
    color: var(--text-muted);
    font-size: 0.72rem;
  }

  dd {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.78rem;
    line-height: 1.65;
  }

  .project-card__footer {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1.4rem;
  }

  .project-card__action {
    flex: 0 0 auto;
    color: var(--primary-strong);
    font-size: 0.78rem;
    font-weight: 620;
  }

  .project-card__action span {
    display: inline-block;
    transition: translate 220ms var(--ease-out);
  }

  .project-card__link:hover .project-card__action span {
    translate: 4px 0;
  }

  .project-card--featured .project-card__facts div:first-child {
    display: none;
  }

  .project-card--featured .project-card__facts {
    grid-template-columns: 1fr;
  }

  @media (max-width: 520px) {
    .project-card__facts div {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }

    .project-card__footer {
      align-items: start;
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card__link,
    .project-card__link:hover,
    .project-card__action span,
    .project-card__link:hover .project-card__action span {
      transition: none;
      translate: none;
    }
  }
</style>
