---
import { projectFilterLabels } from '../config/site';
import type { ProjectEntry } from '../types/project';
import ProjectCover from './ProjectCover.astro';

interface Props {
  project: ProjectEntry;
  mode?: 'featured' | 'index';
}

const { project, mode = 'index' } = Astro.props;
const slug = project.id.replace(/\.mdx?$/, '');
const projectUrl = `/projects/${slug}/`;
const primaryType = projectFilterLabels[project.data.filters[0]];
---

<article class:list={['project-card', `project-card--${mode}`, 'reveal']}>
  <a class="project-card__link" href={projectUrl} aria-label={`查看项目：${project.data.title}`}>
    <figure class="project-card__visual">
      <ProjectCover
        slug={slug}
        title={project.data.title}
        index={project.data.index}
        cover={project.data.cover}
        compact
      />
      <figcaption>概念图</figcaption>
    </figure>
    <div class="project-card__body">
      <span class="project-card__type">{primaryType}</span>
      <h3>{project.data.title}</h3>
      <p>{project.data.summary}</p>
      <div class="project-card__footer">
        <div class="chip-row" aria-label="项目标签">
          {
            project.data.categories
              .slice(0, 3)
              .map((category) => <span class="chip">{category}</span>)
          }
        </div>
        <span class="project-card__action">查看案例 <span aria-hidden="true">→</span></span>
      </div>
    </div>
  </a>
</article>

<style>
  .project-card {
    min-width: 0;
  }

  .project-card__link {
    display: grid;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--surface-solid);
    transition:
      translate 300ms var(--ease-out),
      border-color 300ms ease,
      box-shadow 300ms ease;
  }

  .project-card__link:hover {
    border-color: transparent;
    box-shadow: var(--shadow-md);
    translate: 0 -4px;
  }

  .project-card__visual {
    position: relative;
    margin: 0;
    border-radius: var(--radius-card) var(--radius-card) 0 0;
  }

  .project-card__visual figcaption {
    position: absolute;
    right: 0.9rem;
    bottom: 0.8rem;
    padding: 0.28rem 0.5rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--surface-warm) 88%, transparent);
    color: var(--text-secondary);
    font-size: 0.68rem;
    backdrop-filter: blur(8px);
  }

  .project-card__body {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: clamp(1.35rem, 3vw, 1.85rem);
  }

  .project-card__type {
    color: var(--accent-hover);
    font-size: 0.78rem;
    font-weight: 600;
  }

  h3 {
    margin: 0.6rem 0 0;
    font-size: clamp(1.45rem, 2.3vw, 1.8rem);
    letter-spacing: -0.015em;
    line-height: 1.28;
  }

  .project-card__body > p {
    margin: 0.75rem 0 0;
    color: var(--text-secondary);
    line-height: 1.72;
  }

  .project-card__footer {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1.5rem;
  }

  .project-card__action {
    flex: 0 0 auto;
    color: var(--accent-hover);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .project-card__action span {
    display: inline-block;
    transition: translate 280ms var(--ease-out);
  }

  .project-card__link:hover .project-card__action span {
    translate: 4px 0;
  }

  @media (max-width: 520px) {
    .project-card__footer {
      align-items: start;
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card__link,
    .project-card__link:hover,
    .project-card__action span,
    .project-card__link:hover .project-card__action span {
      transition: none;
      translate: none;
    }
  }
</style>
