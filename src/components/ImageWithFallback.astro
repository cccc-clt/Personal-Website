---
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  avif?: string;
  webp?: string;
  mobileAvif?: string;
  mobileWebp?: string;
  alt: string;
  width: number;
  height: number;
  sizes?: string;
  priority?: boolean;
  fallbackLabel?: string;
  class?: string;
}

const {
  avif,
  webp,
  mobileAvif,
  mobileWebp,
  alt,
  width,
  height,
  sizes = '100vw',
  priority = false,
  fallbackLabel = '本地视觉资产待补充',
  class: className,
} = Astro.props;
const publicExists = (path?: string) =>
  Boolean(path && existsSync(join(process.cwd(), 'public', path.replace(/^\//, ''))));
const hasAvif = publicExists(avif);
const hasWebp = publicExists(webp);
const hasMobileAvif = publicExists(mobileAvif);
const hasMobileWebp = publicExists(mobileWebp);
const fallbackSource = hasWebp ? webp : hasAvif ? avif : undefined;
const hasImage = Boolean(fallbackSource);
---

{
  hasImage ? (
    <picture class={className}>
      {hasMobileAvif && <source media="(max-width: 700px)" srcset={mobileAvif} type="image/avif" />}
      {hasMobileWebp && <source media="(max-width: 700px)" srcset={mobileWebp} type="image/webp" />}
      {hasAvif && <source srcset={avif} type="image/avif" />}
      <img
        src={fallbackSource}
        alt={alt}
        width={width}
        height={height}
        sizes={sizes}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
      />
    </picture>
  ) : (
    <div class:list={['image-fallback', className]} data-fallback-label={fallbackLabel}>
      <slot name="fallback">
        <span>{fallbackLabel}</span>
      </slot>
    </div>
  )
}

<style>
  .image-fallback {
    position: relative;
    display: grid;
    min-height: 260px;
    place-items: center;
    overflow: hidden;
    background:
      radial-gradient(circle at 60% 30%, rgba(255, 255, 255, 0.95), transparent 20%),
      linear-gradient(145deg, #e6f5ff, #e4e2ff 60%, #f5e6eb);
  }

  .image-fallback > span {
    color: var(--ink-500);
    font-size: 0.72rem;
    font-weight: 500;
  }
</style>
